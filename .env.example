# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=shurly

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# API Configuration
API_TITLE=Shurly API
API_VERSION=0.1.0
API_DESCRIPTION=A modern URL shortener API

# CORS Configuration (must be JSON array format for pydantic-settings)
CORS_ORIGINS=["http://localhost:4321","http://localhost:4232","http://localhost:3000"]

# SSRF guard for link previews (OG fetcher). Leave false: previews then refuse hosts
# that resolve to loopback/private/link-local addresses. Set true ONLY for local
# development if you need previews of pages served from localhost. Never in production.
OG_FETCH_ALLOW_PRIVATE=false
