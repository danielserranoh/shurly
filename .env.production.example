# Shurly Production Environment Configuration
#
# The environment scripts/deploy_ecs.sh gives the ECS service when it creates it
# (`aws ecs create-express-gateway-service`). The script stops once the service
# exists: later settings change on the live service (DEPLOYMENT.md § Settings). For
# local Docker testing, copy this file to `.env` and `docker run --env-file .env ...`.
#
# DB_PASSWORD and JWT_SECRET_KEY are plain task env vars today; Secrets Manager is
# the planned move (ROADMAP 6.3). Never commit real values.
#
# IMPORTANT: scripts/deploy_ecs.sh `source`s `.env`, a copy of this file, as a shell script. Any
# value containing whitespace, brackets, quotes, or `$` MUST be wrapped in
# single quotes so bash treats it as a literal. JSON arrays (CORS_ORIGINS,
# TRUSTED_PROXIES) and human-readable strings (API_TITLE, API_DESCRIPTION)
# always need single quotes; bare alphanumeric values do not.

# ─── Database (RDS PostgreSQL) ──────────────────────────────────────────────
DB_HOST=shurly-db.xxxxx.eu-south-2.rds.amazonaws.com
DB_PORT=5432
DB_USER=shurly
DB_PASSWORD=set-from-secrets-manager
DB_NAME=shurly
DB_SSL_MODE=require

# Connection pool sizing. ECS Fargate keeps the process alive across requests
# so a healthy pool is reused; 10/20 mirrors the local dev defaults and works
# fine for one task. Bump if you scale up the task or add concurrency.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=set-from-secrets-manager
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── API metadata ────────────────────────────────────────────────────────────
API_TITLE='Shurly API'
API_VERSION=0.1.0
API_DESCRIPTION='A modern URL shortener API'

# ─── CORS ────────────────────────────────────────────────────────────────────
# JSON array of allowed origins. None: the frontend is served from the API's own host
# (shurly.griddo.io, Phase 4.10), so the browser makes no cross-origin calls
# (DEPLOYMENT.md § CORS). List one only for a frontend served from elsewhere, e.g.
# '["http://localhost:4232"]' to run the dev server against this API.
CORS_ORIGINS='[]'

# ─── Phase 3.9.5 — GDPR ──────────────────────────────────────────────────────
# Truncate visitor IPs at insert time (IPv4 → /24, IPv6 → /64). Keep ON unless
# legal review explicitly approves storing full addresses.
ANONYMIZE_REMOTE_ADDR=true

# ─── Phase 8.4 — Geolocation ─────────────────────────────────────────────────
# MaxMind's GeoLite2 City, else DB-IP's country database: both fetched into the image at build
# time (MaxMind's credentials are the deploy job's GitHub secrets, never the task's). A visit's
# country is looked up from the stored (anonymized) address; only the ISO code is kept. An empty
# GEOIP_DATABASE turns it off.
# GEOIP_DATABASE=data/GeoLite2-City.mmdb
# GEOIP_FALLBACK_DATABASE=data/dbip-country-lite.mmdb

# ─── Phase 3.9.6 — Trust boundaries for X-Forwarded-For ─────────────────────
# JSON array of CIDRs. REQUIRED in production: without this the application
# records the ALB's IP for every visit and the real client IP is lost. The
# default VPC's CIDR for griddo-main is 172.31.0.0/16; the shared ALB lives
# inside that network. Not CloudFront's ranges: see CLOUDFRONT_ORIGIN_SECRETS below.
TRUSTED_PROXIES='["172.31.0.0/16"]'

# ─── Phase 6.3 — Client IPs through CloudFront (shurly.griddo.io, 4.10) ─────
# The value(s) the distribution sends in its custom origin header: only a request
# carrying one is believed about CloudFront-Viewer-Address. Two while rotating, each
# at least 32 characters (`openssl rand -hex 32`). Unset: X-Forwarded-For, as before.
# DEPLOYMENT.md § Frontend hosting, "Client IPs behind CloudFront".
# CLOUDFRONT_ORIGIN_SECRETS='["<value>"]'
# CLOUDFRONT_ORIGIN_HEADER=X-Origin-Verify

# ─── Phase 3.9.6 — Visit-suppression query param ────────────────────────────
DISABLE_TRACK_PARAM=nostat

# ─── Phase 3.9.6 — Short-code casing ────────────────────────────────────────
# `loose` lowercases generated codes and custom slugs at insert (Shlink default).
# `strict` preserves case. Once you ship URLs in `loose` mode you cannot flip
# back without breaking existing links.
SHORT_URL_MODE=loose

# ─── Phase 3.10.1 — Default short-link host ─────────────────────────────────
# Seeded as the default Domain row on first startup. URLs created without an
# explicit domain_id are bound to this host.
DEFAULT_DOMAIN=go.griddo.io

# ─── Phase 3.14.2 — Organization ─────────────────────────────────────────────
# Every account belongs to one organization, seeded on startup. Defaults:
# ORGANIZATION_NAME=Griddo, ORGANIZATION_DOMAIN=griddo.io.
# The first owner: this account becomes owner when it joins an organization with
# none, and startup restores it as owner if none is left. Without it nobody can
# change roles, so set it before the first sign-up.
BOOTSTRAP_OWNER_EMAIL=

# ─── Phase 3.13 — Sign in with Google ────────────────────────────────────────
# Until all four are set (and ORGANIZATION_DOMAIN isn't empty), sign in with Google
# stays off. The Google Cloud project comes first: DEPLOYMENT.md § Sign in with Google.
# The client secret belongs in Secrets Manager.
GOOGLE_CLIENT_ID=set-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=set-from-secrets-manager
GOOGLE_REDIRECT_URI=https://shurly.griddo.io/api/v1/auth/google/callback
# The frontend's origin (also in CORS_ORIGINS): after Google, the browser goes to
# {FRONTEND_URL}/login/ with a one-time code.
FRONTEND_URL=https://set-the-frontend-origin
# POST /auth/register, for local development and tests. Never true in production.
ALLOW_PASSWORD_SIGNUP=false

# ─── Phase 5.8 — MCP clients sign in with Google ─────────────────────────────
# Off until both are set, together with the Google client above. People connect
# to MCP_PUBLIC_URL with a trailing slash. See DEPLOYMENT.md § The MCP.
# shurly.griddo.io serves the web, the app, the API and the MCP (decided 2026-09-28).
MCP_PUBLIC_URL=https://shurly.griddo.io/mcp
# `openssl rand -hex 32`. The same on every task; changing it signs every MCP client out.
MCP_OAUTH_SIGNING_KEY=set-from-secrets-manager
# Who may register as an MCP client; the default covers claude.ai and Claude Code.
# MCP_OAUTH_ALLOWED_REDIRECT_URIS='["https://claude.ai/api/mcp/auth_callback","https://claude.com/api/mcp/auth_callback","http://localhost:*","http://127.0.0.1:*"]'

# ─── Phase 6.3 — Rate limits (per minute unless said; 0 turns one off) ─────
# They key on the client IP, so TRUSTED_PROXIES above must name the ALB.
# RATE_LIMIT_LOGIN_PER_IP=20
# RATE_LIMIT_LOGIN_FAILURES_PER_ACCOUNT=10   # per 15 minutes
# RATE_LIMIT_SIGN_IN_PER_IP=30
# RATE_LIMIT_MCP_CLIENTS_PER_IP=60

# ─── Phase 3.10.6 — Redirect behavior ────────────────────────────────────────
# 302 keeps every hit reaching the backend (analytics-friendly).
# 301 is SEO-friendly but cached aggressively (analytics fidelity drops).
# 307/308 preserve the request method.
REDIRECT_STATUS_CODE=302

# Edge cache lifetime in seconds. 0 → "Cache-Control: private, max-age=0".
# Positive values trade analytics fidelity for redirect latency.
REDIRECT_CACHE_LIFETIME=0
