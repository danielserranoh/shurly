---
/**
 * Phase 10.1 — Organization → Service accounts (/dashboard/organization/): other systems (Propuestas Griddo) that
 * make links for the organization with their own token (_pm/spec_service_accounts.md).
 *
 * The owner makes, edits and removes them, and creates, renews and revokes their token; the secret
 * shows once, in the token dialog, with Copy. Admins see the list without the buttons; members don't
 * see the section (the API answers them 403 anyway).
 */
import Icon from '@/components/ui/Icon.astro';
import Modal from '@/components/ui/Modal.astro';
import SettingsSection from './SettingsSection.astro';
---

<div data-services-section hidden>
  <SettingsSection
    id="org-services-title"
    title="Service accounts"
    description="Other systems that make links for the organization, each with its own token. A link one makes for someone is theirs, and says which service made it."
  >
    <span slot="title-end" class="font-normal text-ink-500" data-services-count></span>
    <a slot="aside" href="/manual/connect-a-service/" class="link mt-3 inline-flex items-center gap-1 text-sm">
      How to connect one<Icon name="arrow-up-right" class="size-3.5" />
    </a>

    <div class="card overflow-hidden">
      <div class="flex flex-col gap-3 border-b border-line px-4 py-3.5 sm:flex-row sm:items-center sm:px-5">
        <p class="hint min-w-0 flex-1" data-services-hint></p>
        <button type="button" class="btn btn-primary btn-sm self-start sm:self-auto" data-service-new hidden><Icon name="plus" />New service account</button>
      </div>
      <ul class="divide-y divide-ink-100" data-services aria-labelledby="org-services-title"></ul>
      <p class="px-4 py-6 text-center text-sm text-ink-500 sm:px-5" data-services-empty hidden>
        No service accounts yet. Make one for each system that makes links for the organization.
      </p>
      <p class="field-error px-4 py-3 sm:px-5" role="alert" data-services-error hidden></p>
    </div>
  </SettingsSection>
</div>

<Modal id="service-form" title="New service account" description="It never signs in: it uses the token you make next." width="32rem" staticBackdrop>
  <form class="grid gap-5 px-6 py-5" novalidate data-service-form>
    <div data-form-alert hidden></div>
    <div class="grid gap-1.5">
      <label for="service-name" class="label">Name</label>
      <input id="service-name" name="display_name" class="input" maxlength="255" placeholder="e.g. Propuestas Griddo" autocomplete="off" required aria-describedby="service-name-error" data-autofocus />
      <p id="service-name-error" class="field-error" data-error-for="display_name" hidden></p>
    </div>
    <div class="grid gap-1.5">
      <label for="service-description" class="label">What it’s for <span class="font-normal text-ink-500">(optional)</span></label>
      <textarea id="service-description" name="description" class="textarea" rows="2" maxlength="1000" placeholder="Hosts proposals and shortens their links"></textarea>
    </div>
    <div class="grid gap-1.5">
      <label for="service-responsible" class="label">Person responsible</label>
      <select id="service-responsible" name="responsible_user_id" class="select" required aria-describedby="service-responsible-hint service-responsible-error"></select>
      <p id="service-responsible-hint" class="hint">Who to ask about it: someone in the organization.</p>
      <p id="service-responsible-error" class="field-error" data-error-for="responsible_user_id" hidden></p>
    </div>
    <fieldset class="grid gap-1.5">
      <legend class="label mb-1.5">Role</legend>
      <div class="segmented self-start" role="radiogroup" aria-label="Role">
        <label><input type="radio" name="role" value="member" checked /><span>Member</span></label>
        <label><input type="radio" name="role" value="admin" /><span>Admin</span></label>
      </div>
      <p class="hint">A member changes the links it made. An admin changes all the organization’s links.</p>
    </fieldset>
    <div class="-mx-6 -mb-5 flex flex-col-reverse gap-2 border-t border-line px-6 py-4 sm:flex-row sm:justify-end">
      <button type="button" class="btn btn-secondary" data-dialog-close>Cancel</button>
      <button type="submit" class="btn btn-primary" data-service-save>Create service account</button>
    </div>
  </form>
</Modal>

<Modal id="service-token" title="Create the token" width="34rem" staticBackdrop>
  <form class="grid gap-5 px-6 py-5" novalidate data-token-ask>
    <div data-form-alert hidden></div>
    <p class="text-sm leading-6 text-ink-600" data-token-ask-body></p>
    <div class="grid gap-1.5">
      <label for="token-expires" class="label">Expires <span class="font-normal text-ink-500">(optional)</span></label>
      <input id="token-expires" name="expires_at" type="date" class="input w-auto" aria-describedby="token-expires-hint token-expires-error" />
      <p id="token-expires-hint" class="hint">Leave it empty to keep it until you renew or revoke it. Nothing warns before it expires.</p>
      <p id="token-expires-error" class="field-error" data-error-for="expires_at" hidden></p>
    </div>
    <div class="-mx-6 -mb-5 flex flex-col-reverse gap-2 border-t border-line px-6 py-4 sm:flex-row sm:justify-end">
      <button type="button" class="btn btn-secondary" data-dialog-close>Cancel</button>
      <button type="submit" class="btn btn-primary" data-token-make>Create token</button>
    </div>
  </form>

  <div class="grid gap-4 px-6 py-5" data-token-show hidden>
    <div class="flex items-start gap-3 rounded-xl border border-brand-200 bg-brand-50 p-3 text-sm text-brand-900" role="status">
      <span class="grid size-5 shrink-0 place-items-center rounded-full bg-brand-400 text-white"><Icon name="check" class="size-3.5" strokeWidth={3} /></span>
      <p class="min-w-0 flex-1"><b class="font-semibold" data-token-done-title>Here’s the token.</b>{' '}Copy it now and put it in the service’s settings: you won’t see it again.</p>
    </div>
    <p class="label" id="token-value-label">Token</p>
    <div class="flex flex-col gap-2 rounded-xl border border-line bg-ink-50 p-2 sm:flex-row sm:items-center sm:pl-4" role="group" aria-labelledby="token-value-label">
      <code class="min-w-0 flex-1 px-2 py-1 font-mono text-sm break-all text-ink-900 sm:px-0" data-token-value></code>
      <button type="button" class="btn btn-secondary btn-sm shrink-0" data-token-copy>
        <span data-copy-icon><Icon name="copy" /></span><span data-copy-label>Copy</span><span class="sr-only"> token</span>
      </button>
    </div>
    <p class="hint" data-token-show-hint></p>
    <div class="-mx-6 -mb-5 flex justify-end border-t border-line px-6 py-4">
      <button type="button" class="btn btn-primary" data-token-done>Done</button>
    </div>
  </div>
</Modal>

<Modal id="token-links" title="Links made with this token" width="36rem">
  <div class="grid gap-3 px-6 py-5">
    <p class="hint" data-token-links-hint></p>
    <ul class="grid gap-2" data-token-links aria-labelledby="token-links-title"></ul>
    <div class="-mx-6 -mb-5 flex justify-end border-t border-line px-6 py-4">
      <button type="button" class="btn btn-secondary" data-dialog-close>Close</button>
    </div>
  </div>
</Modal>

<script>
  import { ApiError, apiDelete, apiGet, apiPatch, apiPost, errorMessage } from '@/utils/api';
  import { applyApiError, clearErrors, setFieldError, showAlert } from '@/utils/forms';
  import { formatDate, formatDateTime, pluralize, prettyUrl } from '@/utils/format';
  import { linkHref } from '@/utils/link-address';
  import { html, setHTML, type RawHTML } from '@/utils/html';
  import { icon } from '@/utils/icons';
  import { personName } from '@/utils/people';
  import { closeDialog, confirmDialog, copyWithFeedback, hydrateTimes, openDialog, setLoading, toast } from '@/utils/ui';
  import { creatorName, getMe, getMyOrganization } from '@/utils/viewer';
  import type { LinkListResponse, OrgMember, ServiceAccount, ServiceTokenInfo, ServiceTokenIssued } from '@/utils/types';

  const BASE = '/api/v1/service-accounts';
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const section = $('[data-services-section]');
  const host = $('[data-services]');
  const empty = $('[data-services-empty]');
  const listError = $('[data-services-error]');
  const newBtn = $<HTMLButtonElement>('[data-service-new]');

  const formDialog = $<HTMLDialogElement>('#service-form');
  const form = $<HTMLFormElement>('[data-service-form]');
  const saveBtn = $<HTMLButtonElement>('[data-service-save]');
  const responsibleSelect = form.elements.namedItem('responsible_user_id') as HTMLSelectElement;

  const tokenDialog = $<HTMLDialogElement>('#service-token');
  const askForm = $<HTMLFormElement>('[data-token-ask]');
  const showBlock = $('[data-token-show]');
  const makeBtn = $<HTMLButtonElement>('[data-token-make]');
  const tokenValue = $('[data-token-value]');
  const copyBtn = $<HTMLButtonElement>('[data-token-copy]');

  let accounts: ServiceAccount[] = [];
  let people: OrgMember[] = [];
  let owner = false;
  /** The account the form edits; null makes a new one. */
  let editing: ServiceAccount | null = null;
  /** The account the token dialog is for. */
  let tokenFor: ServiceAccount | null = null;
  /** The token just made, in memory only: never written into the page until shown, gone on Done. */
  let fresh: string | null = null;

  // ---------------------------------------------------------------- Rendering
  const ROLE: Record<ServiceAccount['role'], RawHTML> = {
    member: html`<span class="badge badge-neutral">${icon('user', 'size-3')}Member</span>`,
    admin: html`<span class="badge badge-brand">${icon('shield', 'size-3')}Admin</span>`,
  };

  function tokenLine(a: ServiceAccount, token: ServiceTokenInfo): RawHTML {
    return html`<span class="font-mono text-ink-900">${token.prefix}…</span>
      <span aria-hidden="true">·</span> <span>Made ${formatDate(token.created_at)}</span>
      <span aria-hidden="true">·</span> <span>${token.expires_at ? `Expires ${formatDateTime(token.expires_at)}` : 'Doesn’t expire'}</span>
      <span aria-hidden="true">·</span> <span>${token.last_used_at ? html`Last used <time data-relative datetime="${token.last_used_at}"></time>` : 'Not used yet'}</span>
      <span aria-hidden="true">·</span> ${tokenLinksButton(a, token)}`;
  }

  /** "Which links did this token create?": what to check when one may have leaked. */
  function tokenLinksButton(a: ServiceAccount, token: ServiceTokenInfo): RawHTML {
    return html`<button type="button" class="link text-[13px]" data-service-action="token-links" data-id="${a.id}" data-token="${token.id}" aria-label="Links made with it, ${token.prefix}">Links made with it</button>`;
  }

  function row(a: ServiceAccount): RawHTML {
    const menuId = `service-menu-${a.id}`;
    const linksHref = `/dashboard/?type=all&via_service_account=${encodeURIComponent(a.id)}`;
    return html`<li class="grid gap-2 px-4 py-4 sm:px-5" data-service="${a.id}">
      <div class="flex items-start gap-3">
        <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-ink-950 text-brand-300">${icon('plug', 'size-4')}</span>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="truncate font-semibold text-ink-950">${a.display_name}</h3>
            ${ROLE[a.role]}
          </div>
          ${a.description ? html`<p class="mt-0.5 text-sm text-ink-600">${a.description}</p>` : ''}
          <p class="mt-0.5 text-xs text-ink-500">${a.responsible ? html`Person responsible: <span title="${a.responsible.email}">${personName(a.responsible)}</span>` : 'No person responsible'}</p>
        </div>
        ${owner
          ? html`<button type="button" class="btn btn-ghost btn-sm btn-icon shrink-0" popovertarget="${menuId}" aria-label="More actions for ${a.display_name}" data-service-menu="${a.id}">${icon('more')}</button>
              <div id="${menuId}" popover class="menu" data-align="end">
                <button type="button" class="menu-item" data-service-action="edit" data-id="${a.id}">${icon('pencil')}Edit</button>
                <a class="menu-item" href="${linksHref}">${icon('link')}Its links</a>
                <div class="menu-sep"></div>
                <button type="button" class="menu-item" data-danger data-service-action="remove" data-id="${a.id}">${icon('trash')}Remove service account</button>
              </div>`
          : html`<a class="btn btn-ghost btn-sm shrink-0" href="${linksHref}">${icon('link')}Its links</a>`}
      </div>
      <div class="flex flex-col gap-2 rounded-xl bg-ink-50 px-3 py-2.5 text-[13px] text-ink-600 sm:ml-12 sm:flex-row sm:items-center">
        <p class="flex min-w-0 flex-1 flex-wrap items-center gap-x-1.5 gap-y-0.5">
          ${icon('key', 'size-3.5 shrink-0 text-ink-500')}${a.token ? tokenLine(a, a.token) : html`<span>No token yet</span>`}
        </p>
        ${owner
          ? html`<div class="flex shrink-0 gap-2">
              <button type="button" class="btn btn-secondary btn-sm" data-service-action="token" data-id="${a.id}">${icon(a.token ? 'refresh' : 'plus')}${a.token ? 'Renew token' : 'Create token'}</button>
              ${a.token || a.previous_token ? html`<button type="button" class="btn btn-danger-ghost btn-sm" data-service-action="revoke" data-id="${a.id}">${icon('ban')}Revoke</button>` : ''}
            </div>`
          : ''}
      </div>
      ${a.previous_token
        ? html`<div class="flex flex-col gap-2 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2.5 text-[13px] text-amber-900 sm:ml-12 sm:flex-row sm:items-center">
            <p class="flex min-w-0 flex-1 items-start gap-1.5">${icon('clock', 'size-3.5 mt-0.5 shrink-0')}<span>The previous token, <span class="font-mono">${a.previous_token.prefix}…</span>, keeps working until ${formatDateTime(a.previous_token.valid_until)}. ${tokenLinksButton(a, a.previous_token)}</span></p>
            ${owner ? html`<button type="button" class="btn btn-secondary btn-sm shrink-0" data-service-action="revoke-old" data-id="${a.id}">End it now</button>` : ''}
          </div>`
        : ''}
    </li>`;
  }

  function render() {
    section.hidden = false;
    $('[data-services-count]').textContent = accounts.length ? ` · ${accounts.length}` : '';
    $('[data-services-hint]').textContent = owner
      ? 'Only you and other owners make and change them. Admins see them.'
      : 'Only owners make and change them.';
    newBtn.hidden = !owner;
    empty.hidden = accounts.length > 0;
    setHTML(host, html`${accounts.map(row)}`);
    hydrateTimes(host);
  }

  // ---------------------------------------------------------------- Load
  async function load(): Promise<void> {
    const org = await getMyOrganization().catch(() => null);
    if (!org || (org.role !== 'owner' && org.role !== 'admin')) {
      section.hidden = true; // members don't see it
      return;
    }
    owner = org.role === 'owner';
    try {
      accounts = await apiGet<ServiceAccount[]>(BASE);
      listError.hidden = true;
    } catch (err) {
      if (err instanceof ApiError && (err.status === 403 || err.status === 404)) {
        section.hidden = true; // the role changed meanwhile, or an API older than service accounts
        return;
      }
      section.hidden = false;
      listError.textContent = errorMessage(err);
      listError.hidden = false;
      return;
    }
    render();
  }

  async function reload(focusId?: string) {
    await load();
    const target = focusId && host.querySelector<HTMLElement>(`[data-service="${CSS.escape(focusId)}"] button, [data-service="${CSS.escape(focusId)}"] a`);
    (target || newBtn)?.focus();
  }

  // ---------------------------------------------------------------- New and edit
  async function openForm(account: ServiceAccount | null) {
    editing = account;
    clearErrors(form);
    form.reset();
    try {
      const [me, members] = await Promise.all([getMe(), apiGet<OrgMember[]>('/api/v1/organization/members')]);
      people = members;
      const chosen = account?.responsible?.user_id ?? me.id;
      setHTML(
        responsibleSelect,
        html`${people.map((p) => html`<option value="${p.user_id}" ${p.user_id === chosen ? html`selected` : ''}>${personName(p)}${personName(p) !== p.email ? ` (${p.email})` : ''}</option>`)}`,
      );
    } catch (err) {
      toast('Couldn’t load the organization’s people', 'error', { description: errorMessage(err) });
      return;
    }
    $('#service-form-title').textContent = account ? `Edit ${account.display_name}` : 'New service account';
    saveBtn.textContent = account ? 'Save changes' : 'Create service account';
    (form.elements.namedItem('display_name') as HTMLInputElement).value = account?.display_name ?? '';
    (form.elements.namedItem('description') as HTMLTextAreaElement).value = account?.description ?? '';
    form.querySelectorAll<HTMLInputElement>('input[name="role"]').forEach((r) => (r.checked = r.value === (account?.role ?? 'member')));
    openDialog(formDialog);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors(form);
    const data = new FormData(form);
    const name = String(data.get('display_name') ?? '').trim();
    if (!name) {
      setFieldError(form, 'display_name', 'Give it a name, such as the system’s.');
      (form.elements.namedItem('display_name') as HTMLInputElement).focus();
      return;
    }
    const body = {
      display_name: name,
      description: String(data.get('description') ?? '').trim() || null,
      responsible_user_id: String(data.get('responsible_user_id') ?? ''),
      role: String(data.get('role') ?? 'member'),
    };
    setLoading(saveBtn, true, editing ? 'Saving…' : 'Creating…');
    let saved: ServiceAccount;
    try {
      saved = editing ? await apiPatch<ServiceAccount>(`${BASE}/${encodeURIComponent(editing.id)}`, body) : await apiPost<ServiceAccount>(BASE, body);
    } catch (err) {
      setLoading(saveBtn, false);
      if (!applyApiError(form, err)) showAlert(form, errorMessage(err));
      return;
    }
    setLoading(saveBtn, false);
    const made = !editing;
    await closeDialog(formDialog);
    toast(made ? `${saved.display_name} created` : 'Changes saved', 'success', made ? { description: 'Now make its token.' } : {});
    await reload(saved.id);
    if (made) openToken(saved);
  });

  // ---------------------------------------------------------------- The token
  function openToken(account: ServiceAccount) {
    tokenFor = account;
    fresh = null;
    clearErrors(askForm);
    askForm.reset();
    askForm.hidden = false;
    showBlock.hidden = true;
    tokenValue.textContent = '';
    const renewing = Boolean(account.token);
    $('#service-token-title').textContent = renewing ? `Renew the token of ${account.display_name}` : `Create the token of ${account.display_name}`;
    $('[data-token-ask-body]').textContent = renewing
      ? 'You get a new token. The current one keeps working for 24 hours, so the service can switch without failing; end it sooner from this page.'
      : 'The service sends it with every request, in the Authorization header. You’ll see it once, right after making it.';
    makeBtn.textContent = renewing ? 'Renew token' : 'Create token';
    openDialog(tokenDialog);
    (askForm.elements.namedItem('expires_at') as HTMLInputElement).focus();
  }

  askForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!tokenFor) return;
    clearErrors(askForm);
    const day = (askForm.elements.namedItem('expires_at') as HTMLInputElement).value;
    // The end of the day picked, in the viewer's time zone.
    const expires = day ? new Date(`${day}T23:59:59`) : null;
    if (expires && expires.getTime() <= Date.now()) {
      setFieldError(askForm, 'expires_at', 'Pick a day after today, or leave it empty.');
      (askForm.elements.namedItem('expires_at') as HTMLInputElement).focus();
      return;
    }
    setLoading(makeBtn, true, 'Making it…');
    let issued: ServiceTokenIssued;
    try {
      issued = await apiPost<ServiceTokenIssued>(`${BASE}/${encodeURIComponent(tokenFor.id)}/token`, { expires_at: expires ? expires.toISOString() : null });
    } catch (err) {
      setLoading(makeBtn, false);
      if (!applyApiError(askForm, err)) showAlert(askForm, errorMessage(err));
      return;
    }
    setLoading(makeBtn, false);
    fresh = issued.token;
    askForm.hidden = true;
    showBlock.hidden = false;
    tokenValue.textContent = fresh;
    $('[data-token-done-title]').textContent = issued.renewed ? 'Here’s the new token.' : 'Here’s the token.';
    $('[data-token-show-hint]').textContent = issued.renewed
      ? `Anyone with it can make links as ${issued.service_account.display_name}, so treat it like a password. The previous one works for 24 more hours.`
      : `Anyone with it can make links as ${issued.service_account.display_name}, so treat it like a password.`;
    copyBtn.focus();
    accounts = accounts.map((a) => (a.id === issued.service_account.id ? issued.service_account : a));
    render();
  });

  // Copied from memory when clicked.
  copyBtn.addEventListener('click', () => {
    if (fresh) void copyWithFeedback(fresh, copyBtn);
  });

  async function finishToken() {
    const id = tokenFor?.id;
    fresh = null;
    tokenValue.textContent = '';
    await closeDialog(tokenDialog);
    if (id) await reload(id);
  }
  $('[data-token-done]').addEventListener('click', () => void finishToken());
  // Closing the dialog any other way forgets the token too.
  tokenDialog.addEventListener('close', () => {
    fresh = null;
    tokenValue.textContent = '';
  });

  // ---------------------------------------------------------------- Revoke and remove
  async function revoke(account: ServiceAccount, oldOnly: boolean) {
    const ok = await confirmDialog(
      oldOnly
        ? {
            title: `End the previous token of ${account.display_name}?`,
            body: 'It stops working right away. The current token keeps working.',
            confirmLabel: 'End previous token',
            danger: true,
            onConfirm: () => apiDelete(`${BASE}/${encodeURIComponent(account.id)}/token?old_only=true`),
          }
        : {
            title: `Revoke the token of ${account.display_name}?`,
            body: `${account.display_name} stops working right away, until you make it a new token. Its links keep working.`,
            confirmLabel: 'Revoke token',
            danger: true,
            onConfirm: () => apiDelete(`${BASE}/${encodeURIComponent(account.id)}/token`),
          },
    );
    if (!ok) return;
    toast(oldOnly ? 'Previous token ended' : 'Token revoked', 'success');
    await reload(account.id);
  }

  async function remove(account: ServiceAccount) {
    const ok = await confirmDialog({
      title: `Remove ${account.display_name}?`,
      body: 'Its token stops working right away and it leaves the organization. The links it made keep working and keep its name.',
      confirmLabel: 'Remove service account',
      danger: true,
      onConfirm: () => apiDelete(`${BASE}/${encodeURIComponent(account.id)}`),
    });
    if (!ok) return;
    toast(`${account.display_name} removed`, 'success');
    await reload();
  }

  // ---------------------------------------------------------------- What one token made
  const linksDialog = $<HTMLDialogElement>('#token-links');
  const linksHost = $('[data-token-links]');
  const linksHint = $('[data-token-links-hint]');

  async function showTokenLinks(account: ServiceAccount, tokenId: string) {
    const token = [account.token, account.previous_token].find((t) => t?.id === tokenId);
    $('#token-links-title').textContent = `Links made with ${token?.prefix ?? 'this token'}…`;
    linksHint.textContent = 'Loading…';
    linksHost.replaceChildren();
    openDialog(linksDialog);
    try {
      const res = await apiGet<LinkListResponse>(`${BASE}/${encodeURIComponent(account.id)}/links?token_id=${encodeURIComponent(tokenId)}&limit=100`);
      linksHint.textContent = res.total
        ? `${pluralize(res.total, 'link')}, newest first${res.total > res.urls.length ? `: the latest ${res.urls.length} here` : ''}.`
        : 'None yet.';
      setHTML(
        linksHost,
        html`${res.urls.map(
          (l) => html`<li class="rounded-xl border border-line px-3 py-2 text-sm">
            <a class="shortlink text-ink-950 hover:underline" href="${linkHref(l.short_code, l.domain)}">${prettyUrl(l.short_url ?? l.short_code)}</a>
            <p class="truncate text-xs text-ink-500">${formatDate(l.created_at)}${l.created_by_email && creatorName(l, null) ? ` · ${creatorName(l, null)}` : ''}</p>
          </li>`,
        )}`,
      );
    } catch (err) {
      linksHint.textContent = errorMessage(err);
    }
  }

  host.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-service-action]');
    if (!btn) return;
    btn.closest<HTMLElement>('[popover]')?.hidePopover();
    const account = accounts.find((a) => a.id === btn.dataset.id);
    if (!account) return;
    const action = btn.dataset.serviceAction;
    if (action === 'edit') void openForm(account);
    else if (action === 'token') openToken(account);
    else if (action === 'revoke') void revoke(account, false);
    else if (action === 'revoke-old') void revoke(account, true);
    else if (action === 'remove') void remove(account);
    else if (action === 'token-links' && btn.dataset.token) void showTokenLinks(account, btn.dataset.token);
  });
  newBtn.addEventListener('click', () => void openForm(null));

  void load();
</script>
