---
import Icon from '@/components/ui/Icon.astro';
import GoogleLogo from '@/components/ui/GoogleLogo.astro';
import PasswordField from '@/components/ui/PasswordField.astro';
import SettingsSection from './SettingsSection.astro';
---

<div class="grid gap-10">
  <SettingsSection id="profile-title" title="Profile" description="How you log in to Shurly.">
    <div class="card overflow-hidden">
      <div class="grid gap-1.5 p-5 sm:p-6">
        <label for="profile-email" class="label">Email</label>
        <div class="skeleton h-12 w-full rounded-xl sm:max-w-md" data-profile-skeleton aria-hidden="true"></div>
        <div class="relative sm:max-w-md" data-profile-field hidden>
          <input id="profile-email" type="email" class="input input-lg pr-11" readonly aria-describedby="profile-email-hint" data-profile-email />
          <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-ink-400"><Icon name="lock" /></span>
        </div>
        <p id="profile-email-hint" class="hint">That’s how you log in. To change it, ask your Shurly admin.</p>
      </div>
      <p class="flex items-center gap-2 border-t border-line bg-ink-50/60 px-5 py-3 text-sm text-ink-600 sm:px-6">
        <Icon name="calendar" class="size-4 shrink-0 text-ink-400" />
        <span data-member-since><span class="skeleton inline-block h-4 w-48 align-middle"></span></span>
      </p>
    </div>
  </SettingsSection>

  <SettingsSection id="password-title" title="Password" description="Optional when you sign in with Google. Pick something long that you don’t use anywhere else.">
    <!-- POST: submitted before the script loads, the passwords must not end up in the URL -->
    <form class="card overflow-hidden" data-password-form method="post" novalidate aria-labelledby="password-title">
      <div class="grid gap-5 p-5 sm:p-6">
        <p class="text-sm leading-6 text-ink-600" data-password-status><span class="skeleton inline-block h-4 w-64 align-middle"></span></p>
        <div data-form-alert hidden></div>
        <div class="flex flex-col gap-3 rounded-xl border border-ink-200 bg-ink-50 px-3.5 py-3 text-sm text-ink-800 sm:flex-row sm:items-center" data-reauth hidden role="status">
          <p class="flex-1" data-reauth-message></p>
          <button type="button" class="btn btn-secondary btn-sm self-start sm:self-auto" data-reauth-google><GoogleLogo class="size-4" />Sign in with Google again</button>
        </div>
        <!-- Lets password managers know which account this password belongs to -->
        <input type="email" name="username" autocomplete="username" hidden data-username />
        <div class="grid items-start gap-5 sm:grid-cols-2">
          <div data-current-field hidden>
            <PasswordField id="current-password" name="current_password" label="Current password" autocomplete="current-password">
              <span slot="label-end" class="text-xs text-ink-500" data-current-optional hidden>Optional</span>
            </PasswordField>
          </div>
          <PasswordField id="new-password" name="new_password" label="New password" autocomplete="new-password" minlength={8} hint="At least 8 characters" />
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-end gap-2 border-t border-line bg-ink-50/60 px-5 py-3 sm:px-6">
        <button type="button" class="btn btn-danger-ghost mr-auto" data-remove-password data-tooltip-align="start" hidden>Remove password</button>
        <button type="submit" class="btn btn-primary" data-password-submit>Update password</button>
      </div>
    </form>
  </SettingsSection>

  <SettingsSection id="danger-title" title="Danger zone" description="Things you can’t undo.">
    <div class="card flex gap-4 border-red-200 p-5 sm:p-6">
      <span class="grid size-10 shrink-0 place-items-center rounded-full bg-red-50 text-red-600"><Icon name="trash" class="size-5" /></span>
      <div class="min-w-0">
        <h3 class="font-semibold text-ink-950">Delete account</h3>
        <p class="mt-1 text-sm leading-6 text-ink-600">
          You can’t delete an account from the app yet. To delete your account and all its links, contact your Shurly admin.
        </p>
      </div>
    </div>
  </SettingsSection>
</div>

<script>
  import { ApiError, apiDelete, apiPut } from '@/utils/api';
  import { applyApiError, clearErrors, setFieldError } from '@/utils/forms';
  import { formatDate } from '@/utils/format';
  import { startGoogleSignIn } from '@/utils/google-signin';
  import { iconSvg } from '@/utils/icons';
  import { confirmDialog, setLoading, toast } from '@/utils/ui';
  import { refreshMe } from '@/utils/viewer';
  import { currentUser } from './store';
  import type { User } from '@/utils/types';

  // ---------------------------------------------------------------- Profile
  const emailInput = document.querySelector<HTMLInputElement>('[data-profile-email]')!;
  const usernameInput = document.querySelector<HTMLInputElement>('[data-username]')!;

  currentUser.subscribe((user) => {
    emailInput.value = user.email;
    // defaultValue so that resetting the password form keeps it
    usernameInput.defaultValue = user.email;
    usernameInput.value = user.email;
    document.querySelector<HTMLElement>('[data-profile-skeleton]')!.hidden = true;
    document.querySelector<HTMLElement>('[data-profile-field]')!.hidden = false;
    document.querySelector<HTMLElement>('[data-member-since]')!.textContent =
      `Member since ${formatDate(user.created_at, { month: 'long', day: 'numeric', year: 'numeric' })}`;
  });

  // ---------------------------------------------------------------- Password (Phase 3.13.3)
  // Set, change or remove a password, only while signed in. Replacing one takes the current
  // password, or with Google a recent sign-in instead (so the current one is optional there).
  // Without Google, the password is the only way in, so it can't be removed.
  const form = document.querySelector<HTMLFormElement>('[data-password-form]')!;
  const current = form.elements.namedItem('current_password') as HTMLInputElement;
  const next = form.elements.namedItem('new_password') as HTMLInputElement;
  const submit = form.querySelector<HTMLButtonElement>('[data-password-submit]')!;
  const removeBtn = form.querySelector<HTMLButtonElement>('[data-remove-password]')!;
  const currentField = form.querySelector<HTMLElement>('[data-current-field]')!;
  const currentOptional = form.querySelector<HTMLElement>('[data-current-optional]')!;
  const status = form.querySelector<HTMLElement>('[data-password-status]')!;
  const reauth = form.querySelector<HTMLElement>('[data-reauth]')!;
  const hint = form.querySelector<HTMLElement>('[data-password-hint]')!;
  const newLabel = form.querySelector<HTMLLabelElement>('label[for="new-password"]')!;
  const ONLY_WAY_IN = 'Your password is how you sign in, so it can’t be removed.';

  // APIs older than Google sign-in don't say: every account there has a password and no Google.
  let hasPassword = true;
  let hasGoogle = false;
  const needsCurrent = () => hasPassword && !hasGoogle;

  function renderPasswordState() {
    status.textContent = hasGoogle
      ? hasPassword
        ? 'You sign in with Google, or with your email and this password.'
        : 'You sign in with Google. Add a password to also log in with your email.'
      : 'You log in with your email and password.';
    currentField.hidden = !hasPassword;
    current.required = needsCurrent();
    currentOptional.hidden = needsCurrent();
    newLabel.textContent = hasPassword ? 'New password' : 'Password';
    submit.textContent = hasPassword ? 'Update password' : 'Set password';
    removeBtn.hidden = !hasPassword;
    // Removing the only way in is refused (409): say so before anyone tries.
    if (hasGoogle) {
      removeBtn.removeAttribute('aria-disabled');
      delete removeBtn.dataset.tooltip;
    } else {
      removeBtn.setAttribute('aria-disabled', 'true');
      removeBtn.dataset.tooltip = ONLY_WAY_IN;
    }
  }

  currentUser.subscribe((user: User) => {
    hasPassword = user.has_password ?? true;
    hasGoogle = user.has_google ?? false;
    renderPasswordState();
  });

  // Live length check: the hint earns a brand check once the rule is met.
  const renderHint = () => {
    const ok = next.value.length >= 8;
    hint.innerHTML = ok
      ? `<span class="grid size-4 place-items-center rounded-full bg-brand-400 text-white">${iconSvg('check', 'size-3', 3)}</span><span class="text-ink-700">At least 8 characters</span>`
      : `<span class="size-4 rounded-full border-2 border-ink-300"></span><span>At least 8 characters</span>`;
  };
  renderHint();
  next.addEventListener('input', renderHint);

  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.getAttribute('aria-invalid')) setFieldError(form, t.name, null);
  });

  /** Put both fields back to hidden text after a successful change. */
  function hidePasswords() {
    form.querySelectorAll<HTMLElement>('[data-password-field]').forEach((field) => {
      const toggle = field.querySelector<HTMLButtonElement>('[data-toggle-password]')!;
      field.querySelector('input')!.type = 'password';
      toggle.setAttribute('aria-pressed', 'false');
      toggle.setAttribute('aria-label', 'Show password');
      field.querySelector<HTMLElement>('[data-eye]')!.hidden = false;
      field.querySelector<HTMLElement>('[data-eye-off]')!.hidden = true;
    });
  }

  /**
   * The API wants a fresh Google sign-in first (403 `reauth_required`): offer it, and come back
   * here. Our own words, as for the sign-in errors, since the API's say "set" whatever the change.
   */
  function showReauth(change: 'set' | 'change' | 'remove') {
    form.querySelector<HTMLElement>('[data-reauth-message]')!.textContent = {
      set: 'Setting a password needs a recent sign-in with Google.',
      change: 'Changing your password needs your current password or a recent sign-in with Google.',
      remove: 'Removing your password needs a recent sign-in with Google.',
    }[change];
    reauth.hidden = false;
    form.querySelector<HTMLButtonElement>('[data-reauth-google]')!.focus();
  }
  form.querySelector<HTMLButtonElement>('[data-reauth-google]')!.addEventListener('click', (e) => {
    setLoading(e.currentTarget as HTMLButtonElement, true, 'Opening Google…');
    startGoogleSignIn('/dashboard/settings/#account');
  });

  const isReauth = (err: unknown): boolean => err instanceof ApiError && err.code === 'reauth_required';

  /** Read the account again, so the section shows what changed. */
  async function refresh() {
    try {
      currentUser.set(await refreshMe());
    } catch {
      /* the next page load catches up */
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors(form);
    reauth.hidden = true;

    let ok = true;
    if (needsCurrent() && !current.value) {
      setFieldError(form, 'current_password', 'Enter your current password.');
      ok = false;
    }
    if (!next.value) {
      setFieldError(form, 'new_password', 'Choose a password.');
      ok = false;
    } else if (next.value.length < 8) {
      setFieldError(form, 'new_password', 'Use at least 8 characters.');
      ok = false;
    } else if (current.value && next.value === current.value) {
      setFieldError(form, 'new_password', 'Choose a password that’s different from your current one.');
      ok = false;
    }
    if (!ok) {
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      return;
    }

    const hadPassword = hasPassword;
    setLoading(submit, true, hadPassword ? 'Updating…' : 'Setting…');
    try {
      // With the current password, the API doesn't need a recent sign-in.
      const withCurrent = hasPassword && current.value !== '';
      await apiPut('/api/v1/auth/password', withCurrent ? { new_password: next.value, current_password: current.value } : { new_password: next.value });
    } catch (err) {
      setLoading(submit, false);
      if (isReauth(err)) {
        showReauth(hadPassword ? 'change' : 'set');
      } else if (err instanceof ApiError && err.status === 400 && /current password/i.test(err.message)) {
        // "Current password is incorrect", or "Give your current password to replace it.", which
        // means the page was out of date: read the account again, and the field shows up.
        if (currentField.hidden) await refresh();
        setFieldError(form, 'current_password', /incorrect/i.test(err.message) ? 'That doesn’t match your current password.' : 'Enter your current password.');
        current.focus();
        current.select();
      } else {
        applyApiError(form, err);
      }
      return;
    }
    // Before refresh(), which relabels the button ("Set password" becomes "Update password").
    setLoading(submit, false);
    form.reset();
    hidePasswords();
    renderHint();
    toast(hadPassword ? 'Password updated' : 'Password set', 'success', { description: 'Use it next time you log in with your email.' });
    await refresh();
  });

  removeBtn.addEventListener('click', async () => {
    clearErrors(form);
    reauth.hidden = true;
    if (!hasGoogle) {
      toast(ONLY_WAY_IN, 'info');
      return;
    }
    let refused = null as ApiError | null;
    const ok = await confirmDialog({
      title: 'Remove your password?',
      body: 'You’ll sign in with Google only. You can set a new password any time.',
      confirmLabel: 'Remove password',
      danger: true,
      onConfirm: async () => {
        try {
          await apiDelete('/api/v1/auth/password');
        } catch (err) {
          // Not errors for the dialog: a fresh Google sign-in fixes the first, and a 409 means
          // the page was out of date (the account has no Google identity after all).
          if (!(err instanceof ApiError) || !(isReauth(err) || err.status === 409)) throw err;
          refused = err;
        }
      },
    });
    if (!ok) return;
    if (refused && isReauth(refused)) {
      showReauth('remove');
      return;
    }
    if (refused) toast(ONLY_WAY_IN, 'info');
    else toast('Password removed', 'success', { description: 'You sign in with Google now.' });
    await refresh();
  });
</script>
