---
/**
 * Shurly logo. The diamond dot is the signature ("surely." / the click): Griddo blue on
 * light surfaces, cyan on navy.
 * - variant: wordmark (default) | isotype ("sy" on a rounded tile)
 * - tone: default (for light surfaces) | reversed (for dark surfaces) | mono (single navy ink)
 * Clear space: keep at least the diamond's width free around the mark.
 * The wordmark's box includes the "y" descender, so it renders ~1.35x taller than a cap-height mark.
 */
interface Props {
  variant?: 'wordmark' | 'isotype';
  tone?: 'default' | 'reversed' | 'mono';
  /** Rendered height in px. Width follows the mark's aspect ratio. */
  height?: number;
  class?: string;
  href?: string | null;
}

const { variant = 'wordmark', tone = 'default', height = 24, class: className = '', href = null } = Astro.props;

// Aspect ratios from the generated SVG viewBoxes (see design/brand/README.md).
const RATIO = { wordmark: 463.11 / 176.45, isotype: 1 };
const FILES = {
  wordmark: { default: 'shurly-logo-horizontal.svg', reversed: 'shurly-logo-horizontal-reversed.svg', mono: 'shurly-logo-horizontal-mono-navy.svg' },
  // On light surfaces the navy tile reads best; on dark ones, the white tile.
  isotype: { default: 'shurly-isotype-reversed.svg', reversed: 'shurly-isotype.svg', mono: 'shurly-isotype-reversed.svg' },
};
const src = `/brand/${FILES[variant][tone]}`;
const width = Math.round(height * RATIO[variant]);
const Tag = href ? 'a' : 'span';
---

<Tag href={href ?? undefined} class:list={['inline-flex shrink-0 items-center', className]} aria-label={href ? 'Shurly home' : undefined}>
  <img src={src} width={width} height={height} alt={href ? '' : 'Shurly'} draggable="false" />
</Tag>
