---
import Icon from './Icon.astro';

interface Props {
  id: string;
  name?: string;
  label: string;
  autocomplete: 'current-password' | 'new-password';
  minlength?: number;
  hint?: string;
}

const { id, name = id, label, autocomplete, minlength, hint } = Astro.props;
---

<div class="grid gap-1.5" data-password-field>
  <div class="flex items-center justify-between">
    <label for={id} class="label">{label}</label>
    <slot name="label-end" />
  </div>
  <div class="relative">
    <input
      id={id}
      name={name}
      type="password"
      class="input input-lg pr-11"
      autocomplete={autocomplete}
      minlength={minlength}
      required
      aria-describedby={`${id}-error${hint ? ` ${id}-hint` : ''}`}
    />
    <button
      type="button"
      class="absolute inset-y-0 right-1 my-auto grid size-9 place-items-center rounded-md text-ink-500 hover:bg-ink-100 hover:text-ink-900"
      data-toggle-password
      aria-label="Show password"
      aria-pressed="false"
    >
      <span data-eye><Icon name="eye" /></span>
      <span data-eye-off hidden><Icon name="eye-off" /></span>
    </button>
  </div>
  {hint && <p id={`${id}-hint`} class="hint flex items-center gap-1.5" data-password-hint>{hint}</p>}
  <p id={`${id}-error`} class="field-error" data-error-for={name} hidden></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-password-field]').forEach((field) => {
    const input = field.querySelector('input')!;
    const btn = field.querySelector<HTMLButtonElement>('[data-toggle-password]')!;
    btn.addEventListener('click', () => {
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.setAttribute('aria-pressed', String(show));
      btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
      field.querySelector<HTMLElement>('[data-eye]')!.hidden = show;
      field.querySelector<HTMLElement>('[data-eye-off]')!.hidden = !show;
      input.focus();
    });
  });
</script>
