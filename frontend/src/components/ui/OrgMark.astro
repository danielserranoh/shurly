---
/**
 * Phase 3.14.4, 3.14.6 — an organization mark, a circle like an avatar: the name's initial in brand
 * blue on navy until the logo loads, then the logo filling the circle (`object-cover`) on white with a
 * hairline ring, so a transparent one sits on a neutral light ground. Logos are cropped to a square
 * since 3.14.6; an older, wider one shows cut to the circle until it's uploaded again. Painted by
 * `paintOrgMark` (src/utils/org-logo.ts). Size and type size come from `class`.
 */
interface Props {
  class?: string;
  /** The logo's alt text: empty (the default) where the name is next to it. */
  alt?: string;
}

const { class: className, alt = '' } = Astro.props;
---

<span
  class:list={[
    'grid shrink-0 place-items-center overflow-hidden rounded-full bg-ink-950 font-semibold text-brand-300 data-has-logo:bg-white data-has-logo:ring-1 data-has-logo:ring-line',
    className,
  ]}
  data-org-mark
>
  <span data-org-initial aria-hidden="true"></span>
  <img class="size-full object-cover" alt={alt} data-org-logo hidden />
</span>
