---
import Icon from './Icon.astro';

interface Props {
  title: string;
  description?: string;
  back?: { href: string; label: string };
  /** id for the <h1> so scripts can replace the title once data loads */
  titleId?: string;
}

const { title, description, back, titleId } = Astro.props;
---

<div class="mb-8">
  {
    back && (
      <a href={back.href} class="mb-3 inline-flex items-center gap-1.5 rounded-md text-sm font-medium text-ink-500 transition-colors hover:text-ink-950">
        <Icon name="arrow-left" />
        {back.label}
      </a>
    )
  }
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div class="min-w-0">
      <h1 id={titleId} class="display text-3xl text-ink-950 sm:text-[2.125rem]">{title}</h1>
      {description && <p class="mt-2 max-w-2xl text-[15px] text-ink-500" data-page-description>{description}</p>}
      <slot name="meta" />
    </div>
    <div class="flex shrink-0 flex-wrap items-center gap-2">
      <slot name="actions" />
    </div>
  </div>
</div>
