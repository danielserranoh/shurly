---
// Phase 3.12 — the crop dialog for an avatar: zoom and move the photo under the circle.
// Markup only; `cropAvatar(file, onSave)` (src/utils/avatar-cropper.ts) opens and drives it.
// The circle is always covered: the rules live in src/utils/avatar-crop.ts.
import Icon from './Icon.astro';
import Modal from './Modal.astro';
---

<Modal id="avatar-cropper" title="Position your photo" description="What’s inside the circle is what people see." width="24rem" staticBackdrop>
  <div class="grid gap-4 px-6 py-6">
    <div
      class="relative mx-auto size-64 cursor-grab touch-none overflow-hidden rounded-2xl bg-ink-100 select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink-950 active:cursor-grabbing"
      tabindex="0"
      role="group"
      aria-label="Photo position"
      aria-describedby="avatar-crop-help"
      data-crop-frame
    >
      <img class="pointer-events-none absolute top-0 left-0 max-w-none origin-top-left" alt="" draggable="false" data-crop-image />
      <span class="pointer-events-none absolute inset-0 rounded-full shadow-[0_0_0_9999px_rgb(0_0_0/0.5)] ring-2 ring-white/80" aria-hidden="true"></span>
    </div>
    <p id="avatar-crop-help" class="hint text-center">Drag to move it; scroll or pinch to zoom. Or use the arrow keys, and + and −.</p>
    <div class="flex items-center gap-3 text-ink-500">
      <Icon name="image" class="size-3.5 shrink-0" />
      <input type="range" min="0" max="1000" value="0" class="w-full cursor-pointer accent-ink-950" aria-label="Zoom" data-crop-zoom />
      <Icon name="image" class="size-5 shrink-0" />
    </div>
    <p class="field-error" role="alert" data-crop-error hidden></p>
  </div>
  <div class="flex justify-end gap-2 border-t border-line bg-ink-50/60 px-6 py-3">
    <button type="button" class="btn btn-secondary" data-dialog-close>Cancel</button>
    <button type="button" class="btn btn-primary" data-crop-save>Save photo</button>
  </div>
</Modal>
