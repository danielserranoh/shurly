---
/** Inline mono chip for class names and tokens. */
interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}

const { tone = 'light', class: className = '' } = Astro.props;
---

<code
  class:list={[
    'inline-flex rounded-md px-1.5 font-mono text-xs leading-5 whitespace-nowrap',
    tone === 'dark' ? 'bg-white/10 text-ink-200' : 'bg-ink-100 text-ink-700',
    className,
  ]}><slot /></code
>
