---
/**
 * A color scale read from global.css: swatch, step, hex (click to copy) and contrast
 * against white. Inline comments from the CSS become the notes under the scale.
 */
import Icon from '@/components/ui/Icon.astro';
import { contrast, ratio, WHITE, type ColorToken } from './tokens';

interface Props {
  tokens: ColorToken[];
  label: string;
  /** Short flags for key steps, e.g. { 'brand-400': 'Signature' } */
  markers?: Record<string, string>;
  /** Dark reference used to decide the on-swatch icon color. */
  ink: string;
}

const { tokens, label, markers = {}, ink } = Astro.props;
const notes = tokens.filter((t) => t.note);
const sentence = (s: string) => s.charAt(0).toUpperCase() + s.slice(1).replace(/\.?$/, '.');
---

<ol class="grid grid-cols-3 gap-x-3 gap-y-5 sm:grid-cols-6 xl:grid-cols-11" aria-label={label}>
  {
    tokens.map((t) => {
      const vsWhite = contrast(t.hex, WHITE);
      const lightSwatch = contrast(t.hex, ink) > vsWhite;
      const marker = markers[t.name];
      return (
        <li class="min-w-0">
          <button
            type="button"
            class="group block w-full rounded-xl text-left"
            data-copy={t.hex}
            aria-label={`${t.name}, ${t.hex}, ${ratio(t.hex, WHITE)} on white. Copy the hex value`}
          >
            <span
              class:list={[
                'relative grid h-16 place-items-center rounded-xl ring-1 ring-ink-950/5 transition-transform duration-150 ease-snappy ring-inset group-hover:-translate-y-0.5',
                lightSwatch ? 'text-ink-950' : 'text-white',
              ]}
              style={`background-color: ${t.hex}`}
            >
              <span data-copy-icon />
              {marker && (
                <span class="absolute top-1.5 left-1.5 rounded bg-white px-1 text-[10px] leading-4 font-semibold text-ink-950 shadow-xs">{marker}</span>
              )}
            </span>
            <span class="mt-2 block text-xs font-semibold text-ink-950">{t.step}</span>
            <span class="block font-mono text-[11px] leading-4 text-ink-600" data-copy-label>
              {t.hex}
            </span>
            <span class:list={['mt-0.5 flex items-center gap-1 text-[11px] leading-4', vsWhite >= 4.5 ? 'font-semibold text-ink-900' : 'text-ink-500']}>
              {ratio(t.hex, WHITE)}
              {vsWhite >= 4.5 && <Icon name="check" class="size-3 text-brand-700" strokeWidth={3} />}
            </span>
          </button>
        </li>
      );
    })
  }
</ol>

<div class="mt-6 grid gap-3 border-t border-line pt-4 text-sm text-ink-600">
  {
    notes.map((t) => (
      <p class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
        <code class="rounded-md bg-ink-100 px-1.5 font-mono text-xs leading-5 text-ink-700">{t.name}</code>
        <span>{sentence(t.note ?? '')}</span>
      </p>
    ))
  }
  <p class="flex items-center gap-1.5 text-xs text-ink-500">
    <Icon name="check" class="size-3 text-brand-700" strokeWidth={3} />
    Contrast against white. Checked shades are safe for text (4.5:1 or more). Click a swatch to copy its hex.
  </p>
</div>
