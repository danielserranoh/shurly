---
// Phase 10.3 — an owner deletes a link a service account manages, past it, saying why (POST …/override-delete).
// Behaviour in src/utils/link-editor.ts (`openOverrideDelete`): the title and body name the manager.
import Modal from '@/components/ui/Modal.astro';
import Icon from '@/components/ui/Icon.astro';
---

<Modal id="override-delete" title="Delete a link its service account manages?" width="30rem" staticBackdrop>
  <form id="override-delete-form" class="grid gap-4 px-6 py-5" novalidate>
    <div class="flex gap-3">
      <span class="grid size-10 shrink-0 place-items-center rounded-full bg-red-50 text-red-600"><Icon name="warning" class="size-5" /></span>
      <p class="text-sm leading-6 text-ink-600" data-override-body></p>
    </div>
    <div data-form-alert hidden></div>
    <div class="grid gap-1.5">
      <div class="flex items-baseline justify-between gap-3">
        <label for="override-reason" class="label">Reason</label>
        <span class="num text-xs text-ink-500" data-reason-count aria-hidden="true">0 / 500</span>
      </div>
      <textarea
        id="override-reason"
        name="reason"
        class="textarea"
        rows="3"
        required
        placeholder="e.g. The recipient asked us to delete their data"
        aria-describedby="override-reason-hint override-reason-error"></textarea>
      <p id="override-reason-hint" class="hint">10 to 500 characters. It’s kept with the deletion: owners and admins see it in the service account’s activity.</p>
      <p id="override-reason-error" class="field-error" data-error-for="reason" hidden></p>
    </div>
  </form>
  <div class="flex flex-col-reverse gap-2 border-t border-line px-6 py-4 sm:flex-row sm:justify-end">
    <button type="button" class="btn btn-secondary" data-dialog-close>Cancel</button>
    <button type="submit" form="override-delete-form" class="btn btn-danger" data-confirm-override><Icon name="trash" />Delete it</button>
  </div>
</Modal>
