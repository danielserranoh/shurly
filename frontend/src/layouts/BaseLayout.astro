---
import '@fontsource-variable/figtree';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/shadows-into-light-two';
import '@/styles/global.css';
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** Pages behind login: never indexed, and redirect to /login before first paint. */
  protected?: boolean;
  /** Auth pages: skip straight to the dashboard when already signed in. */
  guestOnly?: boolean;
  themeColor?: string;
  bodyClass?: string;
}

const {
  title,
  description = 'Trackable short links for small marketing teams. Send the link, know who opened it.',
  protected: isProtected = false,
  guestOnly = false,
  themeColor = '#faf9f6',
  bodyClass = '',
} = Astro.props;

const fullTitle = title === 'Shurly' ? 'Shurly — Send the link. Know who opened it.' : `${title} · Shurly`;
const ogImage = new URL('/og-image.png', Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    {isProtected && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="font" type="font/woff2" href={figtreeLatin} crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shurly" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {
      isProtected && (
        <script is:inline>
          if (!localStorage.getItem('shurly_auth_token')) {
            location.replace('/login/?next=' + encodeURIComponent(location.pathname + location.search));
          }
        </script>
      )
    }
    {
      guestOnly && (
        <script is:inline>
          if (localStorage.getItem('shurly_auth_token')) location.replace('/dashboard/');
        </script>
      )
    }
    <slot name="head" />
  </head>
  <body class:list={['min-h-dvh', bodyClass]}>
    <slot />
    <div id="toast-region" class="toast-region" aria-live="polite"></div>
    <script>
      import { installGlobalUI } from '@/utils/ui';
      installGlobalUI();
    </script>
  </body>
</html>
