---
import '@fontsource-variable/figtree';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/shadows-into-light-two';
import '@/styles/global.css';
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import { GUEST_GUARD, PROTECTED_GUARD } from '@/inline-scripts.mjs';

interface Props {
  title: string;
  description?: string;
  /** Pages behind login: never indexed, and redirect to /login before first paint. */
  protected?: boolean;
  /** Auth pages: skip straight to the dashboard when already signed in. */
  guestOnly?: boolean;
  themeColor?: string;
  bodyClass?: string;
}

const {
  title,
  description = 'Trackable short links for small marketing teams. Send the link, know who opened it.',
  protected: isProtected = false,
  guestOnly = false,
  themeColor = '#faf9f6',
  bodyClass = '',
} = Astro.props;

const fullTitle = title === 'Shurly' ? 'Shurly — Send the link. Know who opened it.' : `${title} · Shurly`;
const ogImage = new URL('/og-image.png', Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    {isProtected && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shurly" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>
  <body class:list={['min-h-dvh', bodyClass]}>
    {/*
      The guards go first in <body>, not in <head>: Astro writes its CSP <meta> at the end of <head>,
      and a <meta> policy only governs what comes after it. Here they still run before anything
      paints. Their text lives in src/inline-scripts.mjs, whose hashes the policy allows.
    */}
    {isProtected && <script is:inline set:html={PROTECTED_GUARD}></script>}
    {guestOnly && <script is:inline set:html={GUEST_GUARD}></script>}
    <link rel="preload" as="font" type="font/woff2" href={figtreeLatin} crossorigin />
    <script>
      // Browser errors reach the logs (Phase 6.4), from before the page's own scripts run.
      import { installErrorReporter } from '@/utils/error-reporter';
      installErrorReporter();
    </script>
    <slot />
    <div id="toast-region" class="toast-region" aria-live="polite"></div>
    <script>
      import { installGlobalUI } from '@/utils/ui';
      installGlobalUI();
    </script>
  </body>
</html>
