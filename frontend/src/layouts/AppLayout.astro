---
import BaseLayout from './BaseLayout.astro';
import Logo from '@/components/brand/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import OrgMark from '@/components/ui/OrgMark.astro';
import { site } from '@/config/site';
import { feedbackHref } from '@/utils/feedback';

type Section = 'links' | 'campaigns' | 'analytics' | 'waitlist' | 'settings' | 'organization';

interface Props {
  title: string;
  section?: Section;
  /** Content width: default 72rem, narrow 48rem for forms. */
  width?: 'default' | 'narrow' | 'wide';
}

const { title, section, width = 'default' } = Astro.props;
// Send feedback: an email to the team with this page's path, known here at build time, so no query gets in.
const feedback = feedbackHref(site.supportEmail, Astro.url.pathname);

// `admins`: shown to the organization's owners and admins only, once the header knows the viewer's role (the
// waitlist, 9.1). The API still decides: a member who opens the page gets the no-access state.
const nav: { key: Section; label: string; href: string; icon: 'link' | 'megaphone' | 'chart' | 'clipboard-list'; admins?: boolean }[] = [
  { key: 'links', label: 'Links', href: '/dashboard/', icon: 'link' },
  { key: 'campaigns', label: 'Campaigns', href: '/dashboard/campaigns/', icon: 'megaphone' },
  { key: 'analytics', label: 'Analytics', href: '/dashboard/analytics/', icon: 'chart' },
  { key: 'waitlist', label: 'Waitlist', href: '/dashboard/waitlist/', icon: 'clipboard-list', admins: true },
];
const maxWidth = { default: 'max-w-6xl', narrow: 'max-w-3xl', wide: 'max-w-7xl' }[width];
---

<BaseLayout title={title} protected>
  <a href="#main" class="sr-only z-50 rounded-md bg-ink-950 px-3 py-2 text-sm font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Skip to content</a>

  <header class="sticky top-0 z-30 border-b border-line bg-white/85 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-6xl items-center gap-2 px-4 sm:px-6">
      <Logo href="/dashboard/" height={30} class="mr-4 rounded-md" />

      <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
        {
          nav.map((item) => (
            <a href={item.href} class="nav-link" aria-current={section === item.key ? 'page' : undefined} hidden={item.admins} data-nav-admins={item.admins}>
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="ml-auto flex items-center gap-2">
        <!-- mr-3: 20 px between New link and the avatar (the row's gap is 8), so neither is pressed by mistake -->
        <a href="/dashboard/create/" class="btn btn-primary btn-sm mr-3 hidden sm:inline-flex" data-tooltip="Shortcut: N" data-tooltip-align="end" data-new-link>
          <Icon name="plus" />New link
        </a>
        <a href="/dashboard/create/" class="btn btn-primary btn-sm btn-icon mr-3 sm:hidden" aria-label="New link" data-new-link>
          <Icon name="plus" />
        </a>

        <!-- Phase 10.2: a dot on the avatar when service tokens need attention (owners and admins); its words are in the label -->
        <span class="relative grid">
          <button
            type="button"
            class="grid size-9 place-items-center rounded-full bg-ink-950 text-sm font-semibold text-brand-300 ring-offset-2 transition hover:ring-2 hover:ring-ink-200"
            popovertarget="user-menu"
            aria-label="Account menu"
            data-user-initial
            data-user-menu-button
          >
            <span class="size-2 rounded-full bg-brand-400" aria-hidden="true"></span>
          </button>
          <span class="pointer-events-none absolute -top-0.5 -right-0.5 size-3 rounded-full bg-amber-500 ring-2 ring-white" aria-hidden="true" hidden data-attention-dot></span>
        </span>
        <div id="user-menu" popover class="menu w-64" data-align="end">
          <div class="px-2.5 pt-1.5 pb-2.5">
            <p class="text-xs text-ink-500">Signed in as</p>
            <p class="truncate text-sm font-semibold text-ink-950" data-user-email>…</p>
            <span class="badge badge-brand mt-2"><span class="status-dot text-brand-600"></span>Early access</span>
          </div>
          <!-- Phase 3.14.4, 3.14.7: the organization, with its logo, a link to its page; not there for an account outside one -->
          <div data-user-org hidden>
            <div class="menu-sep"></div>
            <a class="menu-item h-auto py-2" href="/dashboard/organization/" aria-current={section === 'organization' ? 'page' : undefined}>
              <OrgMark class="size-8 text-sm" />
              <span class="grid min-w-0">
                <span class="text-xs font-normal text-ink-500">Organization</span>
                <span class="truncate text-sm font-semibold text-ink-950" data-user-org-name></span>
                <span class="flex items-center gap-1.5 text-xs font-normal text-amber-800" hidden data-attention-text>
                  <span class="status-dot text-amber-500" aria-hidden="true"></span><span data-attention-label></span>
                </span>
              </span>
            </a>
          </div>
          <div class="menu-sep"></div>
          <a class="menu-item" href="/dashboard/settings/"><Icon name="settings" />Settings</a>
          <a class="menu-item" href="/dashboard/settings/#tags"><Icon name="tags" />Manage tags</a>
          <a class="menu-item" href="/dashboard/settings/#api"><Icon name="key" />API &amp; MCP</a>
          <a class="menu-item" href="/manual/"><Icon name="book-open" />Help</a>
          <a class="menu-item" href={feedback}><Icon name="mail" />Send feedback</a>
          <div class="menu-sep"></div>
          <button type="button" class="menu-item" data-logout><Icon name="log-out" />Log out</button>
        </div>

        <button type="button" class="btn btn-ghost btn-sm btn-icon md:hidden" data-dialog-open="mobile-nav" aria-label="Open menu">
          <Icon name="menu" class="size-5" />
        </button>
      </div>
    </div>
  </header>

  <dialog id="mobile-nav" class="modal" aria-label="Menu">
    <div class="modal-panel p-3" style="--modal-width: 22rem">
      <div class="flex items-center justify-between px-2 pt-1 pb-3">
        <Logo height={28} />
        <button type="button" class="btn btn-ghost btn-sm btn-icon" data-dialog-close aria-label="Close menu"><Icon name="x" /></button>
      </div>
      <nav aria-label="Mobile" class="grid gap-1">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={['menu-item h-11 text-base', section === item.key && 'bg-ink-100 text-ink-950']}
              aria-current={section === item.key ? 'page' : undefined}
              hidden={item.admins}
              data-nav-admins={item.admins}
            >
              <Icon name={item.icon} />
              {item.label}
            </a>
          ))
        }
        <a href="/dashboard/settings/" class:list={['menu-item h-11 text-base', section === 'settings' && 'bg-ink-100 text-ink-950']}>
          <Icon name="settings" />Settings
        </a>
        <a href="/manual/" class="menu-item h-11 text-base"><Icon name="book-open" />Help</a>
        <a href={feedback} class="menu-item h-11 text-base"><Icon name="mail" />Send feedback</a>
        <div class="menu-sep"></div>
        <button type="button" class="menu-item h-11 text-base" data-logout><Icon name="log-out" />Log out</button>
      </nav>
    </div>
  </dialog>

  <main id="main" class:list={['mx-auto px-4 pt-8 pb-20 sm:px-6', maxWidth]}>
    <slot />
  </main>
</BaseLayout>

<script>
  import { logout } from '@/utils/auth';
  import { avatarUrl } from '@/utils/avatar';
  import { paintOrgMark, type Marked } from '@/utils/org-logo';
  import { attentionLabel } from '@/utils/service-accounts';
  import { getMe, getMyOrganization, initialOf } from '@/utils/viewer';
  import type { Organization, User } from '@/utils/types';

  const CACHE_KEY = 'shurly_me';
  const ORG_CACHE_KEY = 'shurly_org';

  /**
   * The organization as the header shows it, and keeps it in sessionStorage: its role shows the admins' links, and
   * `attention` (Phase 10.2, owners and admins) how many service tokens need it: the avatar's dot.
   */
  type ShownOrg = Marked & { role?: Organization['role'] | null; attention?: number | null };

  /** What the header shows, and all it keeps in sessionStorage. */
  interface Shown {
    email: string;
    first_name?: string | null;
    avatar_version?: string | null;
  }

  let painting = 0;
  function paint(user: Shown) {
    const run = ++painting;
    document.querySelectorAll('[data-user-email]').forEach((el) => (el.textContent = user.email));
    document.querySelectorAll<HTMLElement>('[data-user-initial]').forEach((el) => {
      el.textContent = initialOf(user.email, user.first_name);
      el.title = user.email;
    });
    // Phase 3.12 — the photo replaces the initial once it's loaded (from the browser's cache
    // after the first time: its URL has the version). No photo, or one that fails: the initial.
    void avatarUrl(user.avatar_version).then((url) => {
      if (!url || run !== painting) return;
      document.querySelectorAll<HTMLElement>('[data-user-initial]').forEach((el) => {
        const photo = document.createElement('img');
        photo.src = url;
        photo.alt = '';
        photo.className = 'size-full rounded-full object-cover';
        el.replaceChildren(photo);
      });
    });
  }

  const cached = sessionStorage.getItem(CACHE_KEY);
  if (cached) {
    try {
      paint(JSON.parse(cached));
    } catch {
      sessionStorage.removeItem(CACHE_KEY);
    }
  }
  function remember(user: User) {
    const shown: Shown = {
      email: user.email,
      first_name: user.profile?.first_name ?? null,
      avatar_version: user.profile?.avatar_version ?? null,
    };
    sessionStorage.setItem(CACHE_KEY, JSON.stringify(shown));
    paint(shown);
  }

  // Shared with the page's own scripts, so /auth/me is fetched once per page.
  getMe()
    .then(remember)
    .catch(() => {
      /* 401 is handled by the API client; other errors leave the cached name */
    });
  // Phase 3.12 — the account was read again (refreshMe), e.g. after the profile was saved.
  window.addEventListener('shurly:me', (e) => remember((e as CustomEvent<User>).detail));

  // Phase 3.14.4 — the organization in the account menu: its name, and its logo once loaded
  // (from the browser's cache after the first time: its URL has the version), else the initial.
  const orgRow = document.querySelector<HTMLElement>('[data-user-org]')!;
  const menuButton = document.querySelector<HTMLElement>('[data-user-menu-button]')!;
  /** Phase 10.2 — the dot, on the avatar and the organization row: from the organization the header loads anyway. */
  function paintAttention(count: number) {
    const label = count > 0 ? attentionLabel(count) : '';
    document.querySelector<HTMLElement>('[data-attention-dot]')!.hidden = !label;
    menuButton.setAttribute('aria-label', label ? `Account menu, ${label}` : 'Account menu');
    orgRow.querySelector<HTMLElement>('[data-attention-text]')!.hidden = !label;
    orgRow.querySelector<HTMLElement>('[data-attention-label]')!.textContent = label;
  }
  function paintOrg(org: ShownOrg | null) {
    const admin = org?.role === 'owner' || org?.role === 'admin';
    document.querySelectorAll<HTMLElement>('[data-nav-admins]').forEach((el) => (el.hidden = !admin));
    paintAttention(admin ? (org?.attention ?? 0) : 0);
    orgRow.hidden = !org;
    if (!org) return;
    orgRow.querySelector<HTMLElement>('[data-user-org-name]')!.textContent = org.name;
    void paintOrgMark(orgRow.querySelector<HTMLElement>('[data-org-mark]')!, org);
  }
  function rememberOrg(org: Organization | null) {
    const shown: ShownOrg | null = org && { name: org.name, logo_version: org.logo_version ?? null, role: org.role, attention: org.service_accounts_attention ?? null };
    if (shown) sessionStorage.setItem(ORG_CACHE_KEY, JSON.stringify(shown));
    else sessionStorage.removeItem(ORG_CACHE_KEY);
    paintOrg(shown);
  }
  const cachedOrg = sessionStorage.getItem(ORG_CACHE_KEY);
  if (cachedOrg) {
    try {
      paintOrg(JSON.parse(cachedOrg));
    } catch {
      sessionStorage.removeItem(ORG_CACHE_KEY);
    }
  }
  getMyOrganization()
    .then(rememberOrg)
    .catch(() => {
      /* the cached one stays */
    });
  // Its logo changed, on the Organization page.
  window.addEventListener('shurly:organization', (e) => rememberOrg((e as CustomEvent<Organization>).detail));

  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-logout]')) {
      sessionStorage.removeItem(CACHE_KEY);
      sessionStorage.removeItem(ORG_CACHE_KEY);
      logout();
    }
  });

  // Keyboard shortcuts: N → new link, / → focus the page's search box.
  document.addEventListener('keydown', (e) => {
    if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey) return;
    const el = e.target as HTMLElement;
    if (el.closest('input, textarea, select, [contenteditable="true"], dialog[open]')) return;
    if (e.key === 'n' || e.key === 'N') {
      e.preventDefault();
      window.location.href = '/dashboard/create/';
    } else if (e.key === '/') {
      const search = document.querySelector<HTMLInputElement>('[data-search]');
      if (search) {
        e.preventDefault();
        search.focus();
        search.select();
      }
    }
  });
</script>
