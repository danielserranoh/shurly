---
import BaseLayout from './BaseLayout.astro';
import Logo from '@/components/brand/Logo.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title} guestOnly bodyClass="bg-white">
  <div class="grid min-h-dvh grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
    <div class="flex flex-col px-6 py-6 sm:px-10">
      <Logo href="/" height={32} class="self-start rounded-md" />
      <main id="main" class="mx-auto flex w-full max-w-sm flex-1 flex-col justify-center py-12">
        <slot />
      </main>
      <p class="text-center text-xs text-ink-500 lg:text-left">© {new Date().getFullYear()} Griddo · Visitor IPs are anonymized before they’re stored.</p>
    </div>

    <aside class="relative hidden overflow-hidden bg-ink-950 lg:block" aria-hidden="true">
      <div class="bg-dots-dark absolute inset-0 opacity-70"></div>
      <div class="absolute -right-40 -bottom-40 size-[40rem] rounded-full bg-[radial-gradient(closest-side,rgb(80_87_255/0.38),transparent)]"></div>
      <div class="relative flex h-full flex-col justify-center px-14 xl:px-20">
        <p class="display max-w-md text-5xl text-white">Send the link.<br /><span class="text-brand-400">Know who opened&nbsp;it.</span></p>
        <div class="mt-12 max-w-md rounded-2xl bg-white/[0.04] p-5 ring-1 ring-white/10 backdrop-blur">
          <p class="eyebrow text-brand-300">Today</p>
          <ul class="mt-4 grid gap-4 text-sm text-ink-200">
            <li class="flex items-center gap-3">
              <span class="relative flex size-2.5"><span class="absolute inline-flex size-full animate-ping-dot rounded-full bg-brand-400"></span><span class="relative size-2.5 rounded-full bg-brand-400"></span></span>
              <span class="flex-1"><b class="font-semibold text-white">Acme Corp</b> opened “Q4 proposal”</span>
              <span class="text-ink-500">now</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="size-2.5 rounded-full bg-ink-600"></span>
              <span class="flex-1"><b class="font-semibold text-white">Northwind</b> opened “Pricing deck”</span>
              <span class="text-ink-500">1h</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="size-2.5 rounded-full bg-ink-600"></span>
              <span class="flex-1"><b class="font-semibold text-white">12 recipients</b> clicked “Spring launch”</span>
              <span class="text-ink-500">3h</span>
            </li>
          </ul>
        </div>
        <p class="mt-8 flex items-center gap-2 text-sm text-ink-400"><Icon name="shield" class="size-4 text-brand-300" />Bots and link previews are filtered out, so every click is a person.</p>
      </div>
    </aside>
  </div>
</BaseLayout>
