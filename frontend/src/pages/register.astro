---
import AuthLayout from '@/layouts/AuthLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import PasswordField from '@/components/ui/PasswordField.astro';
---

<AuthLayout title="Create your account">
  <h1 class="display text-[2rem] text-ink-950">Create your account</h1>
  <p class="mt-2 text-[15px] text-ink-500">Free for small teams. No credit card, no setup.</p>

  <form id="register-form" class="mt-8 grid gap-5" novalidate>
    <div data-form-alert hidden></div>

    <div class="grid gap-1.5">
      <label for="email" class="label">Work email</label>
      <input id="email" name="email" type="email" class="input input-lg" autocomplete="email" inputmode="email" placeholder="you@company.com" required aria-describedby="email-error" autofocus />
      <p id="email-error" class="field-error" data-error-for="email" hidden></p>
    </div>

    <PasswordField id="password" label="Password" autocomplete="new-password" minlength={8} hint="At least 8 characters" />

    <button type="submit" class="btn btn-primary btn-lg mt-1 w-full">Create account<Icon name="arrow-right" /></button>
  </form>

  <p class="mt-8 text-center text-sm text-ink-500">
    Already have an account? <a href="/login/" class="link">Log in</a>
  </p>
</AuthLayout>

<script>
  import { apiPost, ApiError } from '@/utils/api';
  import { setToken } from '@/utils/auth';
  import { applyApiError, clearErrors, isEmail, setFieldError } from '@/utils/forms';
  import { iconSvg } from '@/utils/icons';
  import { setLoading } from '@/utils/ui';
  import type { LoginResponse, User } from '@/utils/types';

  const form = document.getElementById('register-form') as HTMLFormElement;
  const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const passwordInput = form.elements.namedItem('password') as HTMLInputElement;
  const hint = form.querySelector<HTMLElement>('[data-password-hint]')!;

  // Live length check: the hint earns a lime check once the rule is met.
  const renderHint = () => {
    const ok = passwordInput.value.length >= 8;
    hint.innerHTML = ok
      ? `<span class="grid size-4 place-items-center rounded-full bg-brand-400 text-ink-950">${iconSvg('check', 'size-3', 3)}</span><span class="text-ink-700">At least 8 characters</span>`
      : `<span class="size-4 rounded-full border-2 border-ink-300"></span><span>At least 8 characters</span>`;
  };
  renderHint();
  passwordInput.addEventListener('input', renderHint);

  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.getAttribute('aria-invalid')) setFieldError(form, t.name, null);
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors(form);
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const password = passwordInput.value;

    let ok = true;
    if (!isEmail(email)) {
      setFieldError(form, 'email', email ? 'That doesn’t look like an email address.' : 'Enter your email.');
      ok = false;
    }
    if (password.length < 8) {
      setFieldError(form, 'password', 'Use at least 8 characters.');
      ok = false;
    }
    if (!ok) {
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      return;
    }

    setLoading(submit, true, 'Creating your account…');
    try {
      await apiPost<User>('/api/v1/auth/register', { email, password }, false);
      const { access_token } = await apiPost<LoginResponse>('/api/v1/auth/login', { email, password }, false);
      setToken(access_token);
      window.location.replace('/dashboard/?welcome=1');
    } catch (err) {
      setLoading(submit, false);
      if (err instanceof ApiError && /already registered/i.test(err.message)) {
        setFieldError(form, 'email', 'There’s already an account with this email.');
        const slot = form.querySelector<HTMLElement>('[data-error-for="email"]')!;
        const a = document.createElement('a');
        a.href = `/login/?email=${encodeURIComponent(email)}`;
        a.className = 'link ml-1';
        a.textContent = 'Log in instead';
        slot.append(a);
        return;
      }
      applyApiError(form, err);
    }
  });
</script>
