---
import AuthLayout from '@/layouts/AuthLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import PasswordField from '@/components/ui/PasswordField.astro';
---

<AuthLayout title="Log in">
  <h1 class="display text-[2rem] text-ink-950">Welcome back</h1>
  <p class="mt-2 text-[15px] text-ink-500">Log in to see who’s been clicking.</p>

  <form id="login-form" class="mt-8 grid gap-5" novalidate>
    <div data-form-alert hidden></div>

    <div class="grid gap-1.5">
      <label for="email" class="label">Work email</label>
      <input id="email" name="email" type="email" class="input input-lg" autocomplete="email" inputmode="email" placeholder="you@company.com" required aria-describedby="email-error" autofocus />
      <p id="email-error" class="field-error" data-error-for="email" hidden></p>
    </div>

    <PasswordField id="password" label="Password" autocomplete="current-password">
      <button slot="label-end" type="button" class="text-sm font-medium text-ink-500 hover:text-ink-950" popovertarget="forgot-popover">Forgot password?</button>
    </PasswordField>

    <div id="forgot-popover" popover class="menu max-w-xs p-4 text-sm leading-6 text-ink-700" data-align="end">
      <p class="font-semibold text-ink-950">Password reset is on its way</p>
      <p class="mt-1">Email resets aren’t live yet. Ask your Shurly admin to set a temporary password, then change it in Settings.</p>
    </div>

    <button type="submit" class="btn btn-primary btn-lg mt-1 w-full">Log in<Icon name="arrow-right" /></button>
  </form>

  <p class="mt-8 text-center text-sm text-ink-500">
    New to Shurly? <a href="/register/" class="link">Create a free account</a>
  </p>
</AuthLayout>

<script>
  import { apiPost } from '@/utils/api';
  import { safeNext, setToken } from '@/utils/auth';
  import { applyApiError, clearErrors, isEmail, setFieldError, showAlert } from '@/utils/forms';
  import { setLoading } from '@/utils/ui';
  import type { LoginResponse } from '@/utils/types';

  const form = document.getElementById('login-form') as HTMLFormElement;
  const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const params = new URLSearchParams(location.search);

  const reason = params.get('reason');
  if (reason === 'expired') showAlert(form, 'Your session expired. Log in again to pick up where you left off.', 'info');
  if (reason === 'signed-out') showAlert(form, 'You’re logged out. See you soon.', 'success');
  const prefill = params.get('email');
  if (prefill) (form.elements.namedItem('email') as HTMLInputElement).value = prefill;

  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.getAttribute('aria-invalid')) setFieldError(form, t.name, null);
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors(form);
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const password = (form.elements.namedItem('password') as HTMLInputElement).value;

    let ok = true;
    if (!isEmail(email)) {
      setFieldError(form, 'email', email ? 'That doesn’t look like an email address.' : 'Enter your email.');
      ok = false;
    }
    if (!password) {
      setFieldError(form, 'password', 'Enter your password.');
      ok = false;
    }
    if (!ok) {
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      return;
    }

    setLoading(submit, true, 'Logging in…');
    try {
      const { access_token } = await apiPost<LoginResponse>('/api/v1/auth/login', { email, password }, false);
      setToken(access_token);
      window.location.replace(safeNext(params.get('next')));
    } catch (err) {
      setLoading(submit, false);
      applyApiError(form, err);
    }
  });
</script>
