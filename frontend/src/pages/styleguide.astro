    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-8 text-sm text-ink-600 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <Logo variant="isotype" height={20} />
        <span>Tokens live in <Code>src/styles/global.css</Code>, components in <Code>src/components/ui/</Code>.</span>
      </p>
      <a href="#top" class="link self-start sm:self-auto">Back to top</a>
    </div>
  </footer>

  <Modal id="sg-modal" title="Add tags" description="Tags are added to every selected link. Existing tags stay." width="30rem">
    <div class="grid gap-2 px-6 py-5">
      <span class="label" id="sg-modal-tags-label">Tags to add</span>
      <div class="flex min-h-10 flex-wrap items-center gap-1.5 rounded-[var(--radius-lg)] border border-ink-200 bg-white px-2 py-1.5 shadow-xs focus-within:border-ink-950 focus-within:shadow-[0_0_0_1px_var(--color-ink-950),0_0_0_5px_var(--color-brand-200)]" data-sg-removable>
        <Fragment set:html={pill('email', 'blue-500', { removable: true })} />
        <Fragment set:html={pill('q4-launch', 'gray-500', { removable: true })} />
        <input type="text" class="h-7 min-w-32 flex-1 bg-transparent px-1 text-sm text-ink-900 outline-none placeholder:text-ink-500" placeholder="Add tags…" aria-labelledby="sg-modal-tags-label" data-autofocus />
      </div>
      <p class="hint">Press Enter to add a tag. Tags are lowercase.</p>
    </div>
    <div class="flex flex-col-reverse gap-2 border-t border-line px-6 py-4 sm:flex-row sm:justify-end">
      <button type="button" class="btn btn-secondary" data-dialog-close>Cancel</button>
      <button type="button" class="btn btn-primary" data-sg-modal-apply>Add tags</button>
    </div>
  </Modal>
</BaseLayout>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }
  /* Motion demo lanes: the dot travels when its group gets [data-playing]. */
  .sg-lane-dot {
    left: 0.25rem;
  }
  [data-playing] .sg-lane-dot {
    left: calc(100% - 1.25rem);
  }
</style>

<script>
  import { barList, bindChartTableToggle, columnChart, dataTable, meter, sparkline, type ColumnDatum } from '@/utils/charts';
  import { html, setHTML } from '@/utils/html';
  import { renderLinkCard, renderLinkSkeleton } from '@/utils/links';
  import { closeDialog, confirmDialog, hydrateTimes, setLoading, toast } from '@/utils/ui';
  import type { ShortLink, Tag } from '@/utils/types';

  const $ = <T extends HTMLElement = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel);
  const $$ = <T extends HTMLElement = HTMLElement>(sel: string, root: ParentNode = document) => Array.from(root.querySelectorAll<T>(sel));
  const wait = (ms: number) => new Promise<void>((resolve) => window.setTimeout(resolve, ms));

  // ------------------------------------------------------------ Contents: scroll-spy
  const sections = $$('[data-sg-section]');
  const tocLinks = $$<HTMLAnchorElement>('[data-toc-link]');
  let spyQueued = false;
  function spy() {
    spyQueued = false;
    let current: string | undefined;
    for (const s of sections) if (s.getBoundingClientRect().top <= 140) current = s.id;
    if (current && window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) current = sections[sections.length - 1]?.id;
    tocLinks.forEach((a) => (a.dataset.tocLink === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
  }
  window.addEventListener(
    'scroll',
    () => {
      if (spyQueued) return;
      spyQueued = true;
      requestAnimationFrame(spy);
    },
    { passive: true },
  );
  spy();

  const tocMenu = $('#sg-toc-menu');
  tocMenu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) tocMenu.hidePopover();
  });

  // ------------------------------------------------------------ Motion
  $$<HTMLButtonElement>('[data-sg-play]').forEach((btn) =>
    btn.addEventListener('click', () => document.getElementById(btn.dataset.sgPlay ?? '')?.toggleAttribute('data-playing')),
  );
  $$<HTMLButtonElement>('[data-sg-replay]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const el = document.getElementById(btn.dataset.sgReplay ?? '');
      const cls = el?.dataset.sgAnim;
      if (!el || !cls) return;
      el.classList.remove(cls);
      void el.offsetWidth; // restart the animation
      el.classList.add(cls);
    }),
  );
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const paintReduced = () => {
    const el = $('[data-sg-reduced-motion]');
    if (el) el.textContent = reduced.matches ? 'Reduced motion is on here' : 'Full motion on this device';
  };
  paintReduced();
  reduced.addEventListener('change', paintReduced);

  // ------------------------------------------------------------ Toasts, loading, dialogs
  const toasts: Record<string, () => void> = {
    success: () => toast('Link copied'),
    error: () => toast('Couldn’t save the link', 'error', { description: 'Check your connection and try again.' }),
    info: () => toast('This link expires in 3 days', 'info', { description: 'Edit it to pick a later date.' }),
    action: () => toast('Link deleted', 'success', { action: { label: 'Undo', onClick: () => toast('Link restored') } }),
  };
  $$<HTMLButtonElement>('[data-sg-toast]').forEach((btn) => btn.addEventListener('click', () => toasts[btn.dataset.sgToast ?? '']?.()));

  $$<HTMLButtonElement>('[data-sg-loading]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      setLoading(btn, true, btn.dataset.sgLoading);
      await wait(1600);
      setLoading(btn, false);
      toast('Changes saved');
    }),
  );

  const confirmDelete = () =>
    confirmDialog({
      title: 'Delete this link?',
      body: 's.griddo.io/q4-acme will stop working for everyone who has it, and its 128 clicks of history will be deleted. This can’t be undone.',
      confirmLabel: 'Delete link',
      danger: true,
      onConfirm: () => wait(1200),
    });
  $('[data-sg-confirm="danger"]')?.addEventListener('click', async () => {
    if (await confirmDelete()) toast('Link deleted', 'success', { description: 'Just a demo: nothing was deleted.' });
  });
  $('[data-sg-confirm="neutral"]')?.addEventListener('click', async () => {
    const leave = await confirmDialog({ title: 'Leave without saving?', body: 'Your changes to this link will be lost.', confirmLabel: 'Leave', cancelLabel: 'Keep editing' });
    if (leave) toast('Changes discarded', 'info');
  });
  $('[data-sg-modal-apply]')?.addEventListener('click', () => {
    closeDialog(document.getElementById('sg-modal') as HTMLDialogElement | null);
    toast('Tags added', 'success', { description: 'Added to 3 links.' });
  });

  $('#sg-menu')?.addEventListener('click', (e) => {
    const item = (e.target as HTMLElement).closest<HTMLElement>('[data-sg-menu-item]');
    if (!item) return;
    e.preventDefault();
    $('#sg-menu')?.hidePopover();
    toast(`${item.textContent?.trim()}: just a demo`, 'info');
  });

  // ------------------------------------------------------------ Navigation demos
  const navDemo = $('[data-sg-nav]');
  navDemo?.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.nav-link');
    if (!link) return;
    e.preventDefault();
    $$('a.nav-link', navDemo).forEach((a) => (a === link ? a.setAttribute('aria-current', 'page') : a.removeAttribute('aria-current')));
  });

  const tabs = $$<HTMLButtonElement>('[data-sg-tabs] [role="tab"]');
  function selectTab(tab: HTMLButtonElement) {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !on;
    });
    tab.focus();
  }
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => selectTab(tab));
    tab.addEventListener('keydown', (e) => {
      const keys: Record<string, number | undefined> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
      const next = keys[e.key];
      if (next === undefined) return;
      e.preventDefault();
      selectTab(tabs[(next + tabs.length) % tabs.length]);
    });
  });

  // ------------------------------------------------------------ Tags
  $$<HTMLButtonElement>('[data-sg-chips] button.tag').forEach((chip) =>
    chip.addEventListener('click', () => chip.setAttribute('aria-pressed', String(chip.getAttribute('aria-pressed') !== 'true'))),
  );

  function removeTag(handle: HTMLElement) {
    const pill = handle.closest<HTMLElement>('.tag');
    const box = pill?.parentElement;
    if (!pill || !box) return;
    const handles = $$('[data-remove-tag]', box);
    const index = handles.indexOf(handle);
    const next = pill.nextSibling;
    const name = pill.textContent?.trim() ?? 'tag';
    pill.remove();
    const rest = $$('[data-remove-tag]', box);
    (rest[Math.min(index, rest.length - 1)] ?? $('input', box) ?? box).focus();
    toast(`Removed “${name}”`, 'success', {
      action: {
        label: 'Undo',
        onClick: () => (next && next.parentNode === box ? box.insertBefore(pill, next) : box.prepend(pill)),
      },
    });
  }
  $$('[data-sg-removable]').forEach((box) => {
    box.addEventListener('click', (e) => {
      const handle = (e.target as HTMLElement).closest<HTMLElement>('[data-remove-tag]');
      if (handle) removeTag(handle);
    });
    box.addEventListener('keydown', (e) => {
      const handle = (e.target as HTMLElement).closest<HTMLElement>('[data-remove-tag]');
      if (!handle || (e.key !== 'Enter' && e.key !== ' ')) return;
      e.preventDefault();
      removeTag(handle);
    });
  });

  // ------------------------------------------------------------ Cards
  function fillStat(key: string, value: string, hint?: string | ReturnType<typeof html>) {
    const valueEl = $(`[data-stat="${key}"]`);
    const hintEl = $(`[data-stat-hint="${key}"]`);
    if (valueEl) valueEl.textContent = value;
    if (hintEl && hint !== undefined) {
      if (typeof hint === 'string') hintEl.textContent = hint;
      else setHTML(hintEl, hint);
    }
  }
  const week = [12, 18, 9, 27, 21, 34, 16];
  fillStat('sg-total', '1,284', 'Real people — bots excluded');
  fillStat('sg-week', '137', html`<span class="flex items-center justify-between gap-2"><span>Per day</span>${sparkline(week, 72, 20)}</span>`);
  fillStat('sg-weeks', '842', html`<span class="font-medium text-brand-800">+24%</span> this week vs last`);

  const HOUR = 3_600_000;
  const DAY = 24 * HOUR;
  const at = (offset: number) => new Date(Date.now() + offset).toISOString();
  const tag = (name: string, color: string, predefined = true): Tag => ({
    id: `sg-${name}`,
    name,
    display_name: name,
    color,
    is_predefined: predefined,
    usage_count: 4,
    created_at: at(-40 * DAY),
  });
  const blank = {
    og_title: null,
    og_description: null,
    og_image_url: null,
    og_fetched_at: null,
    valid_since: null,
    valid_until: null,
    max_visits: null,
    crawlable: false,
    campaign_id: null,
    user_data: null,
  };
  const demoLinks: ShortLink[] = [
    {
      ...blank,
      id: 'sg-link-1',
      short_code: 'q4-acme',
      short_url: 'https://s.griddo.io/q4-acme',
      original_url: 'https://docs.google.com/presentation/d/1x9QkT7a/edit',
      url_type: 'custom',
      title: 'Q4 proposal — Acme Corp',
      forward_parameters: true,
      tags: [tag('email', 'blue-500'), tag('proposal', 'purple-500'), tag('acme', 'gray-500', false)],
      click_count: 128,
      last_click_at: at(-2 * HOUR),
      created_at: at(-12 * DAY),
      updated_at: at(-DAY),
    },
    {
      ...blank,
      id: 'sg-link-2',
      short_code: 'k3x9pa',
      short_url: 'https://s.griddo.io/k3x9pa',
      original_url: 'https://www.acme.com/catalogue/spring-2026',
      url_type: 'standard',
      title: 'Spring catalogue',
      forward_parameters: false,
      valid_until: at(3 * DAY),
      tags: [tag('social', 'blue-500'), tag('b2b', 'orange-500')],
      click_count: 42,
      last_click_at: at(-DAY),
      created_at: at(-20 * DAY),
      updated_at: at(-3 * DAY),
    },
    {
      ...blank,
      id: 'sg-link-3',
      short_code: 'm2q7zd',
      short_url: 'https://s.griddo.io/m2q7zd',
      original_url: 'https://griddo.io/webinar/growth',
      url_type: 'campaign',
      title: 'Growth webinar — Luis, Northwind',
      forward_parameters: true,
      campaign_id: 'sg-campaign',
      user_data: { firstName: 'Luis', company: 'Northwind' },
      tags: [tag('onboarding', 'pink-500')],
      click_count: 0,
      last_click_at: null,
      created_at: at(-HOUR),
      updated_at: at(-HOUR),
    },
  ];

  const linkList = $('[data-sg-links]');
  if (linkList) {
    setHTML(linkList, html`${demoLinks.map((link) => renderLinkCard(link))}`);
    hydrateTimes(linkList);
    const WHAT: Record<string, string> = { edit: 'opens the editor', qr: 'shows the QR code' };
    linkList.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const action = target.closest<HTMLElement>('[data-action]');
      const anchor = target.closest<HTMLAnchorElement>('a[href]');
      if (!action && !anchor) return;
      e.preventDefault();
      target.closest<HTMLElement>('[popover]')?.hidePopover();
      if (action?.dataset.action === 'delete') {
        const card = action.closest<HTMLElement>('li[data-link]');
        if (card && (await confirmDelete())) {
          const next = card.nextSibling;
          card.remove();
          toast('Link deleted', 'success', { action: { label: 'Undo', onClick: () => linkList.insertBefore(card, next && next.parentNode === linkList ? next : null) } });
        }
        return;
      }
      const what = action ? WHAT[action.dataset.action ?? ''] ?? 'does its thing' : anchor?.target === '_blank' ? 'opens in a new tab' : 'opens the link’s details';
      toast('This card is a demo', 'info', { description: `In the app, this ${what}.` });
    });
  }
  setHTML($('[data-sg-skeleton]'), renderLinkSkeleton(2));

  // ------------------------------------------------------------ Data viz
  const today = new Date();
  const dayRows: ColumnDatum[] = week.map((value, i) => {
    const d = new Date(today);
    d.setDate(today.getDate() - (week.length - 1 - i));
    return {
      label: i === week.length - 1 ? 'Today' : d.toLocaleDateString('en-US', { weekday: 'short' }),
      value,
      title: d.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' }),
    };
  });
  const weekly = [64, 88, 72, 110, 96, 134, 121, 157];
  const weekRows: ColumnDatum[] = weekly.map((value, i) => {
    const d = new Date(today);
    d.setDate(today.getDate() - today.getDay() - 7 * (weekly.length - 1 - i));
    return {
      label: d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
      value,
      title: `Week of ${d.toLocaleDateString('en-US', { month: 'long', day: 'numeric' })}`,
    };
  });

  const chartEl = $('[data-sg-chart]');
  const tableEl = $('[data-sg-chart-table]');
  const chartToggle = $<HTMLButtonElement>('[data-sg-chart-toggle]');
  function drawChart(period: 'daily' | 'weekly') {
    if (!chartEl || !tableEl) return;
    const rows = period === 'daily' ? dayRows : weekRows;
    const total = rows.reduce((sum, r) => sum + r.value, 0);
    const span = period === 'daily' ? 'day, last 7 days' : 'week, last 8 weeks';
    const sub = $('[data-sg-chart-sub]');
    if (sub) sub.textContent = period === 'daily' ? 'Per day, last 7 days' : 'Per week, last 8 weeks';
    columnChart(chartEl, rows, { ariaLabel: `Clicks per ${span}. Total ${total}.`, height: 240 });
    setHTML(tableEl, dataTable(rows.map((r) => ({ label: r.title, value: r.value })), [period === 'daily' ? 'Day' : 'Week', 'Clicks']));
  }
  drawChart('daily');
  $$<HTMLInputElement>('input[name="sg-chart-period"]').forEach((radio) => radio.addEventListener('change', () => drawChart(radio.value as 'daily' | 'weekly')));
  if (chartToggle && chartEl && tableEl) bindChartTableToggle(chartToggle, chartEl, tableEl);

  setHTML(
    $('[data-sg-barlist]'),
    barList([
      { label: 'Spain', value: 412 },
      { label: 'United States', value: 268 },
      { label: 'Mexico', value: 131 },
      { label: 'Germany', value: 64 },
      { label: 'France', value: 38 },
    ]),
  );
  setHTML($('[data-sg-meter]'), meter(34, 50, 'Click-through: 34 of 50 recipients'));
  setHTML($('[data-sg-spark]'), sparkline([6, 9, 7, 12, 10, 15, 13, 18], 120, 36));

  // ------------------------------------------------------------ Icons
  const iconFilter = $<HTMLInputElement>('[data-sg-icon-filter]');
  const iconTiles = $$('[data-icon-name]');
  iconFilter?.addEventListener('input', () => {
    const q = iconFilter.value.trim().toLowerCase();
    let shown = 0;
    iconTiles.forEach((tile) => {
      const hit = !q || (tile.dataset.iconName ?? '').includes(q);
      tile.hidden = !hit;
      if (hit) shown++;
    });
    const count = $('[data-sg-icon-count]');
    if (count) count.textContent = q ? `${shown} of ${iconTiles.length} icons` : `${iconTiles.length} icons`;
    const empty = $('[data-sg-icon-empty]');
    if (empty) empty.hidden = shown > 0;
  });
</script>
