      <!-- 05 Motion ====================================================== -->
      <Section id="motion" index={num('motion')} title="Motion" intro="Quick and snappy, with a little spring where it earns it. Nothing waits on an animation, and everything respects reduced motion.">
        <Specimen title="Easing" description="Two curves. Press play to compare them." code={easeTokens.map((e) => `ease-${e.name}`)} stage="white">
          <div class="grid gap-5 md:grid-cols-2" id="sg-easing">
            {
              easeTokens.map((e) => (
                <div class="rounded-xl border border-line p-4">
                  <div class="flex gap-4">
                    <svg viewBox="-8 -64 116 176" class="h-28 w-20 shrink-0 overflow-visible" aria-hidden="true">
                      <rect x="0" y="0" width="100" height="100" fill="var(--color-ink-50)" stroke="var(--color-ink-200)" stroke-width="1" vector-effect="non-scaling-stroke" />
                      <line x1="0" y1={100} x2={e.h1[0]} y2={e.h1[1]} stroke="var(--color-ink-300)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                      <line x1="100" y1={0} x2={e.h2[0]} y2={e.h2[1]} stroke="var(--color-ink-300)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                      <circle cx={e.h1[0]} cy={e.h1[1]} r="4" fill="#fff" stroke="var(--color-ink-400)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                      <circle cx={e.h2[0]} cy={e.h2[1]} r="4" fill="#fff" stroke="var(--color-ink-400)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                      <path d={e.d} fill="none" stroke="var(--color-ink-950)" stroke-width="2.5" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                      <circle cx="100" cy="0" r="5.5" fill="var(--color-brand-400)" stroke="var(--color-ink-950)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                    </svg>
                    <div class="min-w-0">
                      <p class="font-mono text-sm font-medium text-ink-950">--ease-{e.name}</p>
                      <p class="mt-0.5 font-mono text-[11px] text-ink-500">{e.value}</p>
                      <p class="mt-2 text-sm leading-6 text-ink-600">{EASE_USE[e.name] ?? ''}</p>
                    </div>
                  </div>
                  <div class="relative mt-4 h-6 rounded-full bg-ink-100" aria-hidden="true">
                    <span class="sg-lane-dot absolute top-1 size-4 rounded-full bg-brand-500 ring-2 ring-white" style={`transition: left 700ms ${e.value}`} />
                  </div>
                </div>
              ))
            }
          </div>
          <button type="button" class="btn btn-secondary btn-sm mt-5" data-sg-play="sg-easing"><Icon name="arrow-right" />Play</button>
        </Specimen>

        <Specimen title="Duration" description="Short enough to feel instant, long enough to follow. All on the snappy curve." stage="white">
