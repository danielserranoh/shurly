---
/**
 * Living styleguide: every token, component and pattern in the design system,
 * rendered with the same code the app ships. Tokens are read from global.css at
 * build time (components/styleguide/tokens.ts); demos call the real utils.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/brand/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import StatCard from '@/components/ui/StatCard.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import Modal from '@/components/ui/Modal.astro';
import ProBadge from '@/components/ui/ProBadge.astro';
import PasswordField from '@/components/ui/PasswordField.astro';
import Illustration from '@/components/illustrations/Illustration.astro';
import Section from '@/components/styleguide/Section.astro';
import Specimen from '@/components/styleguide/Specimen.astro';
import Code from '@/components/styleguide/Code.astro';
import DoDont from '@/components/styleguide/DoDont.astro';
import ColorScale from '@/components/styleguide/ColorScale.astro';
import { animations, bodyFeatures, colorScale, contrast, easings, fontFamilies, namedColors, radii, ratio, shadows, WHITE } from '@/components/styleguide/tokens';
import { ICON_NAMES, type IconName } from '@/utils/icons';
import { CATEGORY_LABELS, tagPill } from '@/utils/tags';
import type { ComponentProps } from 'astro/types';

type IllustrationName = ComponentProps<typeof Illustration>['name'];

const sections: { id: string; label: string; short?: string }[] = [
  { id: 'brand', label: 'Brand' },
  { id: 'color', label: 'Color' },
  { id: 'typography', label: 'Typography' },
  { id: 'layout', label: 'Layout' },
  { id: 'motion', label: 'Motion' },
  { id: 'buttons', label: 'Buttons' },
  { id: 'forms', label: 'Forms' },
  { id: 'badges', label: 'Badges & tags' },
  { id: 'cards', label: 'Cards' },
  { id: 'feedback', label: 'Feedback' },
  { id: 'loading', label: 'Loading & empty states', short: 'Loading & empty' },
  { id: 'dataviz', label: 'Data viz' },
  { id: 'illustrations', label: 'Illustrations' },
  { id: 'icons', label: 'Icons' },
  { id: 'voice', label: 'Voice & tone' },
];
const num = (id: string) => sections.findIndex((s) => s.id === id) + 1;
const pad = (i: number) => String(i).padStart(2, '0');

/** Mono caption under an example, on canvas stages (ink-600 keeps 4.5:1 on canvas). */
const cap = 'font-mono text-[11px] leading-4 text-ink-600';
const SHORT = 's.griddo.io';

// ---------------------------------------------------------------- Tokens (from global.css)
const ink = colorScale('ink');
const brand = colorScale('brand');
const surfaces = namedColors(['canvas', 'surface', 'line', 'line-strong']);
const allColors = [...ink, ...brand, ...surfaces];
const hexOf = (name: string) => allColors.find((t) => t.name === name)?.hex ?? '#000000';
const INK_950 = hexOf('ink-950');

const SURFACE_USE: Record<string, { use: string; cls: string }> = {
  canvas: { use: 'App background, stages', cls: 'bg-canvas' },
  surface: { use: 'Cards, inputs, menus, dialogs', cls: 'bg-surface' },
  line: { use: 'Card borders, dividers, table rules', cls: 'border-line' },
  'line-strong': { use: 'Hover borders, dashed placeholders', cls: 'border-line-strong' },
};

const textSamples = [
  { token: 'ink-950', cls: 'text-ink-950', use: 'Headings and primary text' },
  { token: 'ink-700', cls: 'text-ink-700', use: 'Body copy' },
  { token: 'ink-500', cls: 'text-ink-500', use: 'Secondary text and hints. The lightest ink for text.' },
  { token: 'ink-400', cls: 'text-ink-400', use: 'Too light for text. Icons and decoration only.' },
  { token: 'brand-700', cls: 'text-brand-700', use: 'Dark brand text, for small sizes and dense UI.' },
  { token: 'brand-400', cls: 'text-brand-400', use: 'Brand text and links on light surfaces. On ink, use brand-300.' },
].map((s) => ({ ...s, ratio: ratio(hexOf(s.token), WHITE), ok: contrast(hexOf(s.token), WHITE) >= 4.5 }));

const statuses: { name: string; badge: string; icon: IconName; label: string; alert: string; iconCls: string; message: string; tokens: string; use: string }[] = [
  { name: 'Success', badge: 'badge-brand', icon: 'circle-check', label: 'Link created', alert: 'border-brand-200 bg-brand-50 text-brand-900', iconCls: 'text-brand-700', message: 'Your link is ready.', tokens: 'brand-50 · 200 · 900', use: 'Saved, created, live.' },
  { name: 'Info', badge: 'badge-info', icon: 'info', label: 'Scheduled', alert: 'border-sky-200 bg-sky-50 text-sky-900', iconCls: 'text-sky-700', message: 'This link goes live on Oct 1.', tokens: 'sky-50 · 200 · 800', use: 'Scheduled, campaign, neutral news.' },
  { name: 'Warning', badge: 'badge-warn', icon: 'warning', label: 'Expires soon', alert: 'border-amber-200 bg-amber-50 text-amber-900', iconCls: 'text-amber-700', message: 'This link expires in 3 days.', tokens: 'amber-50 · 200 · 800', use: 'Needs attention soon.' },
  { name: 'Danger', badge: 'badge-danger', icon: 'circle-alert', label: 'Expired', alert: 'border-red-200 bg-red-50 text-red-800', iconCls: 'text-red-600', message: 'This link expired on Sep 20.', tokens: 'red-50 · 200 · 700', use: 'Errors, stopped links, destructive actions.' },
];

// ---------------------------------------------------------------- Brand
const WORDMARK_RATIO = 3069 / 904; // wordmark.svg viewBox
const DOT_RATIO = 176 / 904; // the dot's diameter relative to the wordmark's height
const wordmarkWidth = (h: number) => Math.round(h * WORDMARK_RATIO);
const clearH = 60;
const clearX = Math.round(clearH * DOT_RATIO * 10) / 10;
/** Dot centre inside wordmark*.svg, as a % of the image box. */
const dotStyle = (scale = 1) => `left:97.13%;top:71.24%;width:${(5.735 * scale).toFixed(2)}%`;

const logoTiles = [
  { title: 'Primary', body: 'Ink and Griddo blue, on white and light surfaces.', file: 'wordmark.svg', code: '<Logo />', stage: 'bg-white', src: '/brand/wordmark.svg' },
  { title: 'Reversed', body: 'White and Griddo blue, on ink and dark photos.', file: 'wordmark-reversed.svg', code: '<Logo tone="reversed" />', stage: 'bg-ink-950', src: '/brand/wordmark-reversed.svg' },
  { title: 'Mono ink', body: 'On light tints, and for one-color print.', file: 'wordmark-mono-ink.svg', code: '<Logo tone="mono" />', stage: 'bg-brand-100', src: '/brand/wordmark-mono-ink.svg' },
  { title: 'Mono white', body: 'On brand blue, busy or colored backgrounds.', file: 'wordmark-mono-white.svg', code: '<img>', stage: 'bg-[linear-gradient(135deg,#022958_0%,#2a476e_55%,#5057ff_100%)]', src: '/brand/wordmark-mono-white.svg' },
];

// ---------------------------------------------------------------- Typography
const fonts = fontFamilies();
const features = bodyFeatures();
const families = [
  {
    role: 'Display',
    name: fonts.display ?? 'Logical',
    aa: 'display',
    sample: 'Send the link.',
    sampleCls: 'display text-[1.75rem]',
    use: 'Griddo’s typeface. Page titles, marketing headlines, empty-state titles. Weight 500, tracked −0.03em. Falls back to Figtree until its web font is added.',
    code: ['.display', 'font-display'],
  },
  {
    role: 'Interface',
    name: fonts.sans ?? 'Figtree',
    aa: 'font-semibold',
    sample: 'Know who opened it.',
    sampleCls: 'text-2xl font-semibold tracking-tight',
    use: 'Everything you read and click, numbers and stat values included. Weights 400–600, tabular figures in tables.',
    code: ['font-sans', ...features],
  },
  {
    role: 'Short links',
    name: fonts.mono ?? 'JetBrains Mono',
    aa: 'shortlink',
    sample: `${SHORT}/q4-acme`,
    sampleCls: 'shortlink text-xl',
    use: 'Short links, back-halves, codes and snippets. Weight 500, tracked −0.01em.',
    code: ['.shortlink', 'font-mono'],
  },
  {
    role: 'Notes',
    name: fonts.hand ?? 'Shadows Into Light Two',
    aa: 'font-hand',
    sample: 'Why Shurly',
    sampleCls: 'font-hand text-3xl text-brand-400',
    use: 'Eyebrows only: the handwritten note above a heading. Always uppercase, 14px, tracked 0.05em, brand blue (brand-300 on ink). One weight (400).',
    code: ['.eyebrow', 'font-hand'],
  },
];

const displayScale = [
  { px: 60, cls: 'text-6xl', sample: 'Surely, by design.', use: 'Marketing hero' },
  { px: 48, cls: 'text-5xl', sample: 'Paste. Share. Know.', use: 'Marketing section titles' },
  { px: 36, cls: 'text-4xl', sample: 'This page took a wrong turn.', use: 'Section titles, error pages' },
  { px: 30, cls: 'text-3xl', sample: 'Your links', use: 'App page titles (PageHeader)' },
];
const uiScale = [
  { px: 16, cls: 'text-base font-semibold', sample: 'Social preview', use: 'Card and dialog titles' },
  { px: 15, cls: 'text-[15px] leading-7', sample: 'Every short link you’ve made — and who’s clicking.', use: 'Page descriptions, marketing body' },
  { px: 14, cls: 'text-sm', sample: 'Forward query parameters', use: 'Default UI: buttons, inputs, menus, tables' },
  { px: 13, cls: 'text-[13px]', sample: 'Created Sep 12 · Updated 2h ago', use: 'Meta rows, small buttons' },
  { px: 12, cls: 'text-xs', sample: '3–20 letters, numbers, hyphens or underscores.', use: 'Hints, badges, errors' },
];
const weights = [
  { w: '400', cls: 'font-normal', name: 'Regular', use: 'Body text' },
  { w: '500', cls: 'font-medium', name: 'Medium', use: 'Links, menu items' },
  { w: '550', cls: 'font-[550]', name: 'Label', use: 'Labels, badges, tabs' },
  { w: '600', cls: 'font-semibold', name: 'Semibold', use: 'Titles, buttons, values' },
];
const figures = ['1,111', '8,088', '404', '12,907'];

// ---------------------------------------------------------------- Layout
const spacing = [
  { t: '1', px: 4, use: 'Icon to label in badges and tags' },
  { t: '2', px: 8, use: 'Between buttons, icon to label' },
  { t: '3', px: 12, use: 'Toolbars, list rows' },
  { t: '4', px: 16, use: 'Mobile page gutter, compact cards' },
  { t: '6', px: 24, use: 'Card padding, gap between cards' },
  { t: '8', px: 32, use: 'Page top, between groups' },
  { t: '12', px: 48, use: 'Between page sections' },
  { t: '16', px: 64, use: 'App header height' },
];
const RADIUS_CLS: Record<string, string> = { sm: 'rounded-sm', md: 'rounded-md', lg: 'rounded-lg', xl: 'rounded-xl', '2xl': 'rounded-2xl', '3xl': 'rounded-3xl' };
const RADIUS_USE: Record<string, string> = {
  sm: 'Tooltips, small insets',
  md: 'Small buttons, menu items, skeletons',
  lg: 'Buttons, inputs, segmented',
  xl: 'Large buttons, menus, toasts',
  '2xl': 'Cards and dialogs',
  '3xl': 'Hero panels, pricing',
};
const radiusTokens = radii();
const SHADOW_CLS: Record<string, string> = { xs: 'shadow-xs', sm: 'shadow-sm', md: 'shadow-md', lg: 'shadow-lg', xl: 'shadow-xl' };
const SHADOW_USE: Record<string, string> = {
  xs: 'Resting: buttons, inputs, cards',
  sm: 'Raised details: switch knob, active segment',
  md: 'Hover: interactive cards',
  lg: 'Floating: menus, toasts',
  xl: 'Overlays: dialogs',
};
const shadowTokens = shadows();
const containers = [
  { name: 'App & marketing content', code: 'max-w-6xl', value: '72rem · 1152px' },
  { name: 'Narrow forms', code: 'max-w-3xl', value: '48rem · 768px' },
  { name: 'Wide pages', code: 'max-w-7xl', value: '80rem · 1280px' },
  { name: 'Page gutters', code: 'px-4 sm:px-6', value: '16px, then 24px' },
  { name: 'App header', code: 'h-16 sticky', value: '64px, white at 85% + blur' },
  { name: 'Dialogs', code: '--modal-width', value: '34rem; a bottom sheet under 640px' },
  { name: 'Breakpoints', code: 'sm md lg xl', value: '640 · 768 · 1024 · 1280' },
];

// ---------------------------------------------------------------- Motion
const EASE_USE: Record<string, string> = {
  snappy: 'The default: a quick start and a soft landing. Buttons, dialogs, toasts, cards.',
  spring: 'A little overshoot for delight. The switch knob, the check that pops in.',
};
const easeTokens = easings().map((e) => {
  const [x1, y1, x2, y2] = e.points;
  const X = (v: number) => +(v * 100).toFixed(1);
  const Y = (v: number) => +(100 - v * 100).toFixed(1);
  return { ...e, d: `M0,100 C${X(x1)},${Y(y1)} ${X(x2)},${Y(y2)} 100,0`, h1: [X(x1), Y(y1)], h2: [X(x2), Y(y2)] };
});
const durations = [
  { ms: 120, name: 'Micro', use: 'Tooltips, row hovers, chart highlights' },
  { ms: 200, name: 'Standard', use: 'Buttons, switches, dialogs (180–200ms)' },
  { ms: 360, name: 'Entrance', use: 'Toasts and fade-ups (320–360ms)' },
];
const snappy = easeTokens.find((e) => e.name === 'snappy')?.value ?? 'ease-out';
const anim = Object.fromEntries(animations().map((a) => [a.name, a.value.replace(/^[\w-]+\s+/, '')]));

// ---------------------------------------------------------------- Buttons
const buttonVariants: { cls: string; name: string; use: string; icon: IconName; label: string }[] = [
  { cls: 'btn-primary', name: 'Primary', use: 'The main action on a screen. Ink, not blue.', icon: 'plus', label: 'New link' },
  { cls: 'btn-accent', name: 'Accent', use: 'Brand moments: Copy, and one hero call to action.', icon: 'copy', label: 'Copy' },
  { cls: 'btn-secondary', name: 'Secondary', use: 'Everything else.', icon: 'pencil', label: 'Edit' },
  { cls: 'btn-ghost', name: 'Ghost', use: 'Toolbars, dismiss, low emphasis.', icon: 'list', label: 'Table' },
  { cls: 'btn-danger', name: 'Danger', use: 'Confirming a destructive action.', icon: 'trash', label: 'Delete link' },
  { cls: 'btn-danger-ghost', name: 'Danger ghost', use: 'Destructive actions in lists.', icon: 'trash', label: 'Delete' },
];
const buttonSizes = [
  { cls: 'btn-sm', name: 'Small', px: 32 },
  { cls: '', name: 'Default', px: 40 },
  { cls: 'btn-lg', name: 'Large', px: 48 },
];

// ---------------------------------------------------------------- Badges & tags
const badges: { cls: string; label: string; icon?: IconName; dot?: string; use: string }[] = [
  { cls: 'badge-neutral', label: 'No param forwarding', icon: 'ban', use: 'Neutral facts' },
  { cls: 'badge-outline', label: 'Custom', icon: 'pencil', use: 'Link type' },
  { cls: 'badge-brand', label: 'Early access', dot: 'text-brand-600', use: 'Positive, live' },
  { cls: 'badge-info', label: 'Scheduled', icon: 'calendar-clock', use: 'Informational' },
  { cls: 'badge-warn', label: 'Expires soon', icon: 'timer', use: 'Needs attention' },
  { cls: 'badge-danger', label: 'Expired', icon: 'ban', use: 'Stopped working' },
  { cls: 'badge-dark', label: 'New', use: 'Announcements' },
];
const pill = (name: string, color: string, opts: Parameters<typeof tagPill>[1] = {}) => tagPill({ id: `sg-${name}`, display_name: name, color }, opts).value;
const tagFamilies = [
  { family: 'blue', color: 'blue-500', names: ['email', 'social'] },
  { family: 'green', color: 'green-500', names: ['conversion'] },
  { family: 'purple', color: 'purple-500', names: ['landing-page'] },
  { family: 'orange', color: 'orange-500', names: ['b2b'] },
  { family: 'pink', color: 'pink-500', names: ['onboarding'] },
  { family: 'red', color: 'red-500', names: ['urgent'] },
  { family: 'amber', color: 'amber-500', names: ['review'] },
  { family: 'lime', color: 'lime-500', names: ['launch'] },
  { family: 'gray', color: 'gray-500', names: ['q4-launch', 'acme'] },
  { family: 'hex', color: '#e11d48', names: ['vip'] },
].map((f) => ({ ...f, category: CATEGORY_LABELS[f.family] ?? (f.family === 'gray' ? 'Your own tags' : f.family === 'hex' ? 'Custom color' : 'Also supported') }));

// ---------------------------------------------------------------- Illustrations & icons
const illustrations: { name: IllustrationName; use: string }[] = [
  { name: 'links', use: 'No links yet' },
  { name: 'campaigns', use: 'No campaigns yet' },
  { name: 'analytics', use: 'No clicks to chart' },
  { name: 'search', use: 'Nothing matches' },
  { name: 'error', use: 'Couldn’t load' },
  { name: 'not-found', use: '404, missing link' },
  { name: 'success', use: 'Done' },
  { name: 'tags', use: 'No tags yet' },
  { name: 'locked', use: 'Pro, or no access' },
  { name: 'upload', use: 'CSV upload' },
  { name: 'rules', use: 'Smart redirects' },
];
const iconSizes: { cls: string; px: number; use: string; name: IconName }[] = [
  { cls: 'size-3.5', px: 14, use: 'Badges, meta rows', name: 'calendar' },
  { cls: 'size-4', px: 16, use: 'Buttons, menus, inputs (default)', name: 'copy' },
  { cls: 'size-5', px: 20, use: 'Feature tiles, mobile nav', name: 'megaphone' },
];

// ---------------------------------------------------------------- Voice
const principles = [
  { title: 'Say it like a person', body: 'Short sentences, everyday words. Write it the way you’d explain it to a colleague.' },
  { title: 'Sure, not smug', body: 'Say what happened and what’s next. No hype, no blame, no hedging.' },
  { title: 'Link, not URL', body: 'Link, short link, destination, back-half: the words our customers use.' },
  { title: 'Sentence case, no emoji', body: '“Create link”, not “Create Link”. The personality is in the words.' },
];
const words = [
  { say: 'link', not: 'URL', why: 'It’s what people call it.' },
  { say: 'short link', not: 'shortened URL, short URL', why: 'The thing you share.' },
  { say: 'destination', not: 'original URL, target', why: 'Where the link goes.' },
  { say: 'back-half', not: 'slug, short code', why: 'The part after the slash.' },
  { say: 'click', not: 'hit, visit, request', why: 'A real person opened it. Bots are left out.' },
  { say: 'campaign link', not: 'personalized URL', why: 'One per recipient, from a CSV.' },
  { say: 'social preview', not: 'OG metadata', why: 'How the link looks when shared.' },
  { say: 'smart redirects', not: 'redirect rules', why: 'Sending some visitors somewhere else.' },
];

const colorCount = allColors.length;
---

<BaseLayout
  title="Design system"
  description="The Shurly design system: brand, color, type, motion and every UI component, rendered as live code."
  bodyClass="bg-white"
  themeColor="#ffffff"
>
  <a href="#main" class="sr-only z-50 rounded-md bg-ink-950 px-3 py-2 text-sm font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Skip to content</a>

  <!-- Top bar ------------------------------------------------------------->
  <header id="top" class="sticky top-0 z-30 border-b border-line bg-white/85 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:px-6">
      <Logo href="/" height={22} class="rounded-md" />
      <span class="h-5 w-px bg-line-strong" aria-hidden="true"></span>
      <span class="text-sm font-semibold whitespace-nowrap text-ink-950">Design system</span>
      <div class="ml-auto flex items-center gap-2">
        <button type="button" class="btn btn-secondary btn-sm max-sm:w-8 max-sm:px-0 lg:hidden" popovertarget="sg-toc-menu" aria-label="Contents"><Icon name="list" /><span class="hidden sm:inline">Contents</span></button>
        <nav id="sg-toc-menu" popover class="menu max-h-[70dvh] w-64 overflow-y-auto" data-align="end" aria-label="On this page">
          {
            sections.map((s, i) => (
              <a class="menu-item aria-[current=true]:bg-ink-100 aria-[current=true]:text-ink-950" href={`#${s.id}`} data-toc-link={s.id}>
                <span class="w-5 font-mono text-[11px] text-ink-500">{pad(i + 1)}</span>
                {s.short ?? s.label}
              </a>
            ))
          }
        </nav>
        <a href="/" class="btn btn-ghost btn-sm" aria-label="Back to home"><Icon name="arrow-left" /><span class="hidden sm:inline">Back to home</span></a>
      </div>
    </div>
  </header>

  <!-- Hero ----------------------------------------------------------------->
  <div class="relative overflow-hidden bg-ink-950 text-white">
    <div class="bg-dots-dark absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div class="absolute -top-56 right-[-14rem] size-[44rem] rounded-full bg-[radial-gradient(closest-side,rgb(80_87_255/0.36),transparent)]" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 pt-16 pb-14 sm:px-6 sm:pt-20 lg:grid-cols-[1.1fr_0.9fr] lg:pb-20">
      <div class="animate-fade-up">
        <p class="eyebrow text-brand-300">Shurly design system</p>
        <h1 class="display mt-4 text-5xl sm:text-6xl">Surely,<br />by design.</h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-ink-300">
          The tokens, components and rules behind every Shurly screen. Everything here is live code from the app — if it looks right here, it ships right.
        </p>
        <ul class="mt-7 flex flex-wrap gap-2" aria-label="Where it lives">
          <li><Code tone="dark">src/styles/global.css</Code></li>
          <li><Code tone="dark">src/components/ui/</Code></li>
          <li><Code tone="dark">src/utils/</Code></li>
        </ul>
      </div>
      <div class="animate-fade-up [animation-delay:120ms]" aria-hidden="true">
        <div class="rounded-3xl bg-white/[0.04] px-8 py-12 ring-1 ring-white/10 sm:px-12 sm:py-16">
          <div class="relative mx-auto w-fit">
            <img src="/brand/wordmark-reversed.svg" width={wordmarkWidth(80)} height="80" alt="" class="block h-14 w-auto sm:h-20" draggable="false" />
            <span class="absolute aspect-square -translate-x-1/2 -translate-y-1/2 animate-ping-dot rounded-full bg-brand-400" style={dotStyle()}></span>
          </div>
          <p class="mt-10 text-center text-sm text-ink-400">
            <span class="mr-2 inline-block size-2 rounded-full bg-brand-400 align-middle"></span>The dot is the period in “Surely.” — and the click.
          </p>
        </div>
      </div>
    </div>
    <div class="relative border-t border-white/10">
      <dl class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-4 py-7 sm:grid-cols-4 sm:px-6">
        {
          [
            [colorCount, 'Color tokens'],
            [ICON_NAMES.length, 'Icons'],
            [illustrations.length, 'Illustrations'],
            [3, 'Typefaces'],
          ].map(([value, label]) => (
            <div class="flex flex-col-reverse gap-1">
              <dt class="text-sm text-ink-400">{label}</dt>
              <dd class="text-3xl font-semibold tracking-tight">{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:grid lg:grid-cols-[12.5rem_minmax(0,1fr)] lg:gap-12 xl:grid-cols-[14rem_minmax(0,1fr)] xl:gap-16">
    <!-- Table of contents ---------------------------------------------------->
    <nav aria-label="On this page" class="hidden lg:block">
      <div class="sticky top-16 max-h-[calc(100dvh-4rem)] overflow-y-auto pt-14 pb-10">
        <p class="eyebrow px-2.5">On this page</p>
        <ol class="mt-3 grid gap-px">
          {
            sections.map((s, i) => (
              <li>
                <a
                  href={`#${s.id}`}
                  data-toc-link={s.id}
