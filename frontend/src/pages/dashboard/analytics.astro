---
import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import StatCard from '@/components/ui/StatCard.astro';
import Icon from '@/components/ui/Icon.astro';
import ProBadge from '@/components/ui/ProBadge.astro';
import Pager from '@/components/ui/Pager.astro';
---

<AppLayout title="Analytics" section="analytics">
  <PageHeader title="Analytics" description="How your links are doing, across everything you’ve shared." />

  <!-- One filter row, above everything it scopes -->
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
    <div class="segmented scrollbar-none max-w-full self-start overflow-x-auto" role="radiogroup" aria-label="Date range">
      <label><input type="radio" name="range" value="7" checked /><span>Last 7 days</span></label>
      <label data-tooltip="Longer ranges come with Pro"><input type="radio" name="range" value="30" disabled /><span>30 days <Icon name="lock" class="size-3" /></span></label>
      <label data-tooltip="Longer ranges come with Pro"><input type="radio" name="range" value="90" disabled /><span>90 days <Icon name="lock" class="size-3" /></span></label>
      <label data-tooltip="Custom ranges come with Pro"><input type="radio" name="range" value="custom" disabled /><span>Custom <Icon name="lock" class="size-3" /></span></label>
    </div>
    <label class="flex items-center gap-2.5 text-sm text-ink-700">
      <span class="switch"><input type="checkbox" role="switch" data-include-bots /><span></span></span>
      Include bots & crawlers
    </label>
    <button type="button" class="btn btn-secondary btn-sm sm:ml-auto" data-export><Icon name="download" />Export CSV</button>
  </div>

  <div id="analytics" class="transition-opacity duration-200">
    <section aria-label="Summary" class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      <StatCard label="Clicks, last 7 days" stat="recent" icon="activity" accent />
      <StatCard label="Clicks, all time" stat="total" icon="click" />
      <StatCard label="Unique visitors" stat="unique" icon="users" />
      <StatCard label="Links" stat="links" icon="link" />
    </section>

    <section class="card mt-6 p-5 sm:p-6" aria-labelledby="timeline-title">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 id="timeline-title" class="font-semibold text-ink-950">Clicks per day</h2>
          <p class="text-sm text-ink-500">All links and campaigns · last 7 days</p>
        </div>
        <button type="button" class="btn btn-ghost btn-sm" data-table-toggle aria-pressed="false"><Icon name="list" /><span data-label>Table</span></button>
      </div>
      <div class="mt-6" data-chart></div>
      <div class="mt-4 max-h-80 overflow-auto rounded-xl border border-line" data-table hidden></div>
      <p class="hint mt-4" data-days-hint hidden></p>
    </section>

    <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
      <section class="card p-5 sm:p-6" aria-labelledby="top-title">
        <h2 id="top-title" class="font-semibold text-ink-950">Top links</h2>
        <p class="text-sm text-ink-500">Most clicked, all time</p>
        <div class="mt-5" data-top></div>
      </section>

      <section class="card p-5 sm:p-6" aria-labelledby="orphans-title">
        <!-- Its own window: the range row above scopes the summary and the chart, not this list -->
        <div class="flex items-center justify-between gap-3">
          <h2 id="orphans-title" class="font-semibold text-ink-950">Typos & broken links</h2>
          <span class="badge badge-outline shrink-0"><Icon name="calendar" class="size-3.5" />Last 30 days</span>
        </div>
        <p class="text-sm text-ink-500">Short links people tried that don’t exist, often a typo on something printed. The range above doesn’t change this list.</p>
        <ul class="mt-5 grid gap-2" data-orphans></ul>
        <Pager />
      </section>
    </div>

    <section class="mt-6 flex flex-col gap-4 rounded-2xl border border-dashed border-ink-300 bg-white p-5 sm:flex-row sm:items-center">
      <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-ink-950 text-brand-300"><Icon name="line-chart" class="size-5" /></span>
      <!-- Paywall rule 1: what a link's page already has is free, never "coming with Pro" (DESIGN_SYSTEM.md) -->
      <div class="flex-1">
        <p class="font-semibold text-ink-950">Go deeper</p>
        <p class="mt-0.5 text-sm text-ink-500">Each link’s page already has the last 30 or 90 days, dates you pick, and its visits as a CSV. Open one from Top links or <a class="link" href="/dashboard/">Links</a>.</p>
        <p class="mt-2 flex items-baseline gap-2 text-sm text-ink-500"><ProBadge label="Coming soon" class="shrink-0" />{' '}Longer ranges across all your links, and live stats, come with Pro.</p>
      </div>
    </section>
  </div>
</AppLayout>

<script>
  import { apiGet, qs, saveBlob } from '@/utils/api';
  import { barList, bindChartTableToggle, columnChart, dataTable, sparkline } from '@/utils/charts';
  import { todayIn } from '@/utils/days';
  import { toCsv } from '@/utils/csv';
  import { formatDateTime, formatNumber, hostname, pluralize, prettyUrl } from '@/utils/format';
  import { html, setHTML } from '@/utils/html';
  import { icon } from '@/utils/icons';
  import { linkHref } from '@/utils/links';
  import { renderPager } from '@/utils/paging';
  import { hydrateTimes, toast } from '@/utils/ui';
  import { showDaysZoneHint } from '@/utils/viewer';
  import type { OrphanGroupsResponse, OverviewStats } from '@/utils/types';

  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const root = $('#analytics');
  const botsToggle = $<HTMLInputElement>('[data-include-bots]');
  let overview: OverviewStats | null = null;

  function setStat(key: string, value: string, hint?: string | ReturnType<typeof html>) {
    $(`[data-stat="${key}"]`).textContent = value;
    if (hint === undefined) return;
    const el = $(`[data-stat-hint="${key}"]`);
    if (typeof hint === 'string') el.textContent = hint;
    else setHTML(el, hint);
  }

  async function loadOverview() {
    root.classList.add('opacity-60');
    try {
      overview = await apiGet<OverviewStats>(`/api/v1/analytics/overview${botsToggle.checked ? '?include_bots=true' : ''}`);
    } catch (err) {
      toast('Couldn’t load analytics', 'error', { description: err instanceof Error ? err.message : undefined });
      return;
    } finally {
      root.classList.remove('opacity-60');
    }
    const o = overview;
    setStat('recent', formatNumber(o.recent_clicks_7d), html`<span class="flex items-center justify-between gap-2"><span>${botsToggle.checked ? 'Including bots' : 'People only'}</span>${sparkline(o.recent_activity.map((d) => d.clicks), 72, 20)}</span>`);
    setStat('total', formatNumber(o.total_clicks), 'Since you started');
    setStat('unique', formatNumber(o.total_unique_visitors), 'Distinct visitors, all time');
    setStat('links', formatNumber(o.total_urls), html`${pluralize(o.total_campaigns, 'campaign')} · <a class="link" href="/dashboard/">View links</a>`);

    const today = todayIn(o.timezone);
    const rows = o.recent_activity.map((d) => {
      const date = new Date(`${d.date}T12:00:00`);
      return {
        label: d.date === today ? 'Today' : date.toLocaleDateString('en-US', { weekday: 'short' }),
        value: d.clicks,
        title: date.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' }),
      };
    });
    columnChart($('[data-chart]'), rows, { ariaLabel: `Clicks per day across all links, last 7 days. Total ${o.recent_clicks_7d}.`, height: 260 });
    setHTML($('[data-table]'), dataTable(rows.map((r) => ({ label: r.title, value: r.value })), ['Day', 'Clicks']));
    void showDaysZoneHint($('[data-days-hint]'));

    const top = o.top_urls.filter((u) => u.clicks > 0);
    setHTML(
      $('[data-top]'),
      top.length
        ? barList(
            top.map((u) => ({
              label: u.title || hostname(u.original_url) || u.short_code,
              sublabel: prettyUrl(u.short_url) || u.short_code,
              value: u.clicks,
              href: linkHref(u.short_code, u.domain),
            })),
          )
        : html`<p class="rounded-xl bg-ink-50 p-4 text-sm text-ink-500">No clicks yet. Share a link and it’ll show up here.</p>`,
    );
  }

  // "Typos & broken links": the paths tried on unknown codes in the last 30 days, most tried first, a page at
  // a time. "Did you mean" is the API's, against every link you can see (ROADMAP 3.10.4).
  const ORPHAN_DAYS = 30;
  const ORPHAN_PAGE_SIZE = 10;
  const orphanPager = $('#pagination');
  let orphanPage = 1;

  async function loadOrphans() {
    const list = $('[data-orphans]');
    try {
      const res = await apiGet<OrphanGroupsResponse>(
        `/api/v1/analytics/orphan-visits/grouped${qs({ period: ORPHAN_DAYS, page: orphanPage, page_size: ORPHAN_PAGE_SIZE })}`,
      );
      if (!res.groups.length && orphanPage > 1) {
        orphanPage = 1;
        return loadOrphans();
      }
      renderPager(orphanPager, orphanPage, ORPHAN_PAGE_SIZE, res.total_paths, res.groups.length);
      if (!res.groups.length) {
        setHTML(list, html`<li class="flex items-center gap-3 rounded-xl bg-brand-50 p-4 text-sm text-brand-900">${icon('circle-check', 'size-4 text-brand-700')}No broken links. Everyone’s landing where they should.</li>`);
        return;
      }
      setHTML(
        list,
        html`${res.groups.map((g) => {
          const best = g.did_you_mean[0];
          return html`<li class="flex items-center gap-3 rounded-xl border border-line p-3">
            <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-amber-50 text-amber-700">${icon('link-off')}</span>
            <div class="min-w-0 flex-1">
              <p class="shortlink truncate text-sm text-ink-900">${g.attempted_path}</p>
              <p class="truncate text-xs text-ink-500">${best ? html`Did you mean <a class="link" href="${linkHref(best.short_code, best.domain)}" title="${best.short_url}">/${best.short_code}</a>? · ` : ''}last <time data-relative datetime="${g.last_seen}" title="${formatDateTime(g.last_seen)}"></time></p>
            </div>
            <span class="badge badge-warn">${pluralize(g.visits, 'try', 'tries')}</span>
          </li>`;
        })}`,
      );
      hydrateTimes(list);
    } catch {
      orphanPager.hidden = true;
      setHTML(list, html`<li class="rounded-xl bg-ink-50 p-4 text-sm text-ink-500">Couldn’t load broken-link attempts.</li>`);
    }
  }
  orphanPager.querySelector('[data-prev]')!.addEventListener('click', () => {
    orphanPage = Math.max(1, orphanPage - 1);
    loadOrphans();
  });
  orphanPager.querySelector('[data-next]')!.addEventListener('click', () => {
    orphanPage += 1;
    loadOrphans();
  });

  $('[data-export]').addEventListener('click', () => {
    if (!overview) return;
    const o = overview;
    const csv = toCsv([
      ['metric', 'value'],
      ['total_links', o.total_urls],
      ['total_campaigns', o.total_campaigns],
      ['total_clicks', o.total_clicks],
      ['unique_visitors', o.total_unique_visitors],
      ['clicks_last_7_days', o.recent_clicks_7d],
      [],
      ['date', 'clicks'],
      ...o.recent_activity.map((d) => [d.date, d.clicks]),
      [],
      ['short_link', 'title', 'destination', 'clicks'],
      ...o.top_urls.map((u) => [u.short_url ?? u.short_code, u.title ?? '', u.original_url, u.clicks]),
    ]);
    saveBlob(new Blob([csv], { type: 'text/csv' }), `shurly-analytics-${new Date().toISOString().slice(0, 10)}.csv`);
  });
  botsToggle.addEventListener('change', loadOverview);
  bindChartTableToggle($<HTMLButtonElement>('[data-table-toggle]'), $('[data-chart]'), $('[data-table]'));

  loadOverview();
  loadOrphans();
</script>
