---
import AppLayout from '@/layouts/AppLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import StatCard from '@/components/ui/StatCard.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import QrModal from '@/components/app/QrModal.astro';
import AnalyticsSection from '@/components/app/AnalyticsSection.astro';

// Phase 3.17 — the recipients' filter: Clicked is their link, Opened the email's tracking image.
const filters = [
  { value: 'all', label: 'All' },
  { value: 'clicked', label: 'Clicked' },
  { value: 'opened', label: 'Opened' },
  { value: 'none', label: 'Not yet' },
];
---

<AppLayout title="Campaign" section="campaigns">
  <a href="/dashboard/campaigns/" class="mb-4 inline-flex items-center gap-1.5 rounded-md text-sm font-medium text-ink-500 hover:text-ink-950"><Icon name="arrow-left" />Campaigns</a>

  <EmptyState id="not-found" hidden illustration="not-found" title="We couldn’t find that campaign" body="It may have been deleted, or it’s someone else’s personal campaign.">
    <a href="/dashboard/campaigns/" class="btn btn-primary"><Icon name="list" />All campaigns</a>
  </EmptyState>

  <div id="loading" class="grid gap-6" aria-hidden="true">
    <div class="space-y-3"><span class="skeleton block h-8 w-1/3"></span><span class="skeleton block h-4 w-1/2"></span></div>
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">{[1, 2, 3, 4].map(() => <div class="skeleton h-32 rounded-2xl"></div>)}</div>
    <div class="skeleton h-96 rounded-2xl"></div>
  </div>

  <div id="content" hidden>
    <header class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <h1 class="display min-w-0 text-3xl break-words text-ink-950" data-name></h1>
          <span class="flex gap-1.5" data-badges></span>
        </div>
        <p class="mt-2 flex min-w-0 items-center gap-1.5 text-sm text-ink-500">
          <Icon name="corner-down-right" class="size-4 shrink-0" />
          <a class="truncate hover:text-ink-900 hover:underline" target="_blank" rel="noopener noreferrer" data-destination></a>
        </p>
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px] text-ink-500">
          <span class="inline-flex items-center gap-1.5"><Icon name="calendar" class="size-3.5" /><span data-created></span></span>
          <span class="inline-flex flex-wrap items-center gap-1.5"><span>Personalized with</span><span class="flex flex-wrap gap-1.5" data-columns></span></span>
        </div>
        <div class="mt-3 flex flex-wrap gap-1.5" data-tags></div>
      </div>
      <div class="flex shrink-0 gap-2">
        <button type="button" class="btn btn-secondary" data-export><Icon name="download" />Export links</button>
        <button type="button" class="btn btn-secondary btn-icon" popovertarget="campaign-menu" aria-label="More actions"><Icon name="more" /></button>
        <div id="campaign-menu" popover class="menu" data-align="end">
          <button type="button" class="menu-item" data-danger data-delete><Icon name="trash" />Delete campaign</button>
        </div>
      </div>
    </header>

    <!-- All-time numbers (3.17: /totals) -->
    <section aria-label="All time" class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      <StatCard label="Clicked" stat="clicked" icon="click" accent />
      <StatCard label="Opened" stat="opened" icon="mail-open" />
      <StatCard label="Recipients" stat="recipients" icon="users" />
      <StatCard label="Clicks" stat="clicks" icon="activity" />
    </section>
    <p class="hint mt-3" data-opens-caveat hidden>Opened includes Apple Mail, which loads the images of every email it receives to protect privacy, so it runs high.</p>

    <!-- Analytics for a period, over all its links (3.17): no list of visits, on purpose -->
    <AnalyticsSection />

    <!-- Recipients: all time, a page at a time (the API filters, searches, sorts and pages) -->
    <section class="card mt-6 overflow-hidden" aria-labelledby="recipients-title">
      <div class="grid gap-3 border-b border-line p-5 sm:p-6">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h2 id="recipients-title" class="font-semibold text-ink-950">Recipients <span class="font-normal text-ink-500" data-recipient-count></span></h2>
            <p class="text-sm text-ink-500">Follow up with the people who clicked or opened it while it’s fresh.</p>
          </div>
          <button type="button" class="btn btn-secondary btn-sm shrink-0" data-export-recipients aria-label="Export CSV"><Icon name="download" /><span class="max-sm:hidden">Export CSV</span></button>
        </div>
        <div class="flex flex-col gap-2 lg:flex-row lg:items-center">
          <div class="relative lg:w-72">
            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-ink-400"><Icon name="search" /></span>
            <label for="recipient-search" class="sr-only">Search recipients</label>
            <input id="recipient-search" type="search" class="input w-full pl-9" placeholder="Search recipients" data-search autocomplete="off" />
          </div>
          <div class="segmented scrollbar-none max-w-full self-start overflow-x-auto" role="radiogroup" aria-label="Show">
            {
              filters.map((f, i) => (
                <label>
                  <input type="radio" name="recipients" value={f.value} checked={i === 0} />
                  <span>
                    {f.label}
                    <span class="num font-normal text-ink-500" data-count={f.value} />
                  </span>
                </label>
              ))
            }
          </div>
          <div class="md:hidden" data-sort-select></div>
        </div>
      </div>
      <div data-select-bar hidden class="flex items-center gap-3 border-b border-line bg-ink-950 px-5 py-2.5 text-sm text-white">
        <span><span data-selected-count class="font-semibold"></span> selected</span>
        <button type="button" class="btn btn-sm text-white hover:bg-white/10" data-copy-selected><span data-copy-icon><Icon name="copy" /></span><span data-copy-label>Copy their links</span></button>
        <button type="button" class="btn btn-sm ml-auto text-ink-400 hover:bg-white/10 hover:text-white" data-clear-selection>Clear</button>
      </div>
      <div class="max-h-[36rem] overflow-auto" data-recipients aria-live="polite"></div>
      <nav data-pages hidden class="flex items-center justify-between gap-3 border-t border-line px-5 py-3 text-sm text-ink-500" aria-label="Recipients pagination">
        <p data-range></p>
        <div class="flex gap-2">
          <button type="button" class="btn btn-secondary btn-sm" data-prev><Icon name="chevron-left" />Previous</button>
          <button type="button" class="btn btn-secondary btn-sm" data-next>Next<Icon name="chevron-right" /></button>
        </div>
      </nav>
    </section>
  </div>

  <QrModal />
</AppLayout>

<script>
  import { ApiError, errorMessage } from '@/utils/api';
  import { initAnalytics, type AnalyticsControls } from '@/utils/analytics-section';
  import { downloadCampaignRecipients, getCampaignBreakdown, getCampaignRecipients, getCampaignTimeseries, getCampaignTotals } from '@/utils/campaign-analytics';
  import { columnChips, deleteCampaign, exportCampaignLinks, getCampaign } from '@/utils/campaigns';
  import { meter } from '@/utils/charts';
  import { formatDate, formatNumber, pluralize, prettyUrl } from '@/utils/format';
  import { html, safeUrl, setHTML } from '@/utils/html';
  import { icon } from '@/utils/icons';
  import { openQr } from '@/utils/links';
  import { recipientsView, sortSelect, syncSelection } from '@/utils/recipients';
  import { DEFAULT_SORT, EMPTY_MESSAGE, nextSort, pageRange, PAGE_SIZE, type RecipientFilter, type RecipientsRequest, type RecipientSort } from '@/utils/recipients-view';
  import { tagPill } from '@/utils/tags';
  import { confirmDialog, copyWithFeedback, hydrateTimes, setLoading, toast } from '@/utils/ui';
  import { canChange, creatorEmailBehindName, creatorName, getViewer, installLockedControls, lockControl, onForbidden, personalBadge, type Viewer } from '@/utils/viewer';
  import type { Campaign, CampaignRecipient, CampaignTotals } from '@/utils/types';

  const id = new URLSearchParams(location.search).get('id') ?? '';
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;

  let campaign: Campaign;
  let viewer: Viewer | null = null;
  let analytics: AnalyticsControls | null = null;
  installLockedControls();
  onForbidden(async () => {
    viewer = await getViewer();
    if (campaign) renderHeader();
  });

  function renderHeader() {
    document.title = `${campaign.name} · Shurly`;
    $('[data-name]').textContent = campaign.name;
    const dest = $<HTMLAnchorElement>('[data-destination]');
    dest.textContent = prettyUrl(campaign.original_url);
    dest.href = safeUrl(campaign.original_url);
    const creator = creatorName(campaign, viewer);
    $('[data-created]').textContent = `Created ${formatDate(campaign.created_at)}${creator ? ` by ${creator}` : ''}`;
    $('[data-created]').title = creatorEmailBehindName(campaign, viewer) ?? '';
    setHTML($('[data-badges]'), html`${personalBadge(campaign)}`);
    // On phones the header's actions sit at the left edge, so the tooltip opens rightwards.
    if (!canChange(campaign, viewer)) lockControl($('[data-delete]'), 'campaign', 'start');
    setHTML($('[data-columns]'), columnChips(campaign.csv_columns, 8));
    setHTML($('[data-tags]'), html`${(campaign.tags ?? []).map((t) => tagPill(t))}`);
  }

  // ------------------------------------------------------------------ All-time numbers (3.17: /totals)
  function setStat(key: string, value: string, hint: string | ReturnType<typeof html>) {
    $(`[data-stat="${key}"]`).textContent = value;
    const el = $(`[data-stat-hint="${key}"]`);
    if (typeof hint === 'string') el.textContent = hint;
    else setHTML(el, hint);
  }

  const percent = (rate: number) => `${Math.round(rate * 100)}%`;
  const ofRecipients = (n: number, t: CampaignTotals, what: string) =>
    html`<span class="mb-2 block">${formatNumber(n)} of ${pluralize(t.recipients, 'recipient')}</span>${meter(n, t.recipients, `${n} of ${t.recipients} recipients ${what}`)}`;

  function renderTotals(t: CampaignTotals | null) {
    if (!t) {
      for (const key of ['clicked', 'opened', 'recipients', 'clicks']) setStat(key, '—', 'Couldn’t load this');
      return;
    }
    setStat('clicked', percent(t.click_rate), ofRecipients(t.clicked, t, 'clicked their link'));
    setStat('opened', percent(t.open_rate), ofRecipients(t.opened, t, 'opened the email'));
    setStat('recipients', formatNumber(t.recipients), 'One personalized link each');
    setStat('clicks', formatNumber(t.clicks), t.recipients ? `${(t.clicks / t.recipients).toFixed(1)} per recipient` : '');
    $('[data-opens-caveat]').hidden = t.opened === 0;
    analytics?.setOpens(t.opens > 0);
    analytics?.setZone(t.timezone);
  }

  // ------------------------------------------------------------------ Recipients (all time, a page at a time)
  const list: RecipientsRequest = { filter: 'all', q: '', ...DEFAULT_SORT, page: 1, pageSize: PAGE_SIZE };
  let shown: CampaignRecipient[] = [];
  /** Ticked recipients, across pages: their code and link, for "Copy their links". */
  const selected = new Map<string, string>();
  let request = 0;

  async function loadRecipients(focusSort?: RecipientSort) {
    const n = ++request;
    const box = $('[data-recipients]');
    if (!box.firstElementChild) setHTML(box, html`<div class="p-5"><div class="skeleton h-72 w-full rounded-xl"></div></div>`);
    else box.classList.add('opacity-60');
    box.setAttribute('aria-busy', 'true');
    try {
      const page = await getCampaignRecipients(campaign, list);
      if (n !== request) return;
      shown = page.recipients;
      renderRecipients(page.total, page.page, page.page_size, page.pages, page.counts);
      if (focusSort) box.querySelector<HTMLElement>(`[data-sort="${focusSort}"]`)?.focus();
    } catch (err) {
      if (n !== request) return;
      setHTML(
        box,
        html`<div class="m-5 flex flex-col items-start gap-3 rounded-xl bg-ink-50 p-4 text-sm text-ink-700" role="alert">
          <p class="flex items-start gap-2">${icon('circle-alert', 'mt-0.5 size-4 shrink-0 text-red-600')}<span>Couldn’t load the recipients. ${errorMessage(err)}</span></p>
          <button type="button" class="btn btn-secondary btn-sm" data-retry>${icon('refresh')}Try again</button>
        </div>`,
      );
      box.querySelector('[data-retry]')!.addEventListener('click', () => void loadRecipients());
      $('[data-pages]').hidden = true;
    } finally {
      if (n === request) {
        box.classList.remove('opacity-60');
        box.setAttribute('aria-busy', 'false');
      }
    }
  }

  function renderRecipients(total: number, page: number, pageSize: number, pages: number, counts?: Record<RecipientFilter, number>) {
    const box = $('[data-recipients]');
    const opts = { columns: campaign.csv_columns, sort: { sort: list.sort, order: list.order }, selected: new Set(selected.keys()) };
    if (shown.length) {
      setHTML(box, recipientsView(shown, opts));
      hydrateTimes(box);
    } else {
      setHTML(box, html`<p class="px-6 py-12 text-center text-sm text-ink-500">${EMPTY_MESSAGE(list.filter, list.q)}</p>`);
    }
    setHTML($('[data-sort-select]'), sortSelect(opts.sort));
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const count = counts?.[el.dataset.count as RecipientFilter];
      el.textContent = count === undefined ? '' : ` ${formatNumber(count)}`;
    });
    $('[data-pages]').hidden = pages <= 1;
    $('[data-range]').textContent = pageRange(page, pageSize, total, shown.length);
    $<HTMLButtonElement>('[data-prev]').disabled = page <= 1;
    $<HTMLButtonElement>('[data-next]').disabled = page >= pages;
    updateSelectBar();
  }

  function updateSelectBar() {
    $('[data-select-bar]').hidden = selected.size === 0;
    $('[data-selected-count]').textContent = formatNumber(selected.size);
  }

  function select(code: string, on: boolean) {
    const row = shown.find((r) => r.short_code === code);
    if (on && row) selected.set(code, row.short_url);
    else selected.delete(code);
    syncSelection($('[data-recipients]'), code, on);
  }

  $('[data-recipients]').addEventListener('change', (e) => {
    const box = e.target as HTMLInputElement;
    if (box.matches('[data-select-all]')) {
      shown.forEach((r) => select(r.short_code, box.checked));
    } else if (box.matches('[data-select]')) {
      select(box.dataset.select!, box.checked);
    }
    updateSelectBar();
  });
  $('[data-recipients]').addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const header = target.closest<HTMLElement>('[data-sort]');
    if (header) {
      Object.assign(list, nextSort({ sort: list.sort, order: list.order }, header.dataset.sort as RecipientSort), { page: 1 });
      void loadRecipients(list.sort);
      return;
    }
    const qr = target.closest<HTMLElement>('[data-qr]');
    const row = qr && shown.find((r) => r.short_code === qr.dataset.qr);
    if (row) openQr({ short_url: row.short_url, short_code: row.short_code });
  });
  $('[data-sort-select]').addEventListener('change', (e) => {
    const [sort, order] = (e.target as HTMLSelectElement).value.split(':');
    Object.assign(list, { sort, order, page: 1 });
    void loadRecipients();
  });
  document.querySelectorAll<HTMLInputElement>('input[name="recipients"]').forEach((r) =>
    r.addEventListener('change', () => {
      Object.assign(list, { filter: r.value as RecipientFilter, page: 1 });
      void loadRecipients();
    }),
  );
  let typing = 0;
  $<HTMLInputElement>('#recipient-search').addEventListener('input', (e) => {
    window.clearTimeout(typing);
    typing = window.setTimeout(() => {
      Object.assign(list, { q: (e.target as HTMLInputElement).value.trim(), page: 1 });
      void loadRecipients();
    }, 250);
  });
  $('[data-prev]').addEventListener('click', () => {
    list.page -= 1;
    void loadRecipients();
  });
  $('[data-next]').addEventListener('click', () => {
    list.page += 1;
    void loadRecipients();
  });
  $('[data-copy-selected]').addEventListener('click', (e) => {
    copyWithFeedback([...selected.values()].join('\n'), e.currentTarget as HTMLElement, `${pluralize(selected.size, 'link')} copied`);
  });
  $('[data-clear-selection]').addEventListener('click', () => {
    [...selected.keys()].forEach((code) => syncSelection($('[data-recipients]'), code, false));
    selected.clear();
    $('[data-recipients]').querySelectorAll<HTMLInputElement>('[data-select-all]').forEach((box) => (box.checked = false));
    updateSelectBar();
  });

  const slug = (name: string) => name.toLowerCase().normalize('NFKD').replace(/[^\w]+/g, '-').replace(/^-|-$/g, '') || 'campaign';
  $('[data-export-recipients]').addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    setLoading(btn, true, '');
    try {
      await downloadCampaignRecipients(campaign, list, `${slug(campaign.name)}-recipients.csv`);
    } catch (err) {
      toast('Couldn’t export the recipients', 'error', { description: errorMessage(err) });
    } finally {
      setLoading(btn, false);
    }
  });

  // ------------------------------------------------------------------ Actions
  $('[data-export]').addEventListener('click', () => exportCampaignLinks(campaign).catch((err) => toast('Couldn’t export the links', 'error', { description: errorMessage(err) })));
  $('[data-delete]').addEventListener('click', async () => {
    $('#campaign-menu').hidePopover();
    const ok = await confirmDialog({
      title: `Delete “${campaign.name}”?`,
      body: `All ${pluralize(campaign.url_count, 'personalized link')} will stop working and their click history will be deleted. This can’t be undone.`,
      confirmLabel: 'Delete campaign',
      danger: true,
      onConfirm: () => deleteCampaign(id),
    });
    if (ok) {
      sessionStorage.setItem('shurly_flash', 'Campaign deleted');
      location.href = '/dashboard/campaigns/';
    }
  });

  // ------------------------------------------------------------------ Load
  async function load() {
    if (!id) {
      $('#loading').hidden = true;
      $('#not-found').hidden = false;
      return;
    }
    try {
      [campaign, viewer] = await Promise.all([getCampaign(id), getViewer()]);
    } catch (err) {
      $('#loading').hidden = true;
      $('#not-found').hidden = false;
      if (!(err instanceof ApiError && (err.status === 404 || err.status === 403 || err.status === 400))) {
        $('#not-found [data-empty-title]').textContent = 'We couldn’t load this campaign';
        $('#not-found [data-empty-body]').textContent = errorMessage(err);
      }
      return;
    }
    renderHeader();
    $('[data-recipient-count]').textContent = `· ${formatNumber(campaign.url_count)}`;
    $('#loading').hidden = true;
    $('#content').hidden = false;

    analytics = initAnalytics({
      timeseries: (period, groupBy) => getCampaignTimeseries(campaign, period, groupBy),
      breakdown: (period) => getCampaignBreakdown(campaign, period),
    });
    void loadRecipients();
    renderTotals(await getCampaignTotals(campaign).catch(() => null));
  }
  load();
</script>
