---
import AppLayout from '@/layouts/AppLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import StatCard from '@/components/ui/StatCard.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import EditLinkModal from '@/components/app/EditLinkModal.astro';
import QrModal from '@/components/app/QrModal.astro';
import { BROWSERS, DEVICES, LANGUAGES } from '@/utils/rules';
import type { IconName } from '@/utils/icons';

// Phase 3.16 — the link's analytics: the period's tabs, and the donuts of "By context".
const tabs: Array<{ key: string; label: string; icon: IconName }> = [
  { key: 'time', label: 'By time', icon: 'calendar' },
  { key: 'context', label: 'By context', icon: 'monitor' },
  { key: 'location', label: 'By location', icon: 'globe' },
  { key: 'visits', label: 'Visits', icon: 'list' },
];
const donuts = [
  { key: 'os', title: 'Operating systems' },
  { key: 'browsers', title: 'Browsers' },
  { key: 'devices', title: 'Devices' },
];
---

<AppLayout title="Link details" section="links">
  <a href="/dashboard/" class="mb-4 inline-flex items-center gap-1.5 rounded-md text-sm font-medium text-ink-500 hover:text-ink-950"><Icon name="arrow-left" />Links</a>

  <EmptyState id="not-found" hidden illustration="not-found" title="We couldn’t find that link" body="It may have been deleted, or it’s someone else’s personal link.">
    <a href="/dashboard/" class="btn btn-primary"><Icon name="list" />Back to your links</a>
  </EmptyState>

  <!-- Skeleton while loading -->
  <div id="loading" class="grid gap-6" aria-hidden="true">
    <div class="flex gap-4"><span class="skeleton size-14 rounded-2xl"></span><div class="flex-1 space-y-3 pt-1"><span class="skeleton block h-7 w-1/3"></span><span class="skeleton block h-5 w-1/4"></span><span class="skeleton block h-4 w-1/2"></span></div></div>
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">{[1, 2, 3, 4].map(() => <div class="skeleton h-32 rounded-2xl"></div>)}</div>
    <div class="skeleton h-72 rounded-2xl"></div>
  </div>

  <div id="content" hidden>
    <!-- Header -->
    <header class="flex flex-col gap-5 lg:flex-row lg:items-start">
      <div class="flex min-w-0 flex-1 gap-4">
        <span data-thumb></span>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="display min-w-0 text-[1.75rem] break-words text-ink-950 sm:text-3xl" data-title></h1>
            <span class="flex flex-wrap gap-1.5" data-badges></span>
          </div>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <a class="shortlink text-lg text-ink-950 hover:underline decoration-brand-400 decoration-2 underline-offset-4" target="_blank" rel="noopener" data-short></a>
            <button type="button" class="btn btn-accent btn-sm" data-copy-short><span data-copy-icon><Icon name="copy" /></span><span data-copy-label>Copy</span></button>
            <button type="button" class="btn btn-secondary btn-sm btn-icon" data-qr aria-label="QR code" data-tooltip="QR code"><Icon name="qr" /></button>
          </div>
          <p class="mt-2 flex min-w-0 items-center gap-1.5 text-sm text-ink-500">
            <Icon name="corner-down-right" class="size-4 shrink-0" />
            <a class="truncate hover:text-ink-900 hover:underline" target="_blank" rel="noopener noreferrer" data-destination></a>
          </p>
          <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[13px] text-ink-500" data-meta></p>
          <div class="mt-3 flex flex-wrap gap-1.5" data-tags></div>
        </div>
      </div>
      <div class="flex shrink-0 gap-2" data-actions>
        <button type="button" class="btn btn-secondary" data-edit><Icon name="pencil" />Edit</button>
        <button type="button" class="btn btn-secondary btn-icon" popovertarget="link-menu" aria-label="More actions"><Icon name="more" /></button>
        <div id="link-menu" popover class="menu" data-align="end">
          <button type="button" class="menu-item" data-refresh-og-menu><Icon name="refresh" />Refresh preview</button>
          <a class="menu-item" data-open-short target="_blank" rel="noopener"><Icon name="external-link" />Open short link</a>
          <div class="menu-sep"></div>
          <button type="button" class="menu-item" data-danger data-delete><Icon name="trash" />Delete link</button>
        </div>
      </div>
    </header>

    <!-- Campaign context -->
    <div data-campaign hidden class="mt-6 flex flex-col gap-3 rounded-2xl border border-sky-200 bg-sky-50 p-4 sm:flex-row sm:items-center">
      <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-white text-sky-700 ring-1 ring-sky-200"><Icon name="megaphone" /></span>
      <div class="min-w-0 flex-1 text-sm text-sky-900">
        <p>This is a personalized link in <a class="font-semibold underline underline-offset-2" data-campaign-link>a campaign</a>. It’s managed with the campaign, so it can’t be edited or deleted on its own.</p>
        <div class="mt-2 flex flex-wrap gap-1.5" data-user-data></div>
      </div>
    </div>

    <!-- All-time numbers (3.16: /totals) -->
    <section aria-label="All time" class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      <StatCard label="Clicks, all time" stat="clicks" icon="click" accent />
      <StatCard label="Email opens, all time" stat="opens" icon="mail-open" />
      <StatCard label="Countries" stat="countries" icon="globe" />
      <StatCard label="Last click" stat="last" icon="clock" />
    </section>

    <!-- Analytics for a period (3.16) -->
    <section class="card mt-6" aria-labelledby="analytics-title">
      <div class="flex flex-col gap-4 p-5 pb-4 sm:p-6 sm:pb-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="min-w-0">
          <h2 id="analytics-title" class="font-semibold text-ink-950">Analytics</h2>
          <p class="text-sm text-ink-500" data-range><span class="skeleton inline-block h-4 w-56 align-middle"></span></p>
        </div>
        <div class="flex min-w-0 items-center gap-2">
          <div class="segmented scrollbar-none min-w-0 overflow-x-auto" role="radiogroup" aria-label="Period" data-periods>
            {[7, 30, 90].map((d) => <label><input type="radio" name="period" value={String(d)} /><span>{d} days</span></label>)}
            <label data-custom><input type="radio" name="period" value="custom" /><span><Icon name="calendar" /><span data-custom-label>Custom</span></span></label>
          </div>
          <button type="button" class="btn btn-secondary btn-sm shrink-0" data-export aria-label="Export CSV"><Icon name="download" /><span class="max-sm:hidden">Export CSV</span></button>
        </div>
      </div>

      <div id="range-menu" popover class="menu w-72 p-4" data-align="end">
        <form class="grid gap-3" data-range-form novalidate>
          <p class="text-sm font-semibold text-ink-950">Custom range</p>
          <div class="grid grid-cols-2 gap-2">
            <label class="grid gap-1.5"><span class="label">From</span><input type="date" name="from" class="input" required /></label>
            <label class="grid gap-1.5"><span class="label">To</span><input type="date" name="to" class="input" required /></label>
          </div>
          <p class="field-error" data-range-error hidden></p>
          <div class="flex justify-end gap-2">
            <button type="button" class="btn btn-ghost btn-sm" data-range-cancel>Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm">Apply</button>
          </div>
        </form>
      </div>

      <div
        role="tablist"
        aria-label="Analytics"
        class="scrollbar-none relative flex gap-6 overflow-x-auto px-5 shadow-[inset_0_-1px_0_var(--color-line)] [mask-image:linear-gradient(to_right,transparent,#000_var(--fade-start,0px),#000_calc(100%-var(--fade-end,2.5rem)),transparent)] sm:px-6 md:[mask-image:none]"
        data-tablist
      >
        {
          tabs.map((tab, i) => (
            <button type="button" role="tab" id={`tab-${tab.key}`} class="tab mb-0 shrink-0 max-sm:focus-visible:outline-offset-[-2px]" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`panel-${tab.key}`} tabindex={i === 0 ? 0 : -1} data-tab={tab.key}>
              <Icon name={tab.icon} />
              {tab.label}
            </button>
          ))
        }
      </div>

      <!-- By time: the period's clicks (or opens) over time, by hour and by weekday -->
      <div role="tabpanel" id="panel-time" aria-labelledby="tab-time" class="p-5 sm:p-6" hidden>
        <div data-panel-error hidden></div>
        <div data-panel-body>
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h3 class="font-semibold text-ink-950" data-series-title>Clicks over time</h3>
              <p class="text-sm text-ink-500" data-series-sub>Per day</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <div class="segmented" role="radiogroup" aria-label="Show" data-series-picker hidden>
                <label><input type="radio" name="series" value="clicks" checked /><span>Clicks</span></label>
                <label><input type="radio" name="series" value="opens" /><span>Email opens</span></label>
              </div>
              <div class="segmented" role="radiogroup" aria-label="Group by">
                <label><input type="radio" name="group" value="day" /><span>Day</span></label>
                <label><input type="radio" name="group" value="week" /><span>Week</span></label>
                <label><input type="radio" name="group" value="month" /><span>Month</span></label>
              </div>
              <button type="button" class="btn btn-ghost btn-sm" data-table-toggle="series" aria-pressed="false"><Icon name="list" /><span data-label>Table</span></button>
            </div>
          </div>
          <div class="mt-6" data-chart="series"></div>
          <div class="mt-4 max-h-80 overflow-auto rounded-xl border border-line" data-table="series" hidden></div>
          <p class="hint mt-4" data-opens-note hidden>Apple Mail loads the images of an email when it arrives, to protect its users’ privacy, so some opens aren’t people reading.</p>
          <p class="hint mt-2" data-days-hint hidden></p>
          <div class="mt-8 grid gap-8 border-t border-line pt-6 lg:grid-cols-2">
            <section aria-labelledby="hours-title">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 id="hours-title" class="font-semibold text-ink-950">Time of day</h3>
                  <p class="text-sm text-ink-500" data-hours-sub>Clicks by hour</p>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" data-table-toggle="hours" aria-pressed="false"><Icon name="list" /><span data-label>Table</span></button>
              </div>
              <div class="mt-5" data-chart="hours"></div>
              <div class="mt-4 max-h-80 overflow-auto rounded-xl border border-line" data-table="hours" hidden></div>
            </section>
            <section aria-labelledby="weekdays-title">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 id="weekdays-title" class="font-semibold text-ink-950">Day of the week</h3>
                  <p class="text-sm text-ink-500" data-weekdays-sub>Clicks by weekday</p>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" data-table-toggle="weekdays" aria-pressed="false"><Icon name="list" /><span data-label>Table</span></button>
              </div>
              <div class="mt-5" data-chart="weekdays"></div>
              <div class="mt-4 max-h-80 overflow-auto rounded-xl border border-line" data-table="weekdays" hidden></div>
            </section>
          </div>
        </div>
      </div>

      <!-- By context: operating systems, browsers, devices and referrers -->
      <div role="tabpanel" id="panel-context" aria-labelledby="tab-context" class="p-5 sm:p-6" hidden>
        <div data-panel-error hidden></div>
        <div class="grid gap-6" data-panel-body>
          <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {
              donuts.map((d) => (
                <section class="rounded-2xl border border-line p-5" aria-labelledby={`${d.key}-title`}>
                  <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
                    <h3 id={`${d.key}-title`} class="font-semibold text-ink-950">{d.title}</h3>
                    <div class="flex items-center gap-3">
                      <label class="flex items-center gap-2 text-sm text-ink-600"><span class="switch"><input type="checkbox" role="switch" data-numbers={d.key} /><span></span></span>Show numbers</label>
                      <button type="button" class="btn btn-ghost btn-sm" data-table-toggle={d.key} aria-pressed="false"><Icon name="list" /><span data-label>Table</span></button>
                    </div>
                  </div>
                  <div class="mt-5" data-chart={d.key}></div>
                  <div class="mt-4 max-h-80 overflow-auto rounded-xl border border-line" data-table={d.key} hidden></div>
                </section>
              ))
            }
          </div>
          <section class="rounded-2xl border border-line p-5" aria-labelledby="referrers-title">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 id="referrers-title" class="font-semibold text-ink-950">Referrers</h3>
                <p class="text-sm text-ink-500">Direct means no referrer: an email app, a chat, or a typed link.</p>
              </div>
              <button type="button" class="btn btn-ghost btn-sm" data-table-toggle="referrers" aria-pressed="false"><Icon name="list" /><span data-label>Table</span></button>
            </div>
            <div class="mt-5" data-chart="referrers"></div>
            <div class="mt-4 max-h-80 overflow-auto rounded-xl border border-line" data-table="referrers" hidden></div>
          </section>
        </div>
      </div>

      <!-- By location: countries -->
      <div role="tabpanel" id="panel-location" aria-labelledby="tab-location" class="p-5 sm:p-6" hidden>
        <div data-panel-error hidden></div>
        <section data-panel-body aria-labelledby="countries-title">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 id="countries-title" class="font-semibold text-ink-950">Countries</h3>
              <p class="text-sm text-ink-500">Countries by <a class="link" href="https://db-ip.com" target="_blank" rel="noopener">DB-IP</a>. Unknown: clicks it couldn’t place, or from before countries were recorded.</p>
            </div>
            <button type="button" class="btn btn-ghost btn-sm" data-table-toggle="countries" aria-pressed="false"><Icon name="list" /><span data-label>Table</span></button>
          </div>
          <div class="mt-5" data-chart="countries"></div>
          <div class="mt-4 max-h-80 overflow-auto rounded-xl border border-line" data-table="countries" hidden></div>
        </section>
      </div>

      <!-- Visits: one row each, newest first -->
      <div role="tabpanel" id="panel-visits" aria-labelledby="tab-visits" class="p-5 sm:p-6" hidden>
        <div data-panel-error hidden></div>
        <div data-panel-body>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="segmented scrollbar-none max-w-full overflow-x-auto" role="radiogroup" aria-label="Which visits">
              <label><input type="radio" name="visit-type" value="clicks" checked /><span>Clicks</span></label>
              <label><input type="radio" name="visit-type" value="opens" /><span>Email opens</span></label>
              <label><input type="radio" name="visit-type" value="bots" /><span>Bots</span></label>
              <label><input type="radio" name="visit-type" value="all" /><span>All</span></label>
            </div>
            <p class="text-sm text-ink-500" data-visits-count aria-live="polite"></p>
          </div>
          <div class="mt-4" data-visits></div>
          <nav class="mt-4 flex items-center justify-between gap-3" aria-label="Pages of visits" data-pager hidden>
            <button type="button" class="btn btn-secondary btn-sm" data-page="newer"><Icon name="chevron-left" />Newer</button>
            <span class="text-sm text-ink-500" data-page-of></span>
            <button type="button" class="btn btn-secondary btn-sm" data-page="older">Older<Icon name="chevron-right" /></button>
          </nav>
        </div>
      </div>
    </section>

    <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <!-- Social preview -->
      <section class="card overflow-hidden" aria-labelledby="preview-title">
        <div class="flex items-center justify-between px-5 pt-5 pb-4">
          <div>
            <h2 id="preview-title" class="font-semibold text-ink-950">Social preview</h2>
            <p class="text-xs text-ink-500" data-og-meta></p>
          </div>
          <div class="flex gap-1">
            <button type="button" class="btn btn-ghost btn-sm btn-icon" data-refresh-og aria-label="Refresh from page" data-tooltip="Refresh from page" data-tooltip-align="end"><Icon name="refresh" /></button>
            <button type="button" class="btn btn-ghost btn-sm btn-icon" data-edit-og aria-label="Edit preview" data-tooltip="Edit preview" data-tooltip-align="end"><Icon name="pencil" /></button>
          </div>
        </div>
        <div class="border-t border-line" data-og-card></div>
      </section>
      <!-- Tracking -->
      <section class="card p-5 sm:p-6" aria-labelledby="track-title">
        <h2 id="track-title" class="font-semibold text-ink-950">Track email opens</h2>
        <p class="mt-1 text-sm leading-6 text-ink-500">Paste this invisible image into an HTML email. Opens show up separately from clicks, so your click numbers stay clean.</p>
        <div class="mt-4 flex items-start gap-2 rounded-xl border border-line bg-ink-50 p-3">
          <code class="min-w-0 flex-1 font-mono text-xs leading-5 break-all text-ink-700" data-pixel></code>
          <button type="button" class="btn btn-secondary btn-sm shrink-0" data-copy-pixel><span data-copy-icon><Icon name="copy" /></span><span data-copy-label>Copy</span></button>
        </div>
        <div class="mt-4 flex gap-2.5 rounded-xl bg-brand-50 p-3 text-sm text-brand-900" data-utm-tip>
          <Icon name="zap" class="mt-0.5 size-4 shrink-0 text-brand-700" />
          <p>Tip: add <code class="font-mono text-[13px]">?utm_source=newsletter</code> to the short link and it’s passed on to your page.</p>
        </div>
      </section>
    </div>

    <!-- Smart redirects -->
    <section class="card mt-6 p-5 sm:p-6" aria-labelledby="rules-title">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 id="rules-title" class="flex items-center gap-2 font-semibold text-ink-950">Smart redirects <span class="badge badge-neutral">Advanced</span></h2>
          <p class="mt-1 max-w-xl text-sm text-ink-500">Send some visitors somewhere else — iPhone users to the App Store, Spanish speakers to the Spanish page. Everyone else goes to the destination.</p>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" data-add-rule><Icon name="plus" />Add rule</button>
      </div>
      <ul class="mt-5 grid gap-2" data-rules></ul>
      <p class="mt-2 hidden text-sm text-ink-500" data-rules-empty>No rules yet — everyone goes to the destination.</p>

      <form data-rule-form hidden class="mt-4 grid gap-4 rounded-2xl border border-line bg-ink-50 p-4" novalidate>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-[12rem_minmax(0,1fr)]">
          <div class="grid gap-1.5">
            <label class="label" for="rule-type">When</label>
            <select id="rule-type" name="type" class="select">
              <option value="device">Device</option>
              <option value="language">Browser language</option>
              <option value="browser">Browser</option>
              <option value="query_param">Link has parameter</option>
              <option value="after_date">On or after date</option>
              <option value="before_date">Before date</option>
            </select>
          </div>
          <div class="grid gap-1.5">
            <span class="label" id="rule-value-label">Is</span>
            <div data-rule-value="device"><select name="device" class="select" aria-labelledby="rule-value-label">{Object.entries(DEVICES).map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
            <div data-rule-value="language" hidden><select name="language" class="select" aria-labelledby="rule-value-label">{Object.entries(LANGUAGES).map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
            <div data-rule-value="browser" hidden><select name="browser" class="select" aria-labelledby="rule-value-label">{BROWSERS.map((b) => <option value={b.toLowerCase()}>{b}</option>)}</select></div>
            <div data-rule-value="query_param" hidden class="grid grid-cols-2 gap-2">
              <input name="param" class="input" placeholder="Parameter, e.g. ref" aria-label="Parameter name" />
              <input name="param_value" class="input" placeholder="Value (optional)" aria-label="Parameter value" />
            </div>
            <div data-rule-value="date" hidden><input name="date" type="datetime-local" class="input" aria-labelledby="rule-value-label" /></div>
            <p class="field-error" data-error-for="param" hidden></p>
            <p class="field-error" data-error-for="date" hidden></p>
          </div>
        </div>
        <div class="grid gap-1.5">
          <label class="label" for="rule-target">Send them to</label>
          <input id="rule-target" name="target_url" type="url" inputmode="url" class="input" placeholder="https://…" />
          <p class="field-error" data-error-for="target_url" hidden></p>
        </div>
        <div class="flex justify-end gap-2">
          <button type="button" class="btn btn-ghost btn-sm" data-cancel-rule>Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Save rule</button>
        </div>
      </form>
    </section>
  </div>

  <EditLinkModal />
  <QrModal />
</AppLayout>

<script>
  import { apiGet, ApiError, errorMessage } from '@/utils/api';
  import { barList, bindChartTableToggle, bindShowNumbers, columnChart, dataTable, donutChart, donutTable } from '@/utils/charts';
  import {
    bucketRows,
    dayOfWeekRows,
    defaultGroupBy,
    deviceLabel,
    hourRows,
    PERIOD_CHOICES,
    periodFromParams,
    periodLabel,
    rangeLabel,
    rangeProblem,
    setPeriodParams,
    visitTime,
    type GroupBy,
    type Period,
    type Series,
  } from '@/utils/analytics-view';
  import { todayIn } from '@/utils/days';
  import { clearErrors, setFieldError } from '@/utils/forms';
  import { formatDate, formatDateTime, formatNumber, fromLocalInput, hostname, isValidHttpUrl, linkTitle, normalizeUrlInput, parseDate, pluralize, prettyUrl } from '@/utils/format';
  import { html, safeUrl, setHTML, type RawHTML } from '@/utils/html';
  import { icon } from '@/utils/icons';
  import { downloadVisits, getBreakdown, getTimeseries, getTotals, getVisits } from '@/utils/link-analytics';
  import { openLinkEditor } from '@/utils/link-editor';
  import { campaignHref, deleteLink, getLink, linkBadges, linkThumb, openQr } from '@/utils/links';
  import { linkApi } from '@/utils/link-address';
  import { countryName } from '@/utils/country';
  import { createRule, deleteRule, listRules, renderRule } from '@/utils/rules';
  import { initTabs, type Tabs } from '@/utils/tabs';
  import { tagPill } from '@/utils/tags';
  import { confirmDialog, copyWithFeedback, hydrateTimes, positionMenu, setLoading, toast } from '@/utils/ui';
  import { apiPost } from '@/utils/api';
  import { canChange, creatorEmailBehindName, creatorName, getViewer, installLockedControls, lockControl, onForbidden, showDaysZoneHint, type Viewer } from '@/utils/viewer';
  import type { BreakdownEntry, CampaignListResponse, LinkBreakdown, LinkTimeseries, LinkTotals, LinkVisit, LinkVisits, PreviewMetadata, RedirectRule, RuleCondition, RuleConditionType, ShortLink, VisitType } from '@/utils/types';

  // Phase 8.3 — a link is its code and its domain. Without `?domain=` (an old bookmark),
  // the default domain's link answers; after that, the loaded link addresses itself.
  const params = new URLSearchParams(location.search);
  const code = params.get('code') ?? '';
  const domain = params.get('domain');
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  let link: ShortLink;
  let rules: RedirectRule[] = [];
  let viewer: Viewer | null = null;
  /** The viewer may change this link (its creator, or an admin or owner for the organization's). */
  const changeable = () => canChange(link, viewer);
  installLockedControls();
  onForbidden(async () => {
    viewer = await getViewer();
    if (!link) return;
    renderHeader();
    renderRules();
  });

  // ------------------------------------------------------------------ Header
  function renderHeader() {
    const title = linkTitle(link);
    document.title = `${title} · Shurly`;
    setHTML($('[data-thumb]'), linkThumb(link, 'size-14'));
    $('[data-title]').textContent = title;
    setHTML($('[data-badges]'), linkBadges(link));
    const short = $<HTMLAnchorElement>('[data-short]');
    short.textContent = prettyUrl(link.short_url);
    short.href = safeUrl(link.short_url);
    $<HTMLAnchorElement>('[data-open-short]').href = safeUrl(link.short_url);
    const dest = $<HTMLAnchorElement>('[data-destination]');
    dest.textContent = prettyUrl(link.original_url);
    dest.href = safeUrl(link.original_url);
    dest.title = link.original_url;
    setHTML(
      $('[data-meta]'),
      html`<span class="inline-flex items-center gap-1.5" ${creatorEmailBehindName(link, viewer) ? html`title="${creatorEmailBehindName(link, viewer)}"` : ''}>${icon('calendar', 'size-3.5')}Created ${formatDate(link.created_at)}${creatorName(link, viewer) ? ` by ${creatorName(link, viewer)}` : ''}</span>
        <span class="inline-flex items-center gap-1.5">${icon('pencil', 'size-3.5')}Updated <time data-relative datetime="${link.updated_at}"></time></span>
        ${link.valid_since ? html`<span class="inline-flex items-center gap-1.5">${icon('calendar-clock', 'size-3.5')}Live from ${formatDateTime(link.valid_since)}</span>` : ''}
        ${link.valid_until ? html`<span class="inline-flex items-center gap-1.5">${icon('timer', 'size-3.5')}Expires ${formatDateTime(link.valid_until)}</span>` : ''}
        ${link.max_visits ? html`<span class="inline-flex items-center gap-1.5">${icon('ban', 'size-3.5')}${formatNumber(link.click_count)} of ${formatNumber(link.max_visits)} clicks used</span>` : ''}`,
    );
    setHTML($('[data-tags]'), html`${link.tags.map((t) => tagPill(t, { href: `/dashboard/?tags=${encodeURIComponent(t.id)}` }))}`);
    hydrateTimes($('[data-meta]'));

    const isCampaign = link.url_type === 'campaign';
    $('[data-edit]').hidden = isCampaign;
    $('[data-edit-og]').hidden = isCampaign;
    $('[data-delete]').hidden = isCampaign;
    $('[data-campaign]').hidden = !isCampaign;
    if (isCampaign) {
      const a = $<HTMLAnchorElement>('[data-campaign-link]');
      a.href = link.campaign_id ? campaignHref(link.campaign_id) : '/dashboard/campaigns/';
      setHTML(
        $('[data-user-data]'),
        html`${Object.entries(link.user_data ?? {}).map(([k, v]) => html`<span class="badge badge-outline"><span class="text-ink-500">${k}</span> ${v}</span>`)}`,
      );
      if (link.campaign_id) {
        apiGet<CampaignListResponse>('/api/v1/campaigns?limit=100')
          .then((r) => {
            const c = r.campaigns.find((x) => x.id === link.campaign_id);
            if (c) a.textContent = c.name;
          })
          .catch(() => {});
      }
    }
    // Shown as text, to paste into an email's HTML.
    const pixel = link.short_url ? `<img src="${safeUrl(link.short_url)}/track" width="1" height="1" alt="" style="display:none">` : '';
    $('[data-pixel]').textContent = pixel;
    $('[data-utm-tip]').hidden = !link.forward_parameters || isCampaign;
    if (!changeable()) {
      // Tooltips open rightwards: on phones these controls sit at the left edge.
      ['[data-edit]', '[data-edit-og]', '[data-refresh-og]', '[data-refresh-og-menu]', '[data-delete]', '[data-add-rule]'].forEach((sel) =>
        lockControl($(sel), 'link', sel === '[data-edit-og]' || sel === '[data-refresh-og]' ? 'end' : 'start'),
      );
    }
  }

  // ------------------------------------------------------------------ Analytics (3.16)
  // The all-time numbers come from /totals. Everything under "Analytics" is for the period, from the
  // contract's routes (src/utils/link-analytics.ts): each tab loads when it opens, and again after the
  // period changes. The timeseries always loads, as it also says which days the period counted.
  const browserZone = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
  let totals: LinkTotals | null = null;
  let period: Period = periodFromParams(params, todayIn(browserZone));
  let groupBy: GroupBy = defaultGroupBy(period);
  let series: Series = 'clicks';
  /** Set once the viewer picks clicks or opens; until then a period with only opens shows opens. */
  let seriesChosen = false;
  let visitType: VisitType = 'clicks';
  let visitPage = 1;
  let timeseries: Promise<LinkTimeseries> | null = null;
  let breakdown: Promise<LinkBreakdown> | null = null;
  let visitsShown = '';
  let counted: { from: string; to: string; timezone: string } | null = null;
  let tabs: Tabs | null = null;

  const CLICKS: [string, string] = ['click', 'clicks'];
  const OPENS: [string, string] = ['email open', 'email opens'];
  const panel = (key: string) => $(`#panel-${key}`);
  const panelBody = (key: string) => panel(key).querySelector<HTMLElement>('[data-panel-body]')!;
  const chartEl = (key: string) => $(`[data-chart="${key}"]`);
  const tableEl = (key: string) => $(`[data-table="${key}"]`);
  const skeleton = (height: string) => html`<div class="skeleton ${height} w-full rounded-xl"></div>`;
  const nothing = (message: string) =>
    html`<div class="flex items-start gap-3 rounded-xl bg-ink-50 p-4 text-sm text-ink-600"><span class="mt-0.5 text-ink-400">${icon('chart', 'size-4')}</span><p>${message}</p></div>`;

  function setStat(key: string, value: string, hint: string) {
    $(`[data-stat="${key}"]`).textContent = value;
    $(`[data-stat-hint="${key}"]`).textContent = hint;
  }

  function renderTotals() {
    if (!totals) {
      for (const key of ['clicks', 'opens', 'countries', 'last']) setStat(key, '—', 'Couldn’t load this');
      return;
    }
    setStat('clicks', formatNumber(totals.clicks), totals.clicks ? 'Real people — bots excluded' : 'Share it to get the first one');
    setStat('opens', formatNumber(totals.opens), totals.opens ? 'Apple Mail opens some on its own' : 'Add the tracking image to an email');
    setStat('countries', formatNumber(totals.countries), totals.countries ? 'Where its clicks came from' : 'None known yet');
    if (parseDate(totals.last_click_at)) {
      setHTML($('[data-stat="last"]'), html`<time data-relative datetime="${totals.last_click_at}"></time>`);
      $('[data-stat-hint="last"]').textContent = formatDateTime(totals.last_click_at);
      hydrateTimes($('[data-stat="last"]'));
    } else setStat('last', 'Never', 'No clicks yet');
    $('[data-series-picker]').hidden = totals.opens === 0;
  }

  /** Dim a panel while it reloads (the first load shows skeletons instead). */
  function busy(key: string, on: boolean) {
    panelBody(key).classList.toggle('opacity-60', on);
    panel(key).setAttribute('aria-busy', String(on));
  }

  /** Show a panel's content, or, with `error`, what went wrong and a way to try again. */
  function panelState(key: string, error?: unknown) {
    const box = panel(key).querySelector<HTMLElement>('[data-panel-error]')!;
    panelBody(key).hidden = error !== undefined;
    box.hidden = error === undefined;
    if (error === undefined) return;
    setHTML(
      box,
      html`<div class="flex flex-col items-start gap-3 rounded-xl bg-ink-50 p-4 text-sm text-ink-700" role="alert">
        <p class="flex items-start gap-2">${icon('circle-alert', 'mt-0.5 size-4 shrink-0 text-red-600')}<span>Couldn’t load these numbers. ${errorMessage(error)}</span></p>
        <button type="button" class="btn btn-secondary btn-sm" data-retry>${icon('refresh')}Try again</button>
      </div>`,
    );
    box.querySelector('[data-retry]')!.addEventListener('click', () => loadTab(key));
  }

  /** "Last 30 days: Aug 31 – Sep 29, 2026 · 34 clicks · 12 email opens": what the period counted. */
  function renderRange(ts: LinkTimeseries) {
    counted = { from: ts.from, to: ts.to, timezone: ts.timezone };
    const when = 'days' in period ? `${periodLabel(period)}: ${rangeLabel(ts.from, ts.to)}` : rangeLabel(ts.from, ts.to);
    $('[data-range]').textContent = `${when} · ${pluralize(ts.clicks, 'click')} · ${pluralize(ts.opens, 'email open')}`;
  }

  // ---------------------------------------------------------------- By time
  async function loadTime() {
    const first = !chartEl('series').querySelector('svg');
    timeseries ??= getTimeseries(link, period, groupBy);
    const request = timeseries;
    if (first) ['series', 'hours', 'weekdays'].forEach((key) => setHTML(chartEl(key), skeleton(key === 'series' ? 'h-60' : 'h-48')));
    else busy('time', true);
    try {
      const ts = await request;
      if (request !== timeseries) return;
      panelState('time');
      renderRange(ts);
      if (!seriesChosen) {
        series = ts.clicks === 0 && ts.opens > 0 ? 'opens' : 'clicks';
        document.querySelectorAll<HTMLInputElement>('input[name="series"]').forEach((r) => (r.checked = r.value === series));
      }
      renderTime(ts);
    } catch (err) {
      if (request !== timeseries) return;
      timeseries = null;
      $('[data-range]').textContent = periodLabel(period);
      panelState('time', err);
    } finally {
      if (request === timeseries || timeseries === null) busy('time', false);
    }
  }

  function renderTime(ts: LinkTimeseries) {
    const unit = series === 'clicks' ? CLICKS : OPENS;
    const what = series === 'clicks' ? 'Clicks' : 'Email opens';
    const empty = series === 'clicks' ? 'No clicks in this period' : 'No email opens in this period';
    const per = { day: 'Per day', week: 'Per week, from Monday', month: 'Per month' }[ts.group_by];
    const rows = bucketRows(ts.stats, ts.group_by, series, todayIn(ts.timezone));
    $('[data-series-title]').textContent = `${what} over time`;
    $('[data-series-sub]').textContent = per;
    columnChart(chartEl('series'), rows, { ariaLabel: `${what}, ${per.toLowerCase()}, ${rangeLabel(ts.from, ts.to)}. Total ${formatNumber(ts[series])}.`, height: 240, unit, emptyMessage: empty });
    setHTML(tableEl('series'), dataTable(rows.map((r) => ({ label: r.title, value: r.value })), [{ day: 'Day', week: 'Week', month: 'Month' }[ts.group_by], what]));

    const hours = hourRows(ts.hour_of_day, series);
    $('[data-hours-sub]').textContent = `${what} by hour, local time`;
    columnChart(chartEl('hours'), hours, { ariaLabel: `${what} by hour of the day.`, height: 200, unit, emptyMessage: empty });
    setHTML(tableEl('hours'), dataTable(hours.map((r) => ({ label: r.title, value: r.value })), ['Hour', what]));

    const weekdays = dayOfWeekRows(ts.day_of_week, series);
    $('[data-weekdays-sub]').textContent = `${what} by weekday`;
    columnChart(chartEl('weekdays'), weekdays, { ariaLabel: `${what} by day of the week.`, height: 200, unit, emptyMessage: empty });
    setHTML(tableEl('weekdays'), dataTable(weekdays.map((r) => ({ label: r.title, value: r.value })), ['Day', what]));

    $('[data-opens-note]').hidden = series !== 'opens';
    void showDaysZoneHint($('[data-days-hint]'));
  }

  // ---------------------------------------------------------------- By context, by location (one /breakdown)
  const entries = (list: BreakdownEntry[], label: (name: string) => string = (name) => name) => list.map((e) => ({ label: label(e.name), value: e.count }));
  const numbersOn = (key: string) => $<HTMLInputElement>(`[data-numbers="${key}"]`).checked;

  async function loadBreakdown(key: 'context' | 'location') {
    const first = !panelBody(key).dataset.loaded;
    breakdown ??= getBreakdown(link, period, 'clicks');
    const request = breakdown;
    if (first) {
      if (key === 'context') {
        ['os', 'browsers', 'devices'].forEach((k) => setHTML(chartEl(k), skeleton('h-36')));
        setHTML(chartEl('referrers'), skeleton('h-40'));
      } else setHTML(chartEl('countries'), skeleton('h-56'));
    } else busy(key, true);
    try {
      const b = await request;
      if (request !== breakdown) return;
      panelState(key);
      if (key === 'context') renderContext(b);
      else renderLocation(b);
      panelBody(key).dataset.loaded = 'true';
    } catch (err) {
      if (request !== breakdown) return;
      breakdown = null;
      panelState(key, err);
    } finally {
      busy(key, false);
    }
  }

  function renderContext(b: LinkBreakdown) {
    const parts = { os: ['Operating system', entries(b.os)], browsers: ['Browser', entries(b.browsers)], devices: ['Device', entries(b.devices, deviceLabel)] } as const;
    for (const [key, [heading, items]] of Object.entries(parts)) {
      donutChart(chartEl(key), items, { unit: CLICKS, showNumbers: numbersOn(key), emptyMessage: 'No clicks in this period' });
      setHTML(tableEl(key), donutTable(items, [heading, 'Clicks']));
    }
    const referrers = entries(b.referrers);
    setHTML(chartEl('referrers'), referrers.length ? barList(referrers, CLICKS, { limit: 10 }) : nothing('No clicks in this period.'));
    setHTML(tableEl('referrers'), dataTable(referrers, ['Referrer', 'Clicks'], { share: true }));
  }

  function renderLocation(b: LinkBreakdown) {
    // Unknown goes last, whatever its count: it isn't a place.
    const places = [...b.countries.filter((c) => c.name !== 'Unknown'), ...b.countries.filter((c) => c.name === 'Unknown')];
    const items = entries(places, (name) => (name === 'Unknown' ? 'Unknown' : countryName(name)));
    setHTML(chartEl('countries'), items.length ? barList(items, CLICKS, { limit: 10 }) : nothing('No clicks in this period.'));
    setHTML(tableEl('countries'), dataTable(items, ['Country', 'Clicks'], { share: true }));
  }

  // ---------------------------------------------------------------- Visits
  const KINDS: Record<LinkVisit['kind'], [string, string]> = { click: ['badge-brand', 'Click'], open: ['badge-info', 'Email open'], bot: ['badge-neutral', 'Bot'] };
  const NO_VISITS: Record<VisitType, string> = { clicks: 'No clicks in this period.', opens: 'No email opens in this period.', bots: 'No bots in this period.', all: 'No visits in this period.' };
  const known = (value: string) => value !== 'Unknown';

  async function loadVisits() {
    const key = `${JSON.stringify(period)}|${visitType}|${visitPage}`;
    if (key === visitsShown) return;
    visitsShown = key;
    if (!$('[data-visits]').firstElementChild) setHTML($('[data-visits]'), skeleton('h-72'));
    else busy('visits', true);
    try {
      const v = await getVisits(link, period, visitType, visitPage);
      if (key !== visitsShown) return;
      panelState('visits');
      renderVisits(v);
    } catch (err) {
      if (key !== visitsShown) return;
      visitsShown = '';
      panelState('visits', err);
    } finally {
      busy('visits', false);
    }
  }

  function renderVisits(v: LinkVisits) {
    const first = (v.page - 1) * v.page_size + 1;
    $('[data-visits-count]').textContent = v.visits.length ? `${formatNumber(first)}–${formatNumber(first + v.visits.length - 1)} of ${formatNumber(v.total)}` : '';
    $('[data-pager]').hidden = v.pages <= 1;
    $<HTMLButtonElement>('[data-page="newer"]').disabled = v.page <= 1;
    $<HTMLButtonElement>('[data-page="older"]').disabled = v.page >= v.pages;
    $('[data-page-of]').textContent = `Page ${formatNumber(v.page)} of ${formatNumber(v.pages)}`;
    if (!v.visits.length) {
      setHTML($('[data-visits]'), nothing(NO_VISITS[v.type]));
      return;
    }
    const withKind = v.type === 'all';
    const badge = (visit: LinkVisit) => html`<span class="badge ${KINDS[visit.kind][0]}">${KINDS[visit.kind][1]}</span>`;
    const when = (visit: LinkVisit): RawHTML => {
      const t = visitTime(visit.visited_at);
      return html`<time datetime="${visit.visited_at}" title="${t.long}">${t.short}</time>`;
    };
    const software = (visit: LinkVisit) =>
      known(visit.browser) && known(visit.os) ? `${visit.browser} on ${visit.os}` : known(visit.browser) ? visit.browser : known(visit.os) ? visit.os : '';
    const summary = (visit: LinkVisit) => [known(visit.country) ? countryName(visit.country) : '', software(visit), known(visit.device) ? deviceLabel(visit.device) : ''].filter(Boolean).join(' · ') || 'Unknown';
    setHTML(
      $('[data-visits]'),
      html`<div class="overflow-x-auto rounded-xl border border-line max-md:hidden">
          <table class="table">
            <thead>
              <tr><th scope="col">Date and time</th><th scope="col">Country</th><th scope="col">Browser</th><th scope="col">OS</th><th scope="col">Device</th><th scope="col">Referrer</th>${withKind ? html`<th scope="col">Type</th>` : ''}</tr>
            </thead>
            <tbody>${v.visits.map(
              (visit) => html`<tr>
                <td class="whitespace-nowrap">${when(visit)}</td>
                <td>${known(visit.country) ? countryName(visit.country) : 'Unknown'}</td>
                <td>${visit.browser}</td>
                <td>${visit.os}</td>
                <td>${deviceLabel(visit.device)}</td>
                <td class="max-w-[16rem] truncate" title="${visit.referrer}">${visit.referrer}</td>
                ${withKind ? html`<td>${badge(visit)}</td>` : ''}
              </tr>`,
            )}</tbody>
          </table>
        </div>
        <ul class="divide-y divide-line rounded-xl border border-line md:hidden">${v.visits.map(
          (visit) => html`<li class="grid gap-1 px-4 py-3 text-sm">
            <div class="flex items-center justify-between gap-3"><span class="font-medium text-ink-900">${when(visit)}</span>${withKind ? badge(visit) : ''}</div>
            <p class="text-ink-700">${summary(visit)}</p>
            <p class="truncate text-ink-500">${visit.referrer === 'Direct' ? 'Direct' : known(visit.referrer) ? `From ${visit.referrer}` : 'Unknown referrer'}</p>
          </li>`,
        )}</ul>`,
    );
  }

  // ---------------------------------------------------------------- Tabs and the period
  function loadTab(key: string) {
    if (key === 'time') void loadTime();
    else if (key === 'context' || key === 'location') void loadBreakdown(key);
    else void loadVisits();
  }

  const periodRadios = [...document.querySelectorAll<HTMLInputElement>('input[name="period"]')];
  const choice = (p: Period) => ('days' in p && (PERIOD_CHOICES as readonly number[]).includes(p.days) ? String(p.days) : 'custom');

  function syncPeriodControls() {
    periodRadios.forEach((r) => (r.checked = r.value === choice(period)));
    $('[data-custom-label]').textContent = choice(period) === 'custom' ? periodLabel(period) : 'Custom';
    document.querySelectorAll<HTMLInputElement>('input[name="group"]').forEach((r) => (r.checked = r.value === groupBy));
  }

  function setPeriod(next: Period) {
    period = next;
    const query = new URLSearchParams(location.search);
    setPeriodParams(query, period);
    history.replaceState(history.state, '', `${location.pathname}?${query}${location.hash}`);
    groupBy = defaultGroupBy(period);
    timeseries = null;
    breakdown = null;
    visitPage = 1;
    syncPeriodControls();
    void loadTime();
    if (tabs && tabs.current() !== 'time') loadTab(tabs.current());
  }

  // Custom: a popover with two dates, checked as the API would before asking it.
  const rangeMenu = $('#range-menu');
  const rangeForm = $<HTMLFormElement>('[data-range-form]');
  const rangeInput = (name: 'from' | 'to') => rangeForm.elements.namedItem(name) as HTMLInputElement;
  const localToday = () => todayIn(counted?.timezone ?? totals?.timezone ?? browserZone);
  let rangeApplied = false;
  function openRangeMenu() {
    rangeApplied = false;
    const today = localToday();
    rangeInput('from').max = today;
    rangeInput('to').max = today;
    rangeInput('from').value = 'from' in period ? period.from : (counted?.from ?? '');
    rangeInput('to').value = 'to' in period ? period.to : (counted?.to ?? today);
    $('[data-range-error]').hidden = true;
    rangeMenu.showPopover();
    positionMenu(rangeMenu, $('[data-custom]'));
    rangeInput('from').focus();
  }
  periodRadios.forEach((r) => r.addEventListener('change', () => (r.value === 'custom' ? openRangeMenu() : setPeriod({ days: Number(r.value) }))));
  // "Custom" again while it's the period: change the dates.
  $('[data-custom]').addEventListener('click', (e) => {
    if (choice(period) === 'custom' && !rangeMenu.matches(':popover-open')) {
      e.preventDefault();
      openRangeMenu();
    }
  });
  rangeMenu.addEventListener('toggle', (e) => {
    if ((e as ToggleEvent).newState === 'closed' && !rangeApplied) syncPeriodControls();
  });
  $('[data-range-cancel]').addEventListener('click', () => rangeMenu.hidePopover());
  rangeForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const problem = rangeProblem(rangeInput('from').value, rangeInput('to').value, localToday());
    const error = $('[data-range-error]');
    error.hidden = !problem;
    if (problem) {
      error.textContent = problem;
      return;
    }
    rangeApplied = true;
    rangeMenu.hidePopover();
    setPeriod({ from: rangeInput('from').value, to: rangeInput('to').value });
  });

  document.querySelectorAll<HTMLInputElement>('input[name="group"]').forEach((r) =>
    r.addEventListener('change', () => {
      groupBy = r.value as GroupBy;
      timeseries = null;
      void loadTime();
    }),
  );
  document.querySelectorAll<HTMLInputElement>('input[name="series"]').forEach((r) =>
    r.addEventListener('change', () => {
      series = r.value as Series;
      seriesChosen = true;
      timeseries?.then(renderTime).catch(() => {});
    }),
  );
  document.querySelectorAll<HTMLInputElement>('input[name="visit-type"]').forEach((r) =>
    r.addEventListener('change', () => {
      visitType = r.value as VisitType;
      visitPage = 1;
      void loadVisits();
    }),
  );
  $('[data-page="newer"]').addEventListener('click', () => {
    visitPage -= 1;
    void loadVisits();
  });
  $('[data-page="older"]').addEventListener('click', () => {
    visitPage += 1;
    void loadVisits();
  });
  $('[data-export]').addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const name = counted ? `${link.short_code}-visits-${counted.from}-${counted.to}.csv` : `${link.short_code}-visits.csv`;
    setLoading(btn, true, '');
    try {
      await downloadVisits(link, period, name);
    } catch (err) {
      toast('Couldn’t export the visits', 'error', { description: errorMessage(err) });
    } finally {
      setLoading(btn, false);
    }
  });
  for (const key of ['series', 'hours', 'weekdays', 'os', 'browsers', 'devices', 'referrers', 'countries']) {
    bindChartTableToggle($<HTMLButtonElement>(`[data-table-toggle="${key}"]`), chartEl(key), tableEl(key));
  }
  for (const key of ['os', 'browsers', 'devices']) bindShowNumbers($<HTMLInputElement>(`[data-numbers="${key}"]`), chartEl(key));

  // ------------------------------------------------------------------ Social preview
  function renderPreview(meta?: Partial<PreviewMetadata>) {
    const title = link.og_title || link.title || hostname(link.original_url);
    const hasCustom = Boolean(link.og_title || link.og_description || link.og_image_url);
    const fetchedAt = meta?.fetched_at ?? link.og_fetched_at;
    setHTML(
      $('[data-og-meta]'),
      fetchedAt ? html`Fetched <time data-relative datetime="${fetchedAt}"></time>` : hasCustom ? 'Custom preview' : 'No preview yet',
    );
    hydrateTimes($('[data-og-meta]'));
    setHTML(
      $('[data-og-card]'),
      html`${link.og_image_url
          ? html`<div class="aspect-[1200/630] bg-ink-100"><img src="${safeUrl(link.og_image_url)}" alt="" referrerpolicy="no-referrer" class="size-full object-cover" data-fallback /></div>`
          : html`<div class="grid aspect-[1200/630] place-items-center bg-ink-50 text-sm text-ink-500"><span class="flex items-center gap-2">${icon('image', 'size-4')}No preview image</span></div>`}
        <div class="grid gap-1 px-5 py-4">
          <p class="truncate text-xs text-ink-500 uppercase">${hostname(link.original_url)}</p>
          <p class="line-clamp-2 font-semibold text-ink-950">${title}</p>
          ${link.og_description ? html`<p class="line-clamp-3 text-sm text-ink-500">${link.og_description}</p>` : ''}
        </div>`,
    );
  }

  async function refreshPreview(btn?: HTMLButtonElement | null) {
    if (btn) setLoading(btn, true, '');
    try {
      const meta = await apiPost<PreviewMetadata>(linkApi(link, '/refresh-preview'));
      link = { ...link, og_title: meta.og_title, og_description: meta.og_description, og_image_url: meta.og_image_url, og_fetched_at: meta.fetched_at };
      link = await getLink(link);
      renderPreview(meta);
      renderHeader();
      toast('Preview refreshed', 'success', { description: meta.has_custom_preview ? 'Fields you set yourself were kept.' : undefined });
    } catch (err) {
      toast('Couldn’t refresh the preview', 'error', { description: errorMessage(err) });
    } finally {
      if (btn) setLoading(btn, false);
    }
  }

  // ------------------------------------------------------------------ Rules
  function renderRules() {
    setHTML($('[data-rules]'), html`${rules.map((r, i) => renderRule(r, i))}`);
    if (!changeable()) $('[data-rules]').querySelectorAll<HTMLElement>('[data-delete-rule]').forEach((btn) => lockControl(btn, 'link'));
    $('[data-rules-empty]').classList.toggle('hidden', rules.length > 0);
  }

  const ruleForm = $<HTMLFormElement>('[data-rule-form]');
  const ruleType = ruleForm.elements.namedItem('type') as HTMLSelectElement;
  function syncRuleType() {
    const t = ruleType.value;
    ruleForm.querySelectorAll<HTMLElement>('[data-rule-value]').forEach((el) => {
      const key = el.dataset.ruleValue;
      el.hidden = !(key === t || (key === 'date' && (t === 'after_date' || t === 'before_date')));
    });
    $('#rule-value-label').textContent = t === 'query_param' ? 'Named' : t.endsWith('_date') ? 'Date' : 'Is';
  }
  ruleType.addEventListener('change', syncRuleType);
  $('[data-add-rule]').addEventListener('click', () => {
    ruleForm.hidden = false;
    ruleForm.reset();
    syncRuleType();
    ruleType.focus();
  });
  $('[data-cancel-rule]').addEventListener('click', () => (ruleForm.hidden = true));
  ruleForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors(ruleForm);
    const f = (n: string) => (ruleForm.elements.namedItem(n) as HTMLInputElement).value.trim();
    const type = ruleType.value as RuleConditionType;
    const target = normalizeUrlInput(f('target_url'));
    let condition: RuleCondition;
    let ok = true;
    if (type === 'query_param') {
      if (!/^[\w.-]+$/.test(f('param'))) {
        setFieldError(ruleForm, 'param', 'Enter the parameter name, e.g. ref');
        ok = false;
      }
      condition = { type, value: f('param_value') || (null as unknown as string), param: f('param') };
      if (!f('param_value')) delete (condition as Partial<RuleCondition>).value;
    } else if (type === 'after_date' || type === 'before_date') {
      const iso = fromLocalInput(f('date'));
      if (!iso) {
        setFieldError(ruleForm, 'date', 'Pick a date and time.');
        ok = false;
      }
      condition = { type, value: iso ?? '' };
    } else {
      condition = { type, value: f(type) };
    }
    if (!isValidHttpUrl(target)) {
      setFieldError(ruleForm, 'target_url', 'Enter a full link starting with https://');
      ok = false;
    }
    if (!ok) return;
    const btn = ruleForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    setLoading(btn, true, 'Saving…');
    try {
      const priority = rules.length ? Math.max(...rules.map((r) => r.priority)) + 1 : 0;
      rules = [...rules, await createRule(link, { priority, conditions: [condition], target_url: target })];
      renderRules();
      ruleForm.hidden = true;
      toast('Rule added', 'success');
    } catch (err) {
      toast('Couldn’t save the rule', 'error', { description: errorMessage(err) });
    } finally {
      setLoading(btn, false);
    }
  });
  $('[data-rules]').addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-delete-rule]');
    if (!btn) return;
    const id = btn.dataset.deleteRule!;
    const ok = await confirmDialog({ title: 'Delete this rule?', body: 'Visitors it matched will go to the regular destination.', confirmLabel: 'Delete rule', danger: true, onConfirm: () => deleteRule(link, id) });
    if (ok) {
      rules = rules.filter((r) => r.id !== id);
      renderRules();
      toast('Rule deleted', 'success');
    }
  });

  // ------------------------------------------------------------------ Actions
  $('[data-copy-short]').addEventListener('click', (e) => link.short_url && copyWithFeedback(link.short_url, e.currentTarget as HTMLElement));
  $('[data-copy-pixel]').addEventListener('click', (e) => copyWithFeedback($('[data-pixel]').textContent ?? '', e.currentTarget as HTMLElement));
  $('[data-qr]').addEventListener('click', () => openQr(link));
  const onSaved = (updated: ShortLink) => {
    link = updated;
    renderHeader();
    renderPreview();
  };
  $('[data-edit]').addEventListener('click', () => openLinkEditor(link, onSaved));
  $('[data-edit-og]').addEventListener('click', () => openLinkEditor(link, onSaved, 'og'));
  $('[data-refresh-og]').addEventListener('click', (e) => refreshPreview(e.currentTarget as HTMLButtonElement));
  $('[data-refresh-og-menu]').addEventListener('click', () => {
    $('#link-menu').hidePopover();
    void refreshPreview(null);
  });
  $('[data-delete]').addEventListener('click', async () => {
    $('#link-menu').hidePopover();
    const ok = await confirmDialog({
      title: 'Delete this link?',
      body: `${prettyUrl(link.short_url)} will stop working for everyone who has it${link.click_count ? `, and its ${pluralize(link.click_count, 'click')} of history will be deleted` : ''}. This can’t be undone.`,
      confirmLabel: 'Delete link',
      danger: true,
      onConfirm: () => deleteLink(link),
    });
    if (ok) {
      sessionStorage.setItem('shurly_flash', 'Link deleted');
      location.href = '/dashboard/';
    }
  });

  // ------------------------------------------------------------------ Load
  async function load() {
    if (!code) {
      $('#loading').hidden = true;
      $('#not-found').hidden = false;
      return;
    }
    try {
      [link, viewer] = await Promise.all([getLink({ short_code: code, domain }), getViewer()]);
    } catch (err) {
      $('#loading').hidden = true;
      $('#not-found').hidden = false;
      if (!(err instanceof ApiError && err.status === 404)) {
        $('#not-found [data-empty-title]').textContent = 'We couldn’t load this link';
        $('#not-found [data-empty-body]').textContent = errorMessage(err);
      }
      return;
    }
    // Name the link's domain in the address, so a reload or a shared URL finds this link.
    if (link.domain && !domain) {
      const query = new URLSearchParams(location.search);
      query.set('domain', link.domain);
      history.replaceState(null, '', `${location.pathname}?${query}${location.hash}`);
    }
    renderHeader();
    renderPreview();
    $('#loading').hidden = true;
    $('#content').hidden = false;

    syncPeriodControls();
    tabs = initTabs($('[data-tablist]'), { hash: true, onSelect: loadTab });
    if (tabs.current() !== 'time') void loadTime();

    const [t, r] = await Promise.allSettled([getTotals(link), listRules(link)]);
    totals = t.status === 'fulfilled' ? t.value : null;
    renderTotals();
    rules = r.status === 'fulfilled' ? r.value : [];
    renderRules();
  }
  load();
</script>
