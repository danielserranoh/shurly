---
import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import Icon from '@/components/ui/Icon.astro';
---

<AppLayout title="Campaigns" section="campaigns">
  <PageHeader title="Campaigns" description="One personal link per recipient, straight from a spreadsheet. See exactly who opened it.">
    <Fragment slot="actions">
      <a href="/dashboard/campaigns/create/" class="btn btn-primary"><Icon name="plus" />New campaign</a>
    </Fragment>
  </PageHeader>

  <ul id="campaign-list" class="grid grid-cols-1 gap-4 md:grid-cols-2" aria-live="polite" aria-busy="true">
    {
      [1, 2].map(() => (
        <li class="card grid gap-4 p-5" aria-hidden="true">
          <div class="flex gap-3">
            <span class="skeleton size-10 rounded-xl" />
            <div class="flex-1 space-y-2">
              <span class="skeleton block h-4 w-1/2" />
              <span class="skeleton block h-3 w-1/3" />
            </div>
          </div>
          <span class="skeleton block h-16 rounded-xl" />
          <span class="skeleton block h-4 w-2/3" />
        </li>
      ))
    }
  </ul>

  <EmptyState id="empty" hidden illustration="campaigns" title="Send one link per person" body="Upload a CSV of recipients — names, companies, anything — and get a personal, trackable link for each one. You’ll see who opened it, not just how many.">
    <a href="/dashboard/campaigns/create/" class="btn btn-primary"><Icon name="plus" />Create your first campaign</a>
    <button type="button" class="btn btn-secondary" data-sample><Icon name="download" />Sample CSV</button>
  </EmptyState>

  <EmptyState id="load-error" hidden illustration="error" title="We couldn’t load your campaigns" body="Check your connection and try again.">
    <button type="button" class="btn btn-primary" data-retry><Icon name="refresh" />Try again</button>
  </EmptyState>
</AppLayout>

<script>
  import { errorMessage, saveBlob } from '@/utils/api';
  import { campaignSummary, deleteCampaign, exportCampaignLinks, listCampaigns, renderCampaignCard } from '@/utils/campaigns';
  import { meter } from '@/utils/charts';
  import { SAMPLE_CSV } from '@/utils/csv';
  import { formatNumber, pluralize } from '@/utils/format';
  import { html, setHTML } from '@/utils/html';
  import { confirmDialog, toast } from '@/utils/ui';
  import type { Campaign, CampaignSummary } from '@/utils/types';

  const list = document.getElementById('campaign-list')!;
  const empty = document.getElementById('empty')!;
  const errorState = document.getElementById('load-error')!;
  let campaigns: Campaign[] = [];
  const summaries = new Map<string, CampaignSummary | null>();

  async function load() {
    errorState.hidden = true;
    list.setAttribute('aria-busy', 'true');
    try {
      campaigns = (await listCampaigns()).campaigns;
    } catch (err) {
      list.innerHTML = '';
      errorState.hidden = false;
      errorState.querySelector('[data-empty-body]')!.textContent = errorMessage(err);
      return;
    } finally {
      list.setAttribute('aria-busy', 'false');
    }
    render();
  }

  function applyStats(c: Campaign) {
    const card = list.querySelector<HTMLElement>(`[data-campaign="${c.id}"]`);
    const s = summaries.get(c.id);
    if (!card || s === undefined) return;
    if (s === null) {
      card.querySelector('[data-clicks]')!.textContent = '—';
      card.querySelector('[data-ctr]')!.textContent = '—';
      return;
    }
    const opened = Math.round((s.click_through_rate / 100) * s.total_urls);
    card.querySelector('[data-clicks]')!.textContent = formatNumber(s.total_clicks);
    card.querySelector('[data-ctr]')!.textContent = `${Math.round(s.click_through_rate)}%`;
    setHTML(
      card.querySelector('[data-meter]'),
      html`${meter(opened, s.total_urls, `${opened} of ${s.total_urls} recipients opened their link`)}<p class="mt-1.5 text-xs text-ink-500">${pluralize(opened, 'recipient')} of ${formatNumber(s.total_urls)} opened their link</p>`,
    );
  }

  function render() {
    empty.hidden = campaigns.length > 0;
    setHTML(list, html`${campaigns.map(renderCampaignCard)}`);
    // Stats per card are fetched lazily (and cached) so the list shows up immediately.
    campaigns.forEach((c) => {
      if (summaries.has(c.id)) return applyStats(c);
      campaignSummary(c.id)
        .then((s) => summaries.set(c.id, s))
        .catch(() => summaries.set(c.id, null))
        .finally(() => applyStats(c));
    });
  }

  list.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-action]');
    if (!btn) return;
    btn.closest<HTMLElement>('[popover]')?.hidePopover();
    const c = campaigns.find((x) => x.id === btn.dataset.id);
    if (!c) return;
    if (btn.dataset.action === 'export') {
      exportCampaignLinks(c).catch((err) => toast('Couldn’t export the links', 'error', { description: errorMessage(err) }));
    } else if (btn.dataset.action === 'delete') {
      const ok = await confirmDialog({
        title: `Delete “${c.name}”?`,
        body: `All ${pluralize(c.url_count, 'personal link')} will stop working and their click history will be deleted. This can’t be undone.`,
        confirmLabel: 'Delete campaign',
        danger: true,
        onConfirm: () => deleteCampaign(c.id),
      });
      if (ok) {
        campaigns = campaigns.filter((x) => x.id !== c.id);
        render();
        toast('Campaign deleted', 'success');
      }
    }
  });

  document.querySelector('[data-retry]')!.addEventListener('click', load);
  document.querySelector('[data-sample]')!.addEventListener('click', () =>
    saveBlob(new Blob([SAMPLE_CSV], { type: 'text/csv' }), 'shurly-sample-recipients.csv'),
  );

  load();
</script>
