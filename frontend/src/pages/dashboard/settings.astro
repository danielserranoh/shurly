---
import AppLayout from '@/layouts/AppLayout.astro';
import { SETTINGS_TAB_FROM_HASH } from '@/inline-scripts.mjs';
import PageHeader from '@/components/ui/PageHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import AccountPanel from '@/components/settings/AccountPanel.astro';
import OrganizationPanel from '@/components/settings/OrganizationPanel.astro';
import ApiPanel from '@/components/settings/ApiPanel.astro';
import TagsPanel from '@/components/settings/TagsPanel.astro';
import NotificationsPanel from '@/components/settings/NotificationsPanel.astro';
import PlanPanel from '@/components/settings/PlanPanel.astro';
import type { IconName } from '@/utils/icons';
import type { HTMLAttributes } from 'astro/types';

// The key doubles as the URL hash: /dashboard/settings/#tags opens the Tags tab.
const tabs: { key: string; label: string; icon: IconName }[] = [
  { key: 'account', label: 'Account', icon: 'user' },
  { key: 'organization', label: 'Organization', icon: 'users' },
  { key: 'api', label: 'API & MCP', icon: 'key' },
  { key: 'tags', label: 'Tags', icon: 'tags' },
  { key: 'notifications', label: 'Notifications', icon: 'bell' },
  { key: 'plan', label: 'Plan', icon: 'sparkle' },
];
const panelProps = (key: string, index: number): HTMLAttributes<'div'> => ({
  id: `panel-${key}`,
  role: 'tabpanel',
  'aria-labelledby': `tab-${key}`,
  tabindex: 0,
  hidden: index !== 0,
  class: 'rounded-xl focus-visible:outline-offset-8',
});
---

<AppLayout title="Settings" section="settings">
  <PageHeader title="Settings" description="Your account, your organization, API access and tags." />

  <div data-settings>
    <div class="-mx-4 sm:mx-0">
      <div
        role="tablist"
        aria-label="Settings"
        class="scrollbar-none relative flex gap-6 overflow-x-auto pr-10 pl-4 shadow-[inset_0_-1px_0_var(--color-line)] [mask-image:linear-gradient(to_right,transparent,#000_var(--fade-start,0px),#000_calc(100%-var(--fade-end,2.5rem)),transparent)] sm:overflow-visible sm:px-0 sm:[mask-image:none]"
        data-tablist
      >
        {
          tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${tab.key}`}
              class="tab mb-0 shrink-0 max-sm:focus-visible:outline-offset-[-2px]"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${tab.key}`}
              tabindex={i === 0 ? 0 : -1}
              data-tab={tab.key}
            >
              <Icon name={tab.icon} />
              {tab.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="mt-8">
      <div {...panelProps('account', 0)}><AccountPanel /></div>
      <div {...panelProps('organization', 1)}><OrganizationPanel /></div>
      <div {...panelProps('api', 2)}><ApiPanel /></div>
      <div {...panelProps('tags', 3)}><TagsPanel /></div>
      <div {...panelProps('notifications', 4)}><NotificationsPanel /></div>
      <div {...panelProps('plan', 5)}><PlanPanel /></div>
    </div>
  </div>

  <!-- Open the tab named in the URL hash before first paint, so #tags never flashes the Account tab. -->
  <script is:inline set:html={SETTINGS_TAB_FROM_HASH}></script>

  <EmptyState id="settings-error" hidden illustration="error" title="We couldn’t load your settings" body="Check your connection and try again.">
    <button type="button" class="btn btn-primary" data-settings-retry><Icon name="refresh" />Try again</button>
  </EmptyState>
</AppLayout>

<script>
  import { ApiError, errorMessage } from '@/utils/api';
  import { setLoading } from '@/utils/ui';
  import { initTabs } from '@/utils/tabs';
  import { currentUser } from '@/components/settings/store';
  import { getMe } from '@/utils/viewer';

  const root = document.querySelector<HTMLElement>('[data-settings]')!;
  const tablist = root.querySelector<HTMLElement>('[data-tablist]')!;

  // ---------------------------------------------------------------- Tabs
  // A click or the arrows pick a tab, Home and End jump to the ends, and the hash names it: the account
  // menu links to #tags and #api, and back/forward follow (src/utils/tabs.ts).
  initTabs(tablist, { hash: true });

  // Arriving from the menu while scrolled down: bring the tabs back out from under the sticky header.
  window.addEventListener('hashchange', () => {
    if (tablist.getBoundingClientRect().top < 80) window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href*="#"]');
    if (a && a.pathname === location.pathname) a.closest<HTMLElement>('[popover]')?.hidePopover();
  });

  // ---------------------------------------------------------------- Account
  const errorState = document.getElementById('settings-error')!;
  const retry = errorState.querySelector<HTMLButtonElement>('[data-settings-retry]')!;

  async function loadAccount() {
    try {
      const user = await getMe();
      errorState.hidden = true;
      root.hidden = false;
      currentUser.set(user);
    } catch (err) {
      if (err instanceof ApiError && err.status === 401) return; // on its way to the login page
      root.hidden = true;
      errorState.hidden = false;
      errorState.querySelector('[data-empty-body]')!.textContent = errorMessage(err);
    }
  }

  retry.addEventListener('click', async () => {
    setLoading(retry, true, 'Trying again…');
    await loadAccount();
    setLoading(retry, false);
  });

  void loadAccount();
</script>
