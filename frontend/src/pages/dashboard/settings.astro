---
import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import AccountPanel from '@/components/settings/AccountPanel.astro';
import ApiPanel from '@/components/settings/ApiPanel.astro';
import TagsPanel from '@/components/settings/TagsPanel.astro';
import NotificationsPanel from '@/components/settings/NotificationsPanel.astro';
import PlanPanel from '@/components/settings/PlanPanel.astro';
import type { IconName } from '@/utils/icons';
import type { HTMLAttributes } from 'astro/types';

// The key doubles as the URL hash: /dashboard/settings/#tags opens the Tags tab.
const tabs: { key: string; label: string; icon: IconName }[] = [
  { key: 'account', label: 'Account', icon: 'user' },
  { key: 'api', label: 'API & MCP', icon: 'key' },
  { key: 'tags', label: 'Tags', icon: 'tags' },
  { key: 'notifications', label: 'Notifications', icon: 'bell' },
  { key: 'plan', label: 'Plan', icon: 'sparkle' },
];
const panelProps = (key: string, index: number): HTMLAttributes<'div'> => ({
  id: `panel-${key}`,
  role: 'tabpanel',
  'aria-labelledby': `tab-${key}`,
  tabindex: 0,
  hidden: index !== 0,
  class: 'rounded-xl focus-visible:outline-offset-8',
});
---

<AppLayout title="Settings" section="settings">
  <PageHeader title="Settings" description="Your account, API access and team tags." />

  <div data-settings>
    <div class="-mx-4 sm:mx-0">
      <div
        role="tablist"
        aria-label="Settings"
        class="scrollbar-none relative flex gap-6 overflow-x-auto pr-10 pl-4 shadow-[inset_0_-1px_0_var(--color-line)] [mask-image:linear-gradient(to_right,transparent,#000_var(--fade-start,0px),#000_calc(100%-var(--fade-end,2.5rem)),transparent)] sm:overflow-visible sm:px-0 sm:[mask-image:none]"
        data-tablist
      >
        {
          tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${tab.key}`}
              class="tab mb-0 shrink-0 max-sm:focus-visible:outline-offset-[-2px]"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${tab.key}`}
              tabindex={i === 0 ? 0 : -1}
              data-tab={tab.key}
            >
              <Icon name={tab.icon} />
              {tab.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="mt-8">
      <div {...panelProps('account', 0)}><AccountPanel /></div>
      <div {...panelProps('api', 1)}><ApiPanel /></div>
      <div {...panelProps('tags', 2)}><TagsPanel /></div>
      <div {...panelProps('notifications', 3)}><NotificationsPanel /></div>
      <div {...panelProps('plan', 4)}><PlanPanel /></div>
    </div>
  </div>

  <!-- Open the tab named in the URL hash before first paint, so #tags never flashes the Account tab. -->
  <script is:inline>
    (function () {
      var tab = document.getElementById('tab-' + location.hash.slice(1).toLowerCase());
      if (!tab || tab.getAttribute('role') !== 'tab') return;
      document.querySelectorAll('[data-tablist] [role="tab"]').forEach(function (t) {
        var on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
      });
    })();
  </script>

  <EmptyState id="settings-error" hidden illustration="error" title="We couldn’t load your settings" body="Check your connection and try again.">
    <button type="button" class="btn btn-primary" data-settings-retry><Icon name="refresh" />Try again</button>
  </EmptyState>
</AppLayout>

<script>
  import { ApiError, apiGet, errorMessage } from '@/utils/api';
  import { setLoading } from '@/utils/ui';
  import { currentUser } from '@/components/settings/store';
  import type { User } from '@/utils/types';

  const root = document.querySelector<HTMLElement>('[data-settings]')!;
  const tablist = root.querySelector<HTMLElement>('[data-tablist]')!;
  const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const keys = tabs.map((t) => t.dataset.tab!);
  const DEFAULT_TAB = keys[0];

  // ---------------------------------------------------------------- Tabs
  const keyFromHash = () => {
    const key = location.hash.slice(1).toLowerCase();
    return keys.includes(key) ? key : DEFAULT_TAB;
  };

  /** Keep the active tab visible when the tab row scrolls sideways (small screens). */
  function revealTab(tab: HTMLElement, smooth: boolean) {
    const left = tab.offsetLeft - (tablist.clientWidth - tab.offsetWidth) / 2;
    tablist.scrollTo({ left: Math.max(0, left), behavior: smooth ? 'smooth' : 'auto' });
  }

  /** Fade whichever edge of the tab row has more tabs hiding behind it. */
  function updateFades() {
    const max = tablist.scrollWidth - tablist.clientWidth;
    tablist.style.setProperty('--fade-start', tablist.scrollLeft > 2 ? '2rem' : '0px');
    tablist.style.setProperty('--fade-end', tablist.scrollLeft < max - 2 ? '2.5rem' : '0px');
  }
  tablist.addEventListener('scroll', updateFades, { passive: true });
  window.addEventListener('resize', updateFades);

  function select(key: string, { focus = false, syncHash = true, animate = true } = {}) {
    for (const tab of tabs) {
      const on = tab.dataset.tab === key;
      const panel = document.getElementById(tab.getAttribute('aria-controls')!)!;
      tab.setAttribute('aria-selected', String(on));
      tab.tabIndex = on ? 0 : -1;
      if (on && panel.hidden) {
        panel.hidden = false;
        if (animate) {
          panel.classList.remove('animate-fade-in');
          void panel.offsetWidth; // restart the animation
          panel.classList.add('animate-fade-in');
        }
      } else if (!on) {
        panel.hidden = true;
      }
    }
    const active = tabs.find((t) => t.dataset.tab === key)!;
    if (focus) active.focus();
    revealTab(active, animate);
    if (syncHash) {
      const hash = key === DEFAULT_TAB ? '' : `#${key}`;
      if (location.hash !== hash) history.replaceState(history.state, '', `${location.pathname}${location.search}${hash}`);
    }
  }

  tablist.addEventListener('click', (e) => {
    const tab = (e.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
    if (tab) select(tab.dataset.tab!);
  });

  // Roving tabindex: arrows move between tabs (and open them), Home/End jump to the ends.
  tablist.addEventListener('keydown', (e) => {
    const index = tabs.indexOf(document.activeElement as HTMLButtonElement);
    if (index < 0) return;
    const target = { ArrowRight: index + 1, ArrowLeft: index - 1, Home: 0, End: tabs.length - 1 }[e.key];
    if (target === undefined) return;
    e.preventDefault();
    select(keys[(target + tabs.length) % tabs.length], { focus: true });
  });

  // The account menu links to #tags and #api; follow those (and back/forward) without a reload.
  window.addEventListener('hashchange', () => {
    select(keyFromHash(), { syncHash: false });
    // Arriving from the menu while scrolled down: bring the tabs back out from under the sticky header.
    if (tablist.getBoundingClientRect().top < 80) window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href*="#"]');
    if (a && a.pathname === location.pathname) a.closest<HTMLElement>('[popover]')?.hidePopover();
  });

  select(keyFromHash(), { syncHash: false, animate: false });
  updateFades();

  // ---------------------------------------------------------------- Account
  const errorState = document.getElementById('settings-error')!;
  const retry = errorState.querySelector<HTMLButtonElement>('[data-settings-retry]')!;

  async function loadAccount() {
    try {
      const user = await apiGet<User>('/api/v1/auth/me');
      errorState.hidden = true;
      root.hidden = false;
      currentUser.set(user);
    } catch (err) {
      if (err instanceof ApiError && err.status === 401) return; // on its way to the login page
      root.hidden = true;
      errorState.hidden = false;
      errorState.querySelector('[data-empty-body]')!.textContent = errorMessage(err);
    }
  }

  retry.addEventListener('click', async () => {
    setLoading(retry, true, 'Trying again…');
    await loadAccount();
    setLoading(retry, false);
  });

  void loadAccount();
</script>
